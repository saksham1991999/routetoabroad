---
import '../styles/tokens.css';
import '../styles/global.css';
// RTL rules are NOT imported as a bundled stylesheet: with
// build.inlineStylesheets 'always' every byte here would be inlined into all
// 280 pages while only /ar/ pages use them. The CSS text is imported raw and
// injected as an inline <style> on Arabic pages only (see <head> below).
import rtlCss from '../styles/rtl.css?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import SiteSchemas from '../components/SiteSchemas.astro';
import Analytics from '../components/Analytics.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../lib/site';
import { localeFromPath, LOCALE_META, stripLocalePrefix, translatePath, type Locale } from '../lib/i18n';
import { uiFor } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  /** Forwarded to Seo: 'article' for blog/guide pages. */
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: { name: string; url: string }[];
  jsonLd?: object[];
  /** Forwarded to Seo for og:type=article metadata. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** article pages show a reading-progress bar */
  progress?: boolean;
  /** Locale of this page. Defaults to detection from Astro.url.pathname. */
  locale?: Locale;
  /** Hide the language switcher (e.g. the 404 page, whose locale variants
   * intentionally do not exist to link to). */
  hideSwitcher?: boolean;
}

const {
  title,
  description,
  path,
  image,
  type,
  noindex,
  crumbs,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  progress = false,
  locale,
  hideSwitcher = false,
} = Astro.props;

/** Resolve the page locale — explicit prop wins, fall back to URL detection. */
const pageLocale: Locale = locale ?? localeFromPath(Astro.url.pathname);
const isRtl = LOCALE_META[pageLocale].dir === 'rtl';
/** Chrome strings for this page's locale (en pages keep their inline copy). */
const ui = uiFor(pageLocale);

/** Homepage gets the loader, HUD and tone-switching chrome. Locale homepages
 * (/, /zh, /fr, /ar, /es, /de, /ja, /pt, /hi) count as home too — the
 * loader/HUD live here. */
const isHome = ['', '/'].includes(stripLocalePrefix(Astro.url.pathname) || '/');
---

<!doctype html>
<html
  lang={pageLocale}
  dir={isRtl ? 'rtl' : 'ltr'}
  class="no-js"
  data-form-success={ui.form.success}
  data-form-fail={ui.form.fail}
  data-form-network={ui.form.network}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RouteToAbroad Insights" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F4F2EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1533" media="(prefers-color-scheme: dark)" />

    <Seo {title} {description} {path} {image} {type} {noindex} {crumbs} {publishedTime} {modifiedTime} {jsonLd} locale={pageLocale}>
      {Astro.slots.has('head-extra') && <slot name="head-extra" />}
    </Seo>

    <SiteSchemas />
    <Analytics />

    {/* RTL overrides ship only to Arabic pages — see the import note above. */}
    {isRtl && <style is:inline set:html={rtlCss} />}

    <script is:inline>
      // Pre-paint theme to avoid flash-of-wrong-theme. Resolves stored
      // choice → system preference, then syncs the browser UI color to the
      // RESOLVED theme (the media-query metas below only reflect the system,
      // which disagrees when the user has explicitly picked the other side).
      (function () {
        try {
          var stored = localStorage.getItem('rta-theme');
          var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach(function (m) { m.remove(); });
          var meta = document.createElement('meta');
          meta.name = 'theme-color';
          meta.content = theme === 'dark' ? '#0B1533' : '#F4F2EC';
          document.head.appendChild(meta);
        } catch (e) {}
      })();
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline>
      // Pre-paint loader decision, made purely from state — the loader element
      // lives in <body> and is unreachable from <head>, so there is no element
      // lookup here. html[data-loader] holds the homepage hero until the
      // loader dispatches 'rta:loaded' (see index.astro handoff). Repeat
      // visits (sessionStorage) and reduced-motion never see the loader.
      (function () {
        // Reduced motion first — it must hold even if storage access throws.
        var willPlay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (sessionStorage.getItem('rta-loader') === '1') willPlay = false;
        } catch (e) {}
        if (willPlay) document.documentElement.setAttribute('data-loader', '');
      })();
    </script>

    {progress && (
      <div class="scroll-progress" aria-hidden="true"><span></span></div>
    )}
  </head>
  <body data-chrome={isHome ? 'home' : 'inner'} data-tone="light">
    <a class="skip-link" href="#main">{ui.skipLink}</a>
    <Header locale={pageLocale} hideSwitcher={hideSwitcher} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={pageLocale} />
    <ChatWidget locale={pageLocale} />

    {
      isHome && (
        <div class="rta-loader" id="rta-loader" aria-hidden="true" data-loader-words={ui.hud.loaderWords.join('|')}>
          <div class="rta-loader-cover rta-loader-cover--top" />
          <div class="rta-loader-cover rta-loader-cover--bottom" />
          <div class="rta-loader-stack">
            <svg
              class="rta-loader-mark"
              data-loader-mark
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 507.677 425.523"
              focusable="false"
            >
              <defs>
                <clipPath id="rta-clip-bowl">
                  <polygon points="79.693,62.762 420,62.762 420,400 50,400 50,220 141.387,94.012" />
                </clipPath>
                <clipPath id="rta-clip-leg">
                  <polygon points="79.693,62.762 141.387,94.012 420,94.012 420,400 50,400" />
                </clipPath>
              </defs>
              <path
                data-plane-guide
                fill="none"
                stroke="none"
                d="M 78.555 361.512 C 93 287 125 245.887 243.665 245.887 A 83.75 83.75 0 1 0 243.665 78.387 L 126 78.387 Q 110.54 78.387 119.65 90.8 L 243.657 259.784 C 274.42 301.71 288 346.512 384.916 346.512"
              />
              <path
                data-rta-leg
                clip-path="url(#rta-clip-leg)"
                fill="none"
                stroke="currentColor"
                stroke-width="31.25"
                stroke-linecap="butt"
                d="M 91.608 52.588 L 243.657 259.784 C 274.42 301.71 288 346.512 384.916 346.512"
              />
              <path
                data-rta-halo
                fill="none"
                stroke="var(--paper)"
                stroke-width="39.5"
                stroke-linecap="butt"
                d="M 78.555 361.512 C 93 287 125 245.887 243.665 245.887"
              />
              <path
                data-rta-bowl
                clip-path="url(#rta-clip-bowl)"
                fill="none"
                stroke="currentColor"
                stroke-width="31.25"
                stroke-linecap="butt"
                d="M 78.555 361.512 C 93 287 125 245.887 243.665 245.887 A 83.75 83.75 0 1 0 243.665 78.387 L 79.693 78.387"
              />
              <g data-rta-plane>
                <g transform="rotate(25.02) translate(-393.04, -335.887)">
                  <polygon fill="currentColor" points="375.54,312.137 390.54,331.512 444.915,310.262" />
                  <polygon fill="currentColor" points="411.165,362.762 444.29,313.387 395.54,340.262" />
                </g>
              </g>
            </svg>
            <p class="rta-loader-line">
              <span class="rta-loader-word" data-loader-word>
                {ui.hud.loaderWords[0]}
              </span>
            </p>
          </div>
        </div>
      )
    }
    {
      isHome && (
        <div class="rta-hud">
          <span class="rta-hud-item" aria-hidden="true">
            {ui.hud.tagline}
          </span>
          <div class="rta-hud-right">
            <a
              class="rta-hud-link"
              href={`${SITE.whatsapp}?text=${encodeURIComponent(ui.chat.whatsappPrefill)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp <bdi>{SITE.phoneIndia}</bdi>
            </a>
            <span class="rta-hud-item" aria-hidden="true">{ui.hud.scroll}</span>
            <span class="rta-hud-percent" role="status">
              <span data-scroll-percent>0%</span>
            </span>
          </div>
        </div>
      )
    }

    <a class="rta-tab" id="rta-tab" href={translatePath('/tools/fit-check', pageLocale)}>{ui.headerCta}</a>

    <script>
      // Single source of truth for the Formspree endpoint (src/lib/site.ts).
      import { FORMSPREE_ENDPOINT as FORMSPREE } from '../lib/site';

      // ---- Theme toggle (syncs the browser UI color too) ----
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((m) => m.remove());
        const meta = document.createElement('meta');
        meta.name = 'theme-color';
        meta.content = next === 'dark' ? '#0B1533' : '#F4F2EC';
        document.head.appendChild(meta);
        try {
          localStorage.setItem('rta-theme', next);
        } catch {}
      });

      // ---- Homepage loader: masked word timeline, then covers split ----
      // Suppression lives here (the old body guard script is gone): repeat
      // visits and reduced-motion get the loader removed without a replay,
      // and the hero never holds because html[data-loader] was not set.
      const loader = document.getElementById('rta-loader');
      if (loader) {
        let skip = false;
        try {
          skip = sessionStorage.getItem('rta-loader') === '1';
        } catch {
          /* storage unavailable — let the loader play */
        }
        if (skip || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          loader.remove();
          window.dispatchEvent(new CustomEvent('rta:loaded'));
        } else {
          const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
          const easeInOut = (t: number) =>
            t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
          const easeInQuad = (t: number) => t * t;
          const sliceStroke = (el: SVGPathElement, total: number, start: number, end: number) => {
            const len = end - start;
            if (len <= 0.5) {
              el.style.strokeDasharray = `0 ${total.toFixed(2)}`;
              el.style.strokeDashoffset = '0';
              return;
            }
            el.style.strokeDasharray = `${len.toFixed(2)} ${total.toFixed(2)}`;
            el.style.strokeDashoffset = `${(-start).toFixed(2)}`;
          };

          const startLogoMotion = (totalMs: number) => {
            const mark = loader.querySelector<SVGSVGElement>('[data-loader-mark]');
            const bowl = loader.querySelector<SVGPathElement>('[data-rta-bowl]');
            const halo = loader.querySelector<SVGPathElement>('[data-rta-halo]');
            const leg = loader.querySelector<SVGPathElement>('[data-rta-leg]');
            const guide = loader.querySelector<SVGPathElement>('[data-plane-guide]');
            const plane = loader.querySelector<SVGGElement>('[data-rta-plane]');
            if (!mark || !bowl || !halo || !leg || !guide || !plane) return;

            const lBowl = bowl.getTotalLength();
            const lCorner = lBowl - 30.85;
            const lHalo = halo.getTotalLength();
            const lLeg = leg.getTotalLength();
            const lGuide = guide.getTotalLength();
            const dTotal = lCorner + (lLeg - 32);

            const restX = 393.04;
            const restY = 335.887;
            const restAngle = -25.02;
            const rad = (restAngle * Math.PI) / 180;

            const tDrawEnd = totalMs * 0.4;
            const tHoldEnd = totalMs * 0.74;
            const tOutEnd = totalMs * 0.985;
            const startedAt = performance.now();

            const renderFrame = (now: number) => {
              if (!loader.isConnected) return;
              const elapsed = now - startedAt;

              let dStart = 0;
              let dEnd = dTotal;
              let planeX = restX;
              let planeY = restY;
              let planeDeg = restAngle;
              let planeOpacity = 1;

              if (elapsed < tDrawEnd) {
                const u = Math.max(0, Math.min(1, elapsed / tDrawEnd));
                const p = easeInOut(u);
                dEnd = p * dTotal;

                const dPlane = Math.min(lGuide, p * lGuide + 14);
                const pt = guide.getPointAtLength(dPlane);
                const p0 = guide.getPointAtLength(Math.max(0, dPlane - 2.5));
                const p1 = guide.getPointAtLength(Math.min(lGuide, dPlane + 2.5));
                let deg = Math.atan2(p1.y - p0.y, p1.x - p0.x) * (180 / Math.PI);

                if (p > 0.86) {
                  const blend = easeOutCubic((p - 0.86) / 0.14);
                  planeX = pt.x + (restX - pt.x) * blend;
                  planeY = pt.y + (restY - pt.y) * blend;
                  // Normalize small tail angle near 0deg before pitching up to -25.02deg
                  planeDeg = deg + (restAngle - deg) * blend;
                } else {
                  planeX = pt.x;
                  planeY = pt.y;
                  planeDeg = deg;
                }
                planeOpacity = Math.min(1, u / 0.08);
              } else if (elapsed >= tHoldEnd) {
                const u = Math.max(0, Math.min(1, (elapsed - tHoldEnd) / (tOutEnd - tHoldEnd)));
                const eraseP = easeInOut(u);
                dStart = eraseP * dTotal;

                const flyDist = easeInQuad(u) * 340;
                planeX = restX + Math.cos(rad) * flyDist;
                planeY = restY + Math.sin(rad) * flyDist;
                planeDeg = restAngle;
                planeOpacity = u > 0.65 ? Math.max(0, 1 - (u - 0.65) / 0.35) : 1;
              }

              const bowlStart = dStart <= lCorner ? dStart : lCorner + Math.min(30.85, dStart - lCorner);
              const bowlEnd = dEnd <= lCorner ? dEnd : lCorner + Math.min(30.85, dEnd - lCorner);
              const legStart =
                dStart < lCorner - 32
                  ? 0
                  : dStart <= lCorner
                    ? ((dStart - (lCorner - 32)) / 32) * 32
                    : Math.min(lLeg, 32 + (dStart - lCorner));
              const legEnd =
                dEnd < lCorner - 10
                  ? 0
                  : dEnd <= lCorner
                    ? 1 + ((dEnd - (lCorner - 10)) / 10) * 31
                    : Math.min(lLeg, 32 + (dEnd - lCorner));

              sliceStroke(bowl, lBowl, bowlStart, bowlEnd);
              sliceStroke(halo, lHalo, Math.min(lHalo, bowlStart), Math.min(lHalo, bowlEnd));
              sliceStroke(leg, lLeg, legStart, legEnd);

              plane.setAttribute(
                'transform',
                `translate(${planeX.toFixed(2)}, ${planeY.toFixed(2)}) rotate(${planeDeg.toFixed(2)})`
              );
              plane.style.opacity = planeOpacity.toFixed(3);
              mark.classList.add('is-ready');

              if (elapsed < tOutEnd) {
                requestAnimationFrame(renderFrame);
              }
            };

            renderFrame(startedAt);
          };

          const run = async () => {
            const word = loader.querySelector<HTMLElement>('[data-loader-word]');
            // Localized loader words (fallback: English), joined with '|' in
            // the data attribute because FormData/HTML attr values are strings.
            const words =
              loader.dataset.loaderWords?.split('|').filter(Boolean) ?? ['Choose', 'Apply', 'Enroll'];
            document.body.classList.add('rta-locked');
            startLogoMotion(words.length * 620);
            if (word) {
              for (const next of words) {
                word.textContent = next;
                word.classList.add('is-in');
                await wait(260 + 160); // in 0.26s + hold 0.16s
                word.classList.remove('is-in');
                word.classList.add('is-out');
                await wait(200); // out 0.20s
                word.classList.remove('is-out');
              }
            }
            // Covers split — announce first so the hero can start as they move.
            window.dispatchEvent(new CustomEvent('rta:loaded'));
            loader.classList.add('is-split');
            try {
              sessionStorage.setItem('rta-loader', '1');
            } catch {}
            await wait(620);
            loader.remove();
            document.body.classList.remove('rta-locked');
          };
          requestAnimationFrame(() => requestAnimationFrame(() => void run()));
        }
      }

      // ---- Reveal on scroll (IntersectionObserver, stagger via --reveal-delay) ----
      // Fires just before elements enter the viewport so content never feels late.
      const revealEls = document.querySelectorAll('[data-reveal]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ---- Animated counters ----
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length) {
        const io2 = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io2.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.counter || '0');
              const decimals = ((el.dataset.counter ?? '').split('.')[1] || '').length;
              const suffix = el.dataset.suffix || '';
              const duration = 1300;
              const start = performance.now();
              const step = (now: number) => {
                const p = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = (target * eased).toFixed(decimals) + suffix;
                if (p < 1) requestAnimationFrame(step);
              };
              if (reduced) el.textContent = target.toFixed(decimals) + suffix;
              else requestAnimationFrame(step);
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => io2.observe(el));
      }

      // ---- Scroll chrome: HUD percent, floating CTA tab, tone switching ----
      const hud = document.querySelector<HTMLElement>('.rta-hud');
      const hudPercent = document.querySelector<HTMLElement>('[data-scroll-percent]');
      const ctaTab = document.getElementById('rta-tab');
      // Exclude <body>: it carries a default data-tone and always intersects
      // the probe, which previously pinned the chrome to "light" forever.
      const toneSections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-tone]')
      ).filter((el) => el !== document.body);

      const writePercent = () => {
        if (!hudPercent) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
        hudPercent.textContent = `${Math.round(p * 100)}%`;
      };

      let toneQueued = false;
      const updateTone = () => {
        toneQueued = false;
        // Sample behind the fixed header, not a quarter down the viewport:
        // a dark band starting below the header must not flip the chrome
        // white while it is still sitting over paper.
        const probe = 40;
        let next = 'light';
        for (const section of toneSections) {
          const rect = section.getBoundingClientRect();
          if (rect.top <= probe && rect.bottom >= probe) {
            next = section.dataset.tone || 'light';
            break;
          }
          // Below every tone region (e.g. inside the footer): keep the last tone.
          if (rect.top > probe) break;
        }
        if (document.body.dataset.tone !== next) document.body.dataset.tone = next;
      };

      const onScrollChrome = () => {
        writePercent();
        ctaTab?.classList.toggle('is-in', window.scrollY > 200);
        // Fade the HUD before it can collide with the footer's own small print.
        if (hud) {
          const nearBottom =
            window.scrollY + window.innerHeight >=
            document.documentElement.scrollHeight - 120;
          hud.classList.toggle('is-hidden', nearBottom);
        }
        if (toneSections.length && !toneQueued) {
          toneQueued = true;
          requestAnimationFrame(updateTone);
        }
      };

      if (hudPercent || ctaTab || toneSections.length) {
        window.addEventListener('scroll', onScrollChrome, { passive: true });
        window.addEventListener('resize', onScrollChrome, { passive: true });
        onScrollChrome();
      }

      // ---- Scroll progress fallback (browsers without scroll-driven animations) ----
      if (!CSS.supports('animation-timeline: scroll()')) {
        const bar = document.querySelector('.scroll-progress span');
        if (bar) {
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            const p = max > 0 ? Math.min(scrollY / max, 1) : 0;
            (bar as HTMLElement).style.transform = `scaleX(${p})`;
          };
          addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      }

      // ---- Forms: validation + Formspree AJAX submit (endpoint from src/lib/site.ts) ----

      document.querySelectorAll<HTMLFormElement>('form[data-formspree]').forEach((form) => {
        const status = form.querySelector<HTMLElement>('.form-status');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!validate(form)) return;

          const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (btn) {
            btn.disabled = true;
            btn.classList.add('is-loading');
            btn.setAttribute('aria-busy', 'true');
          }

          try {
            // Tag the submission with the page locale so the business knows which
            // language the lead came in (the engine is shared across all locales).
            const fd = new FormData(form);
            const pageLang = document.documentElement.lang;
            if (pageLang) fd.append('locale', pageLang);
            if (!fd.has('serviceContext') && form.dataset.formType) {
              fd.append('serviceContext', form.dataset.formType);
            }
            const res = await fetch(FORMSPREE, {
              method: 'POST',
              body: fd,
              headers: { Accept: 'application/json' },
            });

            if (status && res.ok) {
              const formType = fd.get('serviceContext')?.toString() || form.dataset.formType || 'enquiry';
              const win = window as Window & {
                gtag?: (...args: unknown[]) => void;
                posthog?: { capture?: (event: string, props?: Record<string, unknown>) => void };
              };
              try {
                win.gtag?.('event', 'form_submit', {
                  form_type: formType,
                  locale: pageLang || 'en',
                });
                win.posthog?.capture?.('form_submitted', {
                  form_type: formType,
                  locale: pageLang || 'en',
                  path: window.location.pathname,
                });
              } catch {
                // Analytics is best effort and must not change form success.
              }

              form.reset();
              status.className = 'form-status ok';
              status.textContent =
                form.dataset.successMsg ||
                document.documentElement.dataset.formSuccess ||
                'Message received! An advisor will reply within one working day.';
              // Replace the whole form with the success panel — leaving a live
              // submit button under a "sent" message invites duplicate sends.
              form.querySelectorAll<HTMLElement>(':scope > :not(.form-status)').forEach((el) => {
                el.setAttribute('hidden', '');
              });
              form.setAttribute('data-state', 'success');
              status.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (status) {
              status.className = 'form-status fail';
              // dataset.formFail (rendered on <html> with the localized
              // WhatsApp number) is always present; this fallback is the
              // pathological missing-attribute case, so it stays generic.
              status.textContent =
                document.documentElement.dataset.formFail ||
                'Something went wrong sending the form. Please try again.';
            }
          } catch {
            if (status) {
              status.className = 'form-status fail';
              status.textContent =
                document.documentElement.dataset.formNetwork ||
                'Network error — please check your connection and try again.';
            }
          } finally {
            if (btn) {
              btn.disabled = false;
              btn.classList.remove('is-loading');
              btn.removeAttribute('aria-busy');
            }
          }
        });

        form.querySelectorAll('input, select, textarea').forEach((el) => {
          el.addEventListener('input', () => el.closest('.field')?.classList.remove('invalid'));
        });
      });

      function validate(form: HTMLFormElement): boolean {
        let ok = true;
        let firstInvalid: HTMLElement | null = null;

        form.querySelectorAll<HTMLElement>('input, select, textarea').forEach((el) => {
          const field = el.closest('.field');
          const input = el as HTMLInputElement;
          const value = input.value.trim();
          let valid = true;

          if (input.hasAttribute('required') && !value) valid = false;
          if (valid && value && input.type === 'email' && !/^\S+@\S+\.\S+$/.test(value)) valid = false;
          if (valid && value && input.type === 'tel' && value.replace(/\D/g, '').length < 7) valid = false;

          if (field) field.classList.toggle('invalid', !valid);
          input.setAttribute('aria-invalid', valid ? 'false' : 'true');
          if (!valid) {
            ok = false;
            firstInvalid = firstInvalid || el;
          }
        });

        (firstInvalid as HTMLElement | null)?.focus();
        return ok;
      }
    </script>
  </body>
</html>

<style>
  /* ---------- Homepage loader ---------- */
  .rta-loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
  }

  .rta-loader-cover {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
