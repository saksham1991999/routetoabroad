    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.35rem);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.32, 0, 0.2, 1);
  }

  .rta-loader.is-split .rta-loader-stack {
    opacity: 0;
    transform: scale(0.96);
  }

  .rta-loader-mark {
    width: clamp(112px, 16vw, 168px);
    height: auto;
    display: block;
    direction: ltr;
    overflow: visible;
    color: var(--accent);
    opacity: 0;
  }

  :global(html[data-theme='dark']) .rta-loader-mark {
    color: #ffffff;
  }

  .rta-loader-mark.is-ready {
    opacity: 1;
  }

  .rta-loader-line {
    position: relative;
    height: 1.1em;
    overflow: hidden;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }

  .rta-loader-word {
    display: block;
    transform: translateY(115%);
    opacity: 0;
  }

  .rta-loader-word.is-in {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.26s cubic-bezier(0.32, 0, 0.2, 1), opacity 0.26s linear;
  }

  .rta-loader-word.is-out {
    transform: translateY(-115%);
    opacity: 0;
    transition: transform 0.2s cubic-bezier(0.32, 0, 0.2, 1), opacity 0.2s linear;
  }

  .no-js .rta-loader {
    display: none;
  }

  /* Repeat visits and reduced motion never paint the loader: the pre-paint
     head script only sets html[data-loader] when it will actually play. */
  :global(html:not([data-loader])) .rta-loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rta-loader {
      display: none;
    }
  }

  /* ---------- Homepage HUD ---------- */
  .rta-hud {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 54px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink);
    pointer-events: none;
    transition: color 0.3s ease, opacity 0.4s ease, transform 0.4s var(--ease-out);
  }

  :global(body[data-tone='dark']) .rta-hud {
    color: #F4F2EC;
  }

  .rta-hud.is-hidden {
    opacity: 0;
    transform: translateY(8px);
    /* remove from the a11y tree + pointer routing only after the fade */
    visibility: hidden;
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out), visibility 0s 0.4s;
  }

  .rta-hud-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .rta-hud-link {
