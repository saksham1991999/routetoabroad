---
import '../styles/tokens.css';
import '../styles/global.css';
// RTL rules are NOT imported as a bundled stylesheet: with
// build.inlineStylesheets 'always' every byte here would be inlined into all
// 280 pages while only /ar/ pages use them. The CSS text is imported raw and
// injected as an inline <style> on Arabic pages only (see <head> below).
import rtlCss from '../styles/rtl.css?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import SiteSchemas from '../components/SiteSchemas.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../lib/site';
import { localeFromPath, LOCALE_META, translatePath, type Locale } from '../lib/i18n';
import { uiFor } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  /** Forwarded to Seo: 'article' for blog/guide pages. */
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: { name: string; url: string }[];
  jsonLd?: object[];
  /** Forwarded to Seo for og:type=article metadata. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** article pages show a reading-progress bar */
  progress?: boolean;
  /** Locale of this page. Defaults to detection from Astro.url.pathname. */
  locale?: Locale;
  /** Hide the language switcher (e.g. the 404 page, whose locale variants
   * intentionally do not exist to link to). */
  hideSwitcher?: boolean;
}

const {
  title,
  description,
  path,
  image,
  type,
  noindex,
  crumbs,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  progress = false,
  locale,
  hideSwitcher = false,
} = Astro.props;

/** Resolve the page locale — explicit prop wins, fall back to URL detection. */
const pageLocale: Locale = locale ?? localeFromPath(Astro.url.pathname);
const isRtl = LOCALE_META[pageLocale].dir === 'rtl';
/** Chrome strings for this page's locale (en pages keep their inline copy). */
const ui = uiFor(pageLocale);

/** Homepage gets the loader, HUD and tone-switching chrome. Locale homepages
 * (/, /zh, /fr, /ar, /es) count as home too — the loader/HUD live here. */
const isHome = ['', '/'].includes(
  Astro.url.pathname.replace(/^\/+(zh|fr|ar|es)(?=\/|$)/, '') || '/'
);
---

<!doctype html>
<html
  lang={pageLocale}
  dir={isRtl ? 'rtl' : 'ltr'}
  class="no-js"
  data-form-success={ui.form.success}
  data-form-fail={ui.form.fail}
  data-form-network={ui.form.network}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RouteToAbroad Insights" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <Seo {title} {description} {path} {image} {type} {noindex} {crumbs} {publishedTime} {modifiedTime} {jsonLd} locale={pageLocale}>
      {Astro.slots.has('head-extra') && <slot name="head-extra" />}
    </Seo>

    <SiteSchemas />

    {/* RTL overrides ship only to Arabic pages — see the import note above. */}
    {isRtl && <style is:inline set:html={rtlCss} />}

    <script is:inline>
      // Pre-paint theme to avoid flash-of-wrong-theme. Resolves stored
      // choice → system preference, then syncs the browser UI color to the
      // RESOLVED theme (the media-query metas below only reflect the system,
      // which disagrees when the user has explicitly picked the other side).
      (function () {
        try {
          var stored = localStorage.getItem('rta-theme');
          var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach(function (m) { m.remove(); });
          var meta = document.createElement('meta');
          meta.name = 'theme-color';
          meta.content = theme === 'dark' ? '#0a0a0a' : '#f7f7f7';
          document.head.appendChild(meta);
        } catch (e) {}
      })();
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline>
      // Pre-paint loader decision, made purely from state — the loader element
      // lives in <body> and is unreachable from <head>, so there is no element
      // lookup here. html[data-loader] holds the homepage hero until the
      // loader dispatches 'rta:loaded' (see index.astro handoff). Repeat
      // visits (sessionStorage) and reduced-motion never see the loader.
      (function () {
        // Reduced motion first — it must hold even if storage access throws.
        var willPlay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (sessionStorage.getItem('rta-loader') === '1') willPlay = false;
        } catch (e) {}
        if (willPlay) document.documentElement.setAttribute('data-loader', '');
      })();
    </script>

    {progress && (
      <div class="scroll-progress" aria-hidden="true"><span></span></div>
    )}
  </head>
  <body data-chrome={isHome ? 'home' : 'inner'} data-tone="light">
    <a class="skip-link" href="#main">{ui.skipLink}</a>
    <Header locale={pageLocale} hideSwitcher={hideSwitcher} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={pageLocale} />
    <ChatWidget locale={pageLocale} />

    {
      isHome && (
        <div class="rta-loader" id="rta-loader" aria-hidden="true" data-loader-words={ui.hud.loaderWords.join('|')}>
          <div class="rta-loader-cover rta-loader-cover--top" />
          <div class="rta-loader-cover rta-loader-cover--bottom" />
          <p class="rta-loader-line">
            <span class="rta-loader-word" data-loader-word>
              {ui.hud.loaderWords[0]}
            </span>
          </p>
        </div>
      )
    }
    {
      isHome && (
        <div class="rta-hud">
          <span class="rta-hud-item" aria-hidden="true">
            {ui.hud.tagline}
          </span>
          <div class="rta-hud-right">
            <a class="rta-hud-link" href={SITE.whatsapp} rel="noopener">
              WhatsApp <bdi>{SITE.phoneIndia}</bdi>
            </a>
            <span class="rta-hud-item" aria-hidden="true">{ui.hud.scroll}</span>
            <span class="rta-hud-percent" role="status">
              <span data-scroll-percent>0%</span>
            </span>
          </div>
        </div>
      )
    }

    <a class="rta-tab" id="rta-tab" href={translatePath('/tools/fit-check', pageLocale)}>{ui.headerCta}</a>

    <script>
      // Single source of truth for the Formspree endpoint (src/lib/site.ts).
      import { FORMSPREE_ENDPOINT as FORMSPREE } from '../lib/site';

      // ---- Theme toggle (syncs the browser UI color too) ----
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((m) => m.remove());
        const meta = document.createElement('meta');
        meta.name = 'theme-color';
        meta.content = next === 'dark' ? '#0a0a0a' : '#f7f7f7';
        document.head.appendChild(meta);
        try {
          localStorage.setItem('rta-theme', next);
        } catch {}
      });

      // ---- Homepage loader: masked word timeline, then covers split ----
      // Suppression lives here (the old body guard script is gone): repeat
      // visits and reduced-motion get the loader removed without a replay,
      // and the hero never holds because html[data-loader] was not set.
      const loader = document.getElementById('rta-loader');
      if (loader) {
        let skip = false;
        try {
          skip = sessionStorage.getItem('rta-loader') === '1';
        } catch {
          /* storage unavailable — let the loader play */
        }
        if (skip || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          loader.remove();
          window.dispatchEvent(new CustomEvent('rta:loaded'));
        } else {
          const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
          const run = async () => {
            const word = loader.querySelector<HTMLElement>('[data-loader-word]');
            // Localized loader words (fallback: English), joined with '|' in
            // the data attribute because FormData/HTML attr values are strings.
            const words =
              loader.dataset.loaderWords?.split('|').filter(Boolean) ?? ['Choose', 'Apply', 'Enroll'];
            document.body.classList.add('rta-locked');
            if (word) {
              for (const next of words) {
                word.textContent = next;
                word.classList.add('is-in');
                await wait(450 + 280); // in 0.45s + hold 0.28s
                word.classList.remove('is-in');
                word.classList.add('is-out');
                await wait(350); // out 0.35s
                word.classList.remove('is-out');
              }
            }
            // Covers split — announce first so the hero can start as they move.
            window.dispatchEvent(new CustomEvent('rta:loaded'));
            loader.classList.add('is-split');
            try {
              sessionStorage.setItem('rta-loader', '1');
            } catch {}
            await wait(1050);
            loader.remove();
            document.body.classList.remove('rta-locked');
          };
          requestAnimationFrame(() => requestAnimationFrame(() => void run()));
        }
      }

      // ---- Reveal on scroll (IntersectionObserver, stagger via --reveal-delay) ----
      // Fires just before elements enter the viewport so content never feels late.
      const revealEls = document.querySelectorAll('[data-reveal]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // ---- Animated counters ----
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length) {
        const io2 = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io2.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.counter || '0');
              const decimals = ((el.dataset.counter ?? '').split('.')[1] || '').length;
              const suffix = el.dataset.suffix || '';
              const duration = 1300;
              const start = performance.now();
              const step = (now: number) => {
                const p = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = (target * eased).toFixed(decimals) + suffix;
                if (p < 1) requestAnimationFrame(step);
              };
              if (reduced) el.textContent = target.toFixed(decimals) + suffix;
              else requestAnimationFrame(step);
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => io2.observe(el));
      }

      // ---- Scroll chrome: HUD percent, floating CTA tab, tone switching ----
      const hud = document.querySelector<HTMLElement>('.rta-hud');
      const hudPercent = document.querySelector<HTMLElement>('[data-scroll-percent]');
      const ctaTab = document.getElementById('rta-tab');
      // Exclude <body>: it carries a default data-tone and always intersects
      // the probe, which previously pinned the chrome to "light" forever.
      const toneSections = Array.from(
        document.querySelectorAll<HTMLElement>('[data-tone]')
      ).filter((el) => el !== document.body);

      const writePercent = () => {
        if (!hudPercent) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
        hudPercent.textContent = `${Math.round(p * 100)}%`;
      };

      let toneQueued = false;
      const updateTone = () => {
        toneQueued = false;
        // Sample behind the fixed header, not a quarter down the viewport:
        // a dark band starting below the header must not flip the chrome
        // white while it is still sitting over paper.
        const probe = 40;
        let next = 'light';
        for (const section of toneSections) {
          const rect = section.getBoundingClientRect();
          if (rect.top <= probe && rect.bottom >= probe) {
            next = section.dataset.tone || 'light';
            break;
          }
          // Below every tone region (e.g. inside the footer): keep the last tone.
          if (rect.top > probe) break;
        }
        if (document.body.dataset.tone !== next) document.body.dataset.tone = next;
      };

      const onScrollChrome = () => {
        writePercent();
        ctaTab?.classList.toggle('is-in', window.scrollY > 200);
        // Fade the HUD before it can collide with the footer's own small print.
        if (hud) {
          const nearBottom =
            window.scrollY + window.innerHeight >=
            document.documentElement.scrollHeight - 120;
          hud.classList.toggle('is-hidden', nearBottom);
        }
        if (toneSections.length && !toneQueued) {
          toneQueued = true;
          requestAnimationFrame(updateTone);
        }
      };

      if (hudPercent || ctaTab || toneSections.length) {
        window.addEventListener('scroll', onScrollChrome, { passive: true });
        window.addEventListener('resize', onScrollChrome, { passive: true });
        onScrollChrome();
      }

      // ---- Scroll progress fallback (browsers without scroll-driven animations) ----
      if (!CSS.supports('animation-timeline: scroll()')) {
        const bar = document.querySelector('.scroll-progress span');
        if (bar) {
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            const p = max > 0 ? Math.min(scrollY / max, 1) : 0;
            (bar as HTMLElement).style.transform = `scaleX(${p})`;
          };
          addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      }

      // ---- Forms: validation + Formspree AJAX submit (endpoint from src/lib/site.ts) ----

      document.querySelectorAll<HTMLFormElement>('form[data-formspree]').forEach((form) => {
        const status = form.querySelector<HTMLElement>('.form-status');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!validate(form)) return;

          const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (btn) {
            btn.disabled = true;
            btn.classList.add('is-loading');
            btn.setAttribute('aria-busy', 'true');
          }

          try {
            // Tag the submission with the page locale so the business knows which
            // language the lead came in (the engine is shared across all locales).
            const fd = new FormData(form);
            const pageLang = document.documentElement.lang;
            if (pageLang) fd.append('locale', pageLang);
            const res = await fetch(FORMSPREE, {
              method: 'POST',
              body: fd,
              headers: { Accept: 'application/json' },
            });

            if (status && res.ok) {
              form.reset();
              status.className = 'form-status ok';
              status.textContent =
                form.dataset.successMsg ||
                document.documentElement.dataset.formSuccess ||
                'Message received! An advisor will reply within one working day.';
              // Replace the whole form with the success panel — leaving a live
              // submit button under a "sent" message invites duplicate sends.
              form.querySelectorAll<HTMLElement>(':scope > :not(.form-status)').forEach((el) => {
                el.setAttribute('hidden', '');
              });
              form.setAttribute('data-state', 'success');
              status.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (status) {
              status.className = 'form-status fail';
              // dataset.formFail (rendered on <html> with the localized
              // WhatsApp number) is always present; this fallback is the
              // pathological missing-attribute case, so it stays generic.
              status.textContent =
                document.documentElement.dataset.formFail ||
                'Something went wrong sending the form. Please try again.';
            }
          } catch {
            if (status) {
              status.className = 'form-status fail';
              status.textContent =
                document.documentElement.dataset.formNetwork ||
                'Network error — please check your connection and try again.';
            }
          } finally {
            if (btn) {
              btn.disabled = false;
              btn.classList.remove('is-loading');
              btn.removeAttribute('aria-busy');
            }
          }
        });

        form.querySelectorAll('input, select, textarea').forEach((el) => {
          el.addEventListener('input', () => el.closest('.field')?.classList.remove('invalid'));
        });
      });

      function validate(form: HTMLFormElement): boolean {
        let ok = true;
        let firstInvalid: HTMLElement | null = null;

        form.querySelectorAll<HTMLElement>('input, select, textarea').forEach((el) => {
          const field = el.closest('.field');
          const input = el as HTMLInputElement;
          const value = input.value.trim();
          let valid = true;

          if (input.hasAttribute('required') && !value) valid = false;
          if (valid && value && input.type === 'email' && !/^\S+@\S+\.\S+$/.test(value)) valid = false;
          if (valid && value && input.type === 'tel' && value.replace(/\D/g, '').length < 7) valid = false;

          if (field) field.classList.toggle('invalid', !valid);
          input.setAttribute('aria-invalid', valid ? 'false' : 'true');
          if (!valid) {
            ok = false;
            firstInvalid = firstInvalid || el;
          }
        });

        (firstInvalid as HTMLElement | null)?.focus();
        return ok;
      }
    </script>
  </body>
</html>

<style>
  /* ---------- Homepage loader ---------- */
  .rta-loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
  }

  .rta-loader-cover {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: var(--paper);
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .rta-loader-cover--top {
    top: 0;
  }

  .rta-loader-cover--bottom {
    bottom: 0;
  }

  .rta-loader.is-split .rta-loader-cover--top {
    transform: translateY(-101%);
  }

  .rta-loader.is-split .rta-loader-cover--bottom {
    transform: translateY(101%);
  }

  .rta-loader-line {
    position: relative;
    z-index: 1;
    height: 1.1em;
    overflow: hidden;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }

  .rta-loader-word {
    display: block;
    transform: translateY(115%);
    opacity: 0;
  }

  .rta-loader-word.is-in {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.45s cubic-bezier(0.32, 0, 0.2, 1), opacity 0.45s linear;
  }

  .rta-loader-word.is-out {
    transform: translateY(-115%);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.32, 0, 0.2, 1), opacity 0.35s linear;
  }

  .no-js .rta-loader {
    display: none;
  }

  /* Repeat visits and reduced motion never paint the loader: the pre-paint
     head script only sets html[data-loader] when it will actually play. */
  :global(html:not([data-loader])) .rta-loader {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rta-loader {
      display: none;
    }
  }

  /* ---------- Homepage HUD ---------- */
  .rta-hud {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 54px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #ffffff;
    mix-blend-mode: difference;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out);
  }

  .rta-hud.is-hidden {
    opacity: 0;
    transform: translateY(8px);
    /* remove from the a11y tree + pointer routing only after the fade */
    visibility: hidden;
    transition: opacity 0.4s ease, transform 0.4s var(--ease-out), visibility 0s 0.4s;
  }

  .rta-hud-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .rta-hud-link {
    pointer-events: auto;
    color: #ffffff;
    text-decoration: none;
    /* 44px tap target inside the 54px HUD row; transparent padding keeps the
       visible label pixel-identical and the row height untouched. */
    padding-block: 0.85rem;
  }

  .rta-hud-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rta-hud-percent {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    /* Keep only the WhatsApp link + percent on small screens */
    .rta-hud-item {
      display: none;
    }
  }

  /* ---------- Floating CTA tab (all pages) ---------- */
  .rta-tab {
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 80;
    writing-mode: vertical-rl;
    background: var(--accent-surface);
    color: #ffffff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding: 1.25rem 0.6rem;
    border-radius: 999px 0 0 999px;
    box-shadow: 0 1px 18px rgba(94, 120, 238, 0.28);
    transform: translateX(110%);
    visibility: hidden;
    transition: transform 0.5s var(--ease-out), visibility 0.5s, background-color 0.2s;
  }

  html[data-theme='dark'] .rta-tab {
    background: var(--accent-strong);
    color: #0a0a0a; /* light periwinkle needs dark ink for contrast */
  }

  .rta-tab:hover {
    background: #4a63d8;
  }

  html[data-theme='dark'] .rta-tab:hover {
    background: var(--accent);
  }

  .rta-tab.is-in {
    transform: translateX(0);
    visibility: visible;
  }

  /* The mobile menu owns the screen — never float over it, and never leave
     a focusable control invisible (opacity alone keeps it in tab order). */
  body:has(.mobile-menu:not([hidden])) .rta-tab {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>
