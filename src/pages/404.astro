---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="That page is not on this route. Head home, or start with the fit check."
  path="/404"
  noindex
  hideSwitcher
>
  <section class="section nf">
    <div class="container-text nf-inner">
      <p class="num nf-code">404</p>
      <h1>That page is not on this route.</h1>
      <p class="nf-sub">The link is old, mistyped, or the page has moved. Nothing lost.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/tools/fit-check" class="btn btn-outline">Start the fit check</a>
      </div>
      <p class="nf-hint">Or try: <a href="/education">Education</a> · <a href="/tourism">Tourism</a> · <a href="/trade">Trade</a> · <a href="/guides">Guides</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(5rem, 14vw, 10rem);
    text-align: center;
  }

  .nf-code {
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--accent);
    line-height: 0.9;
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--step-4);
  }

  .nf-sub {
    margin-top: 0.9rem;
    color: var(--ink-label);
  }

  .nf-actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .nf-hint {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .nf-hint a {
    color: var(--ink);
    text-decoration: none;
  }

  .nf-hint a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
