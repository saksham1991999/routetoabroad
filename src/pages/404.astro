---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NOT_FOUND } from '../i18n/pages/not-found';
import { PREFIXED_LOCALES } from '../lib/i18n';

/**
 * 404 — one static page serves every missing URL, so the locale is unknown
 * at build time. The copy ships for all five locales in a data attribute and
 * an inline script (below) applies the language matching the requested URL's
 * prefix (/zh/… → zh), including <html lang/dir>, document.title and the
 * localized link hrefs. English is the default and crawler-visible markup.
 */
---

<BaseLayout
  title="Page Not Found"
  description="That page is not on this route. Head home, or start with the fit check."
  path="/404"
  noindex
  hideSwitcher
>
  <section class="section nf" data-404={JSON.stringify(NOT_FOUND)}>
    <div class="container-text nf-inner">
      <p class="num nf-code">404</p>
      <h1 data-404-heading>That page is not on this route.</h1>
      <p class="nf-sub" data-404-sub>The link is old, mistyped, or the page has moved. Nothing lost.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary" data-404-home>Go home</a>
        <a href="/tools/fit-check" class="btn btn-outline" data-404-fit>Start the fit check</a>
      </div>
      <p class="nf-hint"><span data-404-hintpre>Or try: </span><a href="/education" data-404-edu>Education</a> · <a href="/tourism" data-404-tour>Tourism</a> · <a href="/trade" data-404-trade>Trade</a> · <a href="/guides" data-404-guides>Guides</a></p>
    </div>
  </section>

  <script is:inline define:vars={{ prefixes: PREFIXED_LOCALES }}>
    // Apply the copy for the requested URL's locale prefix (the 404 is one
    // static page for every missing URL, so the locale is runtime knowledge).
    // Inline JS cannot import from i18n.ts, so the prefixes arrive through
    // define:vars from the same LOCALES list.
    (function () {
      var m = location.pathname.match(new RegExp('^\\/(' + prefixes.join('|') + ')(?=\\/|$)'));
      if (!m) return;
      var packEl = document.querySelector('[data-404]');
      if (!packEl) return;
      var packs;
      try {
        packs = JSON.parse(packEl.getAttribute('data-404'));
      } catch (e) {
        return;
      }
      var t = packs[m[1]];
      if (!t) return;
      var p = '/' + m[1];
      document.documentElement.lang = m[1];
      document.documentElement.dir = ['ar'].includes(m[1]) ? 'rtl' : 'ltr';
      document.title = t.title;
      var set = function (sel, key) {
        var el = document.querySelector(sel);
        if (el) el.textContent = t[key];
      };
      set('[data-404-heading]', 'heading');
      set('[data-404-sub]', 'sub');
      set('[data-404-hintpre]', 'hintPre');
      var home = document.querySelector('[data-404-home]');
      if (home) {
        home.textContent = t.goHome;
        home.href = p + '/';
      }
      var fit = document.querySelector('[data-404-fit]');
      if (fit) {
        fit.textContent = t.fitCheck;
        fit.href = p + '/tools/fit-check';
      }
      var links = [
        ['[data-404-edu]', 'education', '/education'],
        ['[data-404-tour]', 'tourism', '/tourism'],
        ['[data-404-trade]', 'trade', '/trade'],
        ['[data-404-guides]', 'guides', '/guides'],
      ];
      links.forEach(function (l) {
        var el = document.querySelector(l[0]);
        if (el) {
          el.textContent = t[l[1]];
          el.href = p + l[2];
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(5rem, 14vw, 10rem);
    text-align: center;
  }

  .nf-code {
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--accent-text);
    line-height: 0.9;
  }

  h1 {
    margin-top: 1.5rem;
    font-size: var(--step-4);
  }

  .nf-sub {
    margin-top: 0.9rem;
    color: var(--ink-label);
  }

  .nf-actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .nf-hint {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .nf-hint a {
    color: var(--ink);
    text-decoration: none;
  }

  .nf-hint a:hover {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
