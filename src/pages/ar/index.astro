---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../../components/Marquee.astro';
import SectionHead from '../../components/SectionHead.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import StatsBand from '../../components/StatsBand.astro';
import { GENERAL_FAQS } from '../../data/faqs';
import { faqSchema, reviewSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const campusImg = (await import('../../assets/images/hero-campus-ink.jpg')).default;
const eduImg = (await import('../../assets/images/hero-education.jpg')).default;
const tourismImg = (await import('../../assets/images/hero-tourism.jpg')).default;
const tradeImg = (await import('../../assets/images/hero-trade.jpg')).default;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeFaqs = GENERAL_FAQS.slice(0, 5);

// Corridor coordinates — single source of truth, same pattern as PageHero:
// the instrument labels below and the canvas-globe markers all derive from
// SITE.offices so the numbers can't drift from the rest of the site.
const OFFICES = [
  { code: 'DEL', city: SITE.offices[0].city, lat: SITE.offices[0].lat, lng: SITE.offices[0].lng },
  { code: 'CAN', city: SITE.offices[1].city, lat: SITE.offices[1].lat, lng: SITE.offices[1].lng },
];
const [DELHI, GUANGZHOU] = OFFICES;
// Passed to the client script via the globe canvas's data-markers attribute
// (the bundled script can't import SITE directly).
const globeMarkers = [
  { name: 'Delhi', lat: DELHI.lat, lon: DELHI.lng },
  { name: 'Guangzhou', lat: GUANGZHOU.lat, lon: GUANGZHOU.lng },
];

const stats = [
  { value: '500+', counter: '500', suffix: '+', label: 'Students placed' },
  { value: '12+', counter: '12', suffix: '+', label: 'Years in the corridor' },
  { value: '98%', counter: '98', suffix: '%', label: 'Visa success rate' },
  { value: '3', counter: '3', label: 'Countries served' },
];

const pillars = [
  {
    n: '01',
    key: 'Education',
    href: '/ar/education',
    image: eduImg,
    alt: 'Students collaborating in a bright modern Chinese university laboratory',
    lead: 'Subsidised global education',
    text: 'University placement, CSC and university scholarships, MBBS and engineering tracks, visas and arrival — run end to end from application to campus registration.',
    stat: '500+ students placed',
  },
  {
    n: '02',
    key: 'Tourism',
    href: '/ar/tourism',
    image: tourismImg,
    alt: 'A traveller looking over the Great Wall of China at golden hour',
    lead: 'Bespoke heritage journeys',
    text: 'Private and group travel through China and Japan — curated itineraries, bilingual guides, visa concierge, and a 24/7 desk while you travel.',
    stat: 'China · Japan · custom groups',
  },
  {
    n: '03',
    key: 'Trade',
    href: '/ar/trade',
    image: tradeImg,
    alt: 'Container cranes working at the Guangzhou port at dawn',
    lead: 'Cross-border trade, handled',
    text: 'Sourcing, factory audits, AQL quality gates, customs and freight between India and China — on a success fee tied to shipped value.',
    stat: '200+ vetted suppliers',
  },
];

const illuminated = [
  {
    text: 'Match you to a programme.',
    gloss:
      'University placement, CSC scholarships, MBBS and engineering tracks, visas and arrival — run end to end.',
  },
  {
    text: 'Design the journey.',
    gloss:
      'Private and group travel through China and Japan — curated itineraries, bilingual guides, a 24/7 desk while you travel.',
  },
  {
    text: 'Move the goods.',
    gloss:
      'Sourcing, factory audits, customs and freight between India and China — on a success fee tied to shipped value.',
  },
];

const tools = [
  { n: '01', href: '/ar/tools/fit-check', label: 'Fit check', desc: 'Four questions. A straight yes, maybe, or not this intake.' },
  { n: '02', href: '/ar/tools/scholarship-eligibility', label: 'Scholarship check', desc: 'Where your profile actually sits for CSC and university awards.' },
  { n: '03', href: '/ar/tools/cost-calculator', label: 'Cost calculator', desc: 'Tuition plus living costs by city, programme and lifestyle.' },
  { n: '04', href: '/ar/tools/document-checklist', label: 'Document checklist', desc: 'Your personalised list, printable, nothing missing.' },
  { n: '05', href: '/ar/tools/timeline-planner', label: 'Timeline planner', desc: 'Your intake date, worked backwards into a month-by-month plan.' },
];
---

<BaseLayout
  locale="ar"
  title="RouteToAbroad — Study in China, Travel East Asia, Trade Across Borders"
  description="We place students in Chinese universities, design journeys through East Asia, and run India–China trade operations. Offices in New Delhi and Guangzhou. Start with a free fit check."
  path="/"
  jsonLd={[faqSchema(homeFaqs), reviewSchema(
    // @ts-expect-error rating optional mismatch is fine here
    [{ author: 'Ananya Krishnan', reviewBody: 'RouteToAbroad didn\'t just find me a university; they found me a future.', rating: 5 }]
  )]}
>
  <!-- ============================================================
       1 · PINNED JOURNEY HERO — two 100vw slides on a flex track,
       translated by scroll progress; dashed route + paper plane
       driven from one rAF-throttled scroll handler.
       ============================================================ -->
  <section class="journey" id="journey" data-tone="light" aria-label="From anywhere to campus">
    <div class="journey-stage" id="journey-stage">
      <div class="journey-track" id="journey-track">
        <!-- Slide 1 · origin -->
        <div class="journey-slide slide-origin" id="slide-origin">
          <div class="slide-origin-inner" id="slide-origin-inner">
            <p class="journey-eyebrow">Education · Tourism · Trade</p>
            <h1 class="journey-title">
              <span class="jline"><span class="jline-inner">From</span></span>
              <span class="jline"><span class="jline-inner">anywhere</span></span>
              <span class="visually-hidden"> to campus.</span>
            </h1>
            <p class="journey-sub">
              Study, travel and trade between India and East Asia — run by people who live on
              both sides of the corridor.
            </p>

            <div class="globe-wrap" id="globe-wrap">
              <canvas
                id="globe-canvas"
                class="globe"
                role="img"
                aria-label="Dotted globe highlighting RouteToAbroad's offices in Delhi and Guangzhou"
                data-markers={JSON.stringify(globeMarkers)}
              ></canvas>
            </div>

            <form class="origin-form" id="origin-form">
              <label class="origin-label" for="origin-input">where do you live?</label>
              <input
                class="origin-input"
                id="origin-input"
                name="origin"
                type="text"
                maxlength="60"
                autocomplete="address-level2"
                placeholder="Delhi · Kochi · Guwahati"
              />
              <span class="origin-hint">Press Enter to fly the route →</span>
            </form>

          </div>
        </div>

        <!-- Journey spacer -->
        <div class="journey-spacer" id="journey-spacer" aria-hidden="true"></div>

        <!-- Slide 2 · campus -->
        <div class="journey-slide slide-campus" id="slide-campus">
          <div class="slide-campus-inner">
            <p class="campus-kicker">03 / Arrival</p>
            <p class="display campus-echo" aria-hidden="true">to campus.</p>
            <div class="campus-frame" id="campus-frame">
              <Picture
                src={campusImg}
                alt="Fine ink-line drawing of a university campus with trees and walkways"
                widths={[960, 1600, 2000]}
                sizes="(max-width: 64rem) 92vw, 66vw"
                formats={['avif', 'webp']}
                loading="lazy"
                class="campus-img"
              />
            </div>
            <p class="campus-coord num">Guangzhou · {GUANGZHOU.lat.toFixed(2)}°N / {GUANGZHOU.lng.toFixed(2)}°E</p>
            <div class="campus-foot" id="journey-cta">
              <p class="campus-lede">
                Admissions, visas, journeys and freight between India and East Asia — run by people
                who live on both sides.
              </p>
              <div class="campus-actions">
                <a href="/ar/tools/fit-check" class="btn btn-primary">Check if you fit</a>
                <a href="/ar/education" class="btn btn-ghost">Explore programmes</a>
              </div>
              <p class="campus-note">No commitment · a human replies within one working day.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Instrument coordinates, pinned to the stage -->
      <span class="stage-coord stage-coord--left" aria-hidden="true">{DELHI.lat.toFixed(2)}°N · {DELHI.code}</span>
      <span class="stage-coord stage-coord--right" aria-hidden="true">{GUANGZHOU.lng.toFixed(2)}°E · {GUANGZHOU.code}</span>

      <!-- Journey progress strip: fills the narrative gap between slides -->
      <div class="journey-strip" aria-hidden="true">
        <span class="js-stop is-active">01 Origin</span>
        <span class="js-stop">02 In transit</span>
        <span class="js-stop">03 Campus</span>
        <span class="journey-strip-progress" id="journey-progress"></span>
      </div>

      <!-- Route overlay: dashed Bézier + paper plane -->
      <svg class="route-svg" id="route-svg" aria-hidden="true" focusable="false">
        <path id="route-path" d="" />
      </svg>
      <span class="plane" id="plane" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path transform="rotate(-45 12 12)" d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" fill="#111"></path>
        </svg>
      </span>
    </div>
  </section>

  <!-- ============================================================
       2 · ILLUMINATED STATEMENT — words light up word-by-word
       ============================================================ -->
  <section class="illum" id="illum" data-tone="light" aria-label="What we do">
    <div class="illum-pin">
      <div class="illum-inner">
        <p class="eyebrow">This is what we do</p>
        <div class="illum-lines">
          {illuminated.map((line) => (
            <div class="illum-row">
              <p class="display illum-line">
                {line.text.split(' ').map((w, i) => (
                  <span data-word style={`--wd: ${i * 110}ms`}>{w}{' '}</span>
                ))}
              </p>
              <p class="illum-gloss">{line.gloss}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 · PILLARS — numbered ruled rows
       ============================================================ -->
  <section class="section pillars" data-tone="light" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHead
        eyebrow="What we do"
        index="01 / 04"
        title="<span id='pillars-title'>Three ways across one corridor.</span>"
        lede="Three capabilities, one corridor, run by people who live on both sides of it. Pick the door — they all open."
      />
      <div class="pillar-rows">
        {pillars.map((p, i) => (
          <a href={p.href} class="pillar-row" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="pillar-id">
              <span class="pillar-n num">{p.n}</span>
              <h3 class="pillar-name">{p.key}</h3>
            </div>
            <div class="pillar-desc">
              <p class="pillar-lead">{p.lead}</p>
              <p class="pillar-text">{p.text}</p>
              <p class="pillar-stat num">{p.stat}</p>
            </div>
            <div class="pillar-media">
              <Picture
                src={p.image}
                alt={p.alt}
                widths={[480, 800]}
                sizes="(max-width: 64rem) 100vw, 30vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
            <span class="pillar-go arrow-link">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · PROOF STRIP -->
  <Marquee />

  <!-- 5 · STATS — black instrument band -->
  <div data-tone="dark">
    <StatsBand stats={stats} locale="ar" />
  </div>

  <!-- ============================================================
       6 · TOOLS — numbered ruled rows
       ============================================================ -->
  <section class="section tools" data-tone="light" aria-labelledby="tools-title">
    <div class="container">
      <SectionHead
        eyebrow="Free tools"
        index="02 / 04"
        title="<span id='tools-title'>Start with facts, not brochures.</span>"
        lede="Five quick tools that give you real numbers before you ever talk to us. No email required."
        action={{ href: '/ar/tools', label: 'All tools' }}
      />
      <div class="tool-rows">
        {tools.map((t, i) => (
          <a href={t.href} class="tool-row" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="tool-n num">{t.n}</span>
            <span class="tool-body">
              <h3 class="tool-name">{t.label}</h3>
              <span class="tool-desc">{t.desc}</span>
            </span>
            <span class="tool-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       7 · INSIGHTS — featured posts as ruled rows
       ============================================================ -->
  <section class="section insights" data-tone="light" aria-labelledby="insights-title">
    <div class="container">
      <SectionHead
        eyebrow="Latest insights"
        index="03 / 04"
        title="<span id='insights-title'>From the desk.</span>"
        lede="Field notes on studying, travelling and trading across the corridor."
        action={{ href: '/ar/blog', label: 'All articles' }}
      />
      <div class="post-rows">
        {posts.map((post, i) => (
          <a href={`/ar/blog/${post.id}`} class="post-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div class="post-body">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <p class="post-meta">
                {post.data.pubDate.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}
                {' '}· {post.data.category} · {post.data.readTime} min read
              </p>
            </div>
            <div class="post-thumb">
              <Picture
                src={post.data.image}
                alt={post.data.imageAlt}
                widths={[320, 480]}
                sizes="(max-width: 64rem) 28vw, 176px"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · TESTIMONIALS -->
  <div data-tone="light">
    <TestimonialCarousel locale="ar" />
  </div>

  <!-- ============================================================
       9 · FAQ
       ============================================================ -->
  <section class="section faq" data-tone="light" aria-labelledby="faq-title">
    <div class="container-wide faq-grid">
      <div class="faq-aside">
        <SectionHead
          eyebrow="Common questions"
          index="04 / 04"
          title="<span id='faq-title'>The honest answers.</span>"
          lede="The ones we hear most, kept short. The rest live in the FAQ."
        />
        <p class="faq-note">
          Still unsure? <a href="/ar/faq">Read every question</a> or
          <a href="/ar/contact">ask a human</a> — a real advisor replies.
        </p>
      </div>
      <div class="faq-panel">
        <FaqAccordion faqs={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- 10 · CLOSE -->
  <div data-tone="dark">
    <CtaBand locale="ar" />
  </div>
</BaseLayout>

<style>
  /* ============================================================
     1 · PINNED JOURNEY HERO
     ============================================================ */
  .journey {
    position: relative;
    height: 300vh;
    background: #f7f7f7;
  }

  .journey-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .journey-track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
  }

  .journey-slide {
    position: relative;
    flex: 0 0 100vw;
    height: 100%;
  }

  .journey-spacer {
    flex: 0 0 18vw;
  }

  /* --- Slide 1 · origin --- */
  .slide-origin {
    display: flex;
    align-items: center;
    justify-content: center;
    /* The globe docks above the incoming campus slide, so the arriving
       university never paints over it. */
    z-index: 2;
  }

  .slide-origin-inner {
    width: min(34rem, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 1.5rem 6.5rem;
  }

  .journey-eyebrow {
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.52);
  }

  .journey-title {
    display: block;
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: #111;
  }

  .journey-sub {
    margin-top: 1.2rem;
    max-width: 38ch;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.6;
    color: rgba(17, 17, 17, 0.62);
    text-wrap: pretty;
  }

  .jline {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .jline-inner {
    display: block;
    transition:
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .jline:nth-of-type(2) .jline-inner {
    transition-delay: 0.1s;
  }

  /* Hidden only while Agent F's loader is set to play (html[data-loader]),
     until it dispatches 'rta:loaded' and we add .hero-in (or the 2.5s fallback). */
  :global(html[data-loader]) .journey:not(.hero-in) .jline-inner {
    transform: translateY(130%);
    opacity: 0;
  }

  .globe-wrap,
  .origin-form {
    opacity: 1;
    transition: opacity 0.9s ease 0.45s;
  }

  :global(html[data-loader]) .journey:not(.hero-in) .globe-wrap,
  :global(html[data-loader]) .journey:not(.hero-in) .origin-form {
    opacity: 0;
  }

  .globe-wrap {
    margin-top: clamp(1.4rem, 3.5dvh, 2.4rem);
    /* The scroll driver counter-translates this against the track so the
       globe can dock at the left edge instead of scrolling away. */
    transform-origin: center;
    will-change: transform;
  }

  .globe {
    display: block;
    width: min(28vh, 224px);
    width: min(28dvh, 224px);
    height: min(28vh, 224px);
    height: min(28dvh, 224px);
    cursor: grab;
    touch-action: pan-y;
  }

  .globe:active {
    cursor: grabbing;
  }

  .origin-form {
    margin-top: clamp(1.2rem, 3dvh, 2rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .origin-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: rgba(17, 17, 17, 0.62);
  }

  .origin-input {
    margin-top: 0.8rem;
    width: min(18rem, 100%);
    padding: 0.45rem 0.25rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 0;
    font-size: 15px;
    text-align: center;
    color: #111;
    outline: none;
    transition: border-color 0.25s ease;
  }

  .origin-input:focus {
    border-bottom-color: #111;
    animation: origin-caret 1.6s ease-in-out infinite;
  }

  /* A soft signal pulse on the rule while the field is focused */
  @keyframes origin-caret {
    0%,
    100% {
      box-shadow: 0 1px 0 0 rgba(94, 120, 238, 0);
    }
    50% {
      box-shadow: 0 1px 0 0 rgba(94, 120, 238, 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-input:focus {
      animation: none;
    }
  }

  .origin-input::placeholder {
    color: rgba(0, 0, 0, 0.3);
  }

  .origin-hint {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.6);
  }

  /* --- Slide 2 · campus --- */
  .slide-campus {
    display: flex;
  }

  .slide-campus-inner {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(4.5rem, 8dvh, 6rem) clamp(1.25rem, 5vw, 4rem) clamp(5rem, 8dvh, 6.5rem);
  }

  .campus-kicker {
    margin-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.6);
  }

  .campus-echo {
    margin: 0;
    font-size: clamp(2.4rem, 6.4vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.9;
    color: #111;
  }

  .campus-coord {
    margin-top: 0.5rem;
    align-self: flex-end;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.6);
  }

  .campus-frame {
    margin-top: clamp(1.1rem, 2.4dvh, 1.8rem);
    width: min(64vw, 56rem);
    aspect-ratio: 2000 / 857;
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 0.55rem;
    background: #ffffff;
  }

  .campus-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Footer reads as an instrument row: statement left, actions right,
     note underneath — rather than three centred blocks stacked. */
  .campus-foot {
    margin-top: auto;
    padding-top: clamp(1.1rem, 2.4dvh, 1.8rem);
    width: min(64vw, 56rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2rem;
    text-align: start;
  }

  .campus-lede {
    margin: 0;
    max-width: 48ch;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(17, 17, 17, 0.6);
  }

  .campus-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .campus-note {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.6);
  }

  /* --- Stage instrument marks --- */
  .stage-coord {
    position: absolute;
    /* Sits above the vertical centre so the floating "Fit check" tab, which
       starts at 50% and hangs downward, never clips it. */
    top: 40%;
    z-index: 2;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: rgba(17, 17, 17, 0.28);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .stage-coord--left {
    left: 1.25rem;
    transform: translateY(-50%) rotate(180deg);
