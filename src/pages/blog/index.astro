---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Insights — Field Notes on Studying, Travelling & Trading in Asia"
  description="The RouteToAbroad desk blog: MBBS decisions, CSC scholarship guides, Beijing and Kyoto travel, India–China trade practice — written by the people doing the work."
  path="/blog"
  crumbs={[{ name: 'Insights', url: 'https://routetoabroad.com/blog' }]}
>
  <PageHero
    eyebrow="Insights"
    title="Notes from both sides of the bridge."
    lede="No listicles about '10 reasons to study abroad'. Field notes from admissions desks, tour routes and factory floors."
    crumbs={[{ name: 'Insights', url: '/blog' }]}
  />

  <section class="section">
    <div class="container">
      <div class="filter-row" role="tablist" aria-label="Filter articles by category">
        <button class="filter-pill active" data-filter="all" role="tab" aria-selected="true">All</button>
        <button class="filter-pill" data-filter="education" role="tab" aria-selected="false">Education</button>
        <button class="filter-pill" data-filter="tourism" role="tab" aria-selected="false">Tourism</button>
        <button class="filter-pill" data-filter="trade" role="tab" aria-selected="false">Trade</button>
      </div>

      <div class="posts-grid" id="posts-grid">
        {posts.map((post) => (
          <div class="post-item" data-category={post.data.category}>
            <ArticleCard
              title={post.data.title}
              href={`/blog/${post.id}`}
              description={post.data.description}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
              tag={post.data.category}
              pillar={post.data.category}
              meta={`${post.data.pubDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })} · ${post.data.readTime} min`}
            />
          </div>
        ))}
      </div>
      <p class="no-results" id="no-results" hidden>Nothing in this category yet — the desks are writing.</p>
    </div>
  </section>

  <CtaBand title="Reading is step one." text="When you want the answer for your specific case, the fit check takes four questions and the advisors reply within a day." />
</BaseLayout>

<style>
  .filter-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }

  .filter-pill {
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: transparent;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .filter-pill:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .filter-pill.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .post-item.hidden {
    display: none;
  }

  .no-results {
    margin-top: 2rem;
    color: var(--ink-faint);
    text-align: center;
  }

  @media (max-width: 64rem) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results') as HTMLElement;

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-selected', 'true');

      const filter = pill.dataset.filter;
      let visible = 0;
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.category === filter;
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      noResults.hidden = visible > 0;
    });
  });
</script>
