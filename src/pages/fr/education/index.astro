---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHead from '../../../components/SectionHead.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import CtaBand from '../../../components/CtaBand.astro';
import EducationForm from '../../../components/forms/EducationForm.astro';
import { EDUCATION_FAQS } from '../../../data/faqs';
import { faqSchema, serviceSchema, howToSchema } from '../../../lib/schema';

const heroImg = (await import('../../../assets/images/hero-education.jpg')).default;

const universities = (await getCollection('universities')).sort(
  (a, b) => a.data.order - b.data.order
);

const pageFaqs = EDUCATION_FAQS.slice(0, 6);

const programmes = [
  {
    name: 'MBBS / Medicine',
    text: 'MOE-listed English-medium medical degrees with WHO-recognised universities, integrated HSK training and FMGE/NExT planning from day one.',
    icon: 'M12 3v18M3 12h18',
  },
  {
    name: 'Engineering & Technology',
    text: 'AI, robotics, civil, mechanical and electrical engineering at universities wired into China\'s manufacturing economy.',
    icon: 'M14 6a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm6 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0ZM6 10v4a4 4 0 0 0 4 4',
  },
  {
    name: 'Business & Management',
    text: 'English-taught BBA, MBA and finance programmes in Shanghai and Beijing with internship access to employers.',
    icon: 'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
  },
  {
    name: 'Chinese Language (HSK)',
    text: 'HSK 1–6 pathway programmes, from zero to degree-readiness, with exam registration handled for you.',
    icon: 'M4 5h16M4 12h10M4 19h7',
  },
  {
    name: 'Bachelor\'s Degrees',
    text: 'Undergraduate programmes across economics, international business, design and computer science.',
    icon: 'M12 4 2 9l10 5 10-5-10-5ZM6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5',
  },
  {
    name: 'Masters & PhD (Research)',
    text: 'CSC-funded research placements — we match you to supervisors, shape proposals and manage the full file.',
    icon: 'M4 20V9m5 11V4m5 16v-8m5 8V7',
  },
];

const process = [
  { name: 'Initial consultation', time: 'Day 1–2', text: 'A free call: your marks, budget, goals. We tell you honestly where you stand — including when the answer is "not this route".' },
  { name: 'University matching', time: 'Day 3–5', text: 'A shortlist of MOE-listed universities matched to your profile and scholarship strategy, with real fee tables per programme.' },
  { name: 'Application filing', time: 'Week 1–2', text: 'We prepare and submit applications and scholarship files — study plan, translations, notarisation, portal forms.' },
  { name: 'Offer, JW202 & visa', time: 'Week 3–12', text: 'Offer letter and JW202 tracked from the university side; physical exam, embassy appointment and interview prep with our team.' },
  { name: 'Arrival & enrolment', time: 'September', text: 'Airport pickup, dorm registration, residence permit, SIM and bank account — the boring things that stall a first week, handled.' },
];
---

<BaseLayout
  locale="fr"
  title="Study in China — MBBS, Engineering & Scholarships"
  description="University placement in China end to end: MOE-listed universities, CSC scholarships, MBBS and engineering programmes, visa processing and arrival support. 500+ students placed."
  path="/education"
  image="/og/education.jpg"
  crumbs={[{ name: 'Education', url: '/fr/education' }]}
  jsonLd={[
    serviceSchema({
      name: 'Study in China — university placement',
      description: 'Admissions, scholarship and visa services for international students entering Chinese universities, from consultation to campus registration.',
      url: '/fr/education',
      serviceType: 'Education consultancy',
      areaServed: ['IN', 'CN', 'SA', 'AE', 'NG', 'KE'],
    }),
    howToSchema({
      name: 'How to study in China with RouteToAbroad',
      description: 'The five-step placement process from first consultation to campus enrolment.',
      steps: process.map((s) => ({ name: `${s.name} (${s.time})`, text: s.text })),
    }),
    faqSchema(pageFaqs),
  ]}
>
  <PageHero
    eyebrow="Education"
    index="EDU / 01"
    title="Study in China. Change everything."
    lede="English-taught degrees at MOE-listed universities, scholarships that actually reduce fees, and a team that stays with you from application to campus gate."
    crumbs={[{ name: 'Education', url: '/fr/education' }]}
    facts={[
      { label: 'Tuition from', value: 'US$2,500 / yr' },
      { label: 'Intakes', value: 'Sep · Feb' },
      { label: 'Language', value: 'English-taught' },
      { label: 'Placed', value: '500+ students' },
    ]}
    actions={[
      { href: '/tools/fit-check', label: 'Check your fit' },
      { href: '#programmes', label: 'See programmes', variant: 'outline' },
    ]}
    jumps={[
      { href: '#programmes', label: 'Programmes' },
      { href: '#process', label: 'Process' },
      { href: '#scholarships', label: 'Scholarships' },
      { href: '#universities', label: 'Universities' },
      { href: '#apply', label: 'Apply' },
      { href: '#faq', label: 'FAQ' },
    ]}
  />

  <section class="section">
    <div class="container edu-intro">
      <div class="quick-answer" data-reveal>
        <p class="qa-label">Short answer</p>
        <p>
          <strong>Yes — Chinese universities are a legitimate, affordable route for international students</strong>,
          provided you choose MOE-listed institutions and plan language and licensing exams from the start.
          Tuition typically runs US$2,500–8,000/year, and scholarships can cut it to zero.
        </p>
      </div>
      <figure class="edu-photo" data-reveal="right">
        <Picture
          src={heroImg}
          alt="International students collaborating in a modern Chinese university laboratory"
          widths={[640, 1024, 1600]}
          sizes="(max-width: 64rem) 100vw, 50vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
        <figcaption>Student cohorts we placed across Beijing, Shanghai and Hangzhou.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Programmes -->
  <section class="section section-sunken" id="programmes">
    <div class="container">
      <SectionHead
        eyebrow="Programmes"
        index="01 / 05"
        title="What you can study"
        lede="Five routes with teaching language and intake stated up front. Fees are quoted per university — a single number across a country would be a guess."
      />
      <div class="prog-grid">
        {programmes.map((p, i) => (
          <article class="prog-card card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={p.icon}></path>
            </svg>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process">
    <div class="container-text">
      <SectionHead
        eyebrow="The process"
        index="02 / 05"
        title="Five stops from first message to campus"
        lede="Step one takes about fifteen minutes. We file, follow up and chase until there is an offer — or a clear no with a reason."
      />
      <ol class="timeline">
        {process.map((step, i) => (
          <li class="timeline-step" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="t-num num">{String(i + 1).padStart(2, '0')}</span>
            <div class="t-body">
              <h3>{step.name}</h3>
              <p class="t-time num">{step.time}</p>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Scholarship calculator teaser -->
  <section class="section section-sunken" id="scholarships">
    <div class="container">
      <div class="calc-teaser card" data-reveal>
        <div>
          <p class="eyebrow">Free tool</p>
          <h2>Are you eligible for a Chinese scholarship?</h2>
          <p>
            Three honest questions about your marks and level. We'll tell you where your profile sits —
            full CSC range, partial awards, or self-funded with better odds. No fake "You qualify!" results.
          </p>
          <a href="/fr/tools/scholarship-eligibility" class="btn btn-primary">Check eligibility</a>
        </div>
        <div class="calc-stats">
          <div><p class="num">$2M+</p><p>scholarships won by our students</p></div>
          <div><p class="num">150+</p><p>partner universities</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Universities -->
  <section class="section" id="universities">
    <div class="container">
      <SectionHead
        eyebrow="University partners"
        index="03 / 05"
        title="Where our students go"
        lede="Profiles, real costs and admission realities for the five universities we place into most."
      />
      <div class="uni-grid">
        {universities.map((u, i) => (
          <a href={`/universities/${u.id}`} class="uni-card card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <div class="uni-media">
              <Picture src={u.data.image} alt={u.data.imageAlt} widths={[480, 800]} sizes="(max-width: 64rem) 100vw, 33vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="uni-body">
              <h3>{u.data.name}</h3>
              <p class="uni-city num">{u.data.city} · est. {u.data.founded}</p>
              <p>{u.data.nickname}</p>
              <span class="arrow-link">University profile</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section-sunken" id="apply" aria-labelledby="apply-title">
    <div class="container form-split">
      <div class="form-side" data-reveal>
        <SectionHead
          eyebrow="Start here"
          title="<span id='apply-title'>Apply for a free assessment</span>"
          lede="Tell us where you are. We come back within one working day with an honest read — and a plan if there is one."
        />
        <ul class="what-next">
          <li><strong>Verification within 24 hours.</strong> An advisor — not a bot — reviews your profile.</li>
          <li><strong>Callback in your language.</strong> English, Hindi, Malayalam; Mandarin on the China side.</li>
          <li><strong>A written roadmap.</strong> Universities, fees, scholarship chances, timeline — in writing.</li>
        </ul>
      </div>
      <div class="form-card card card-pad" data-reveal>
        <EducationForm />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container-text">
      <SectionHead center eyebrow="Education FAQ" index="05 / 05" title="Asked every season" />
      <FaqAccordion faqs={pageFaqs} />
      <p class="faq-more"><a href="/fr/education/faq" class="arrow-link">All education FAQs</a></p>
    </div>
  </section>

  <CtaBand locale="fr" />
</BaseLayout>

<style>
  .edu-intro {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .quick-answer {
    margin: 0;
  }

  .edu-photo {
    margin: 0;
  }

  /* The ratio lives on the wrapper: Astro's <Picture> width/height
     attributes otherwise win over an aspect-ratio set on the <img>. */
  .edu-photo :global(picture) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--paper-sunken);
  }

  .edu-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .edu-photo figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .prog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .prog-card {
    padding: 1.6rem 1.6rem 1.8rem;
    transition: border-color 0.2s var(--ease-out);
  }

  .prog-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .prog-card svg {
    width: 2rem;
    height: 2rem;
    color: var(--accent);
  }

  .prog-card h3 {
    margin-top: 1rem;
    font-size: 1.25rem;
  }

  .prog-card p {
    margin-top: 0.55rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1.4rem;
    position: relative;
    padding-bottom: 2.2rem;
  }

  .timeline-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    top: 2.1rem;
    bottom: 0.3rem;
    width: 0;
    border-left: 1px dotted color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .t-num {
    text-align: center;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .t-body h3 {
    font-size: 1.3rem;
  }

  .t-time {
    margin-top: 0.15rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .t-body p:last-child {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* Calculator teaser */
  .calc-teaser {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 2.5rem;
    padding: clamp(1.8rem, 4vw, 3rem);
    align-items: center;
  }

  .calc-teaser h2 {
    margin-top: 0.9rem;
    font-size: var(--step-3);
  }

  .calc-teaser p {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 52ch;
  }

  .calc-teaser .btn {
    margin-top: 1.5rem;
  }

  .calc-stats {
    display: grid;
    gap: 1.5rem;
    text-align: center;
  }

  .calc-stats .num {
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .calc-stats p:last-child {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  /* Universities */
  .uni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .uni-card {
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease-out);
  }

  .uni-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .uni-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .uni-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .uni-body {
    padding: 1.3rem 1.4rem 1.5rem;
  }

  .uni-body h3 {
    font-size: 1.25rem;
  }

  .uni-city {
    margin-top: 0.3rem;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .uni-body p:not(.uni-city) {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .uni-body .arrow-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }

  /* Form section */
  .form-split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .what-next {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .what-next li {
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .form-card {
    scroll-margin-top: 6rem;
  }

  .faq-more {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .edu-intro,
    .calc-teaser,
    .form-split {
      grid-template-columns: 1fr;
    }
    .prog-grid,
    .uni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .prog-grid,
    .uni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
