---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CtaBand from '../../../components/CtaBand.astro';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pillarMeta: Record<string, { color: string; label: string }> = {
  education: { color: 'var(--edu)', label: 'Education guides' },
  tourism: { color: 'var(--tourism)', label: 'Travel guides' },
  trade: { color: 'var(--trade)', label: 'Trade guides' },
};

const byPillar = (['education', 'tourism', 'trade'] as const).map((p) => ({
  pillar: p,
  guides: guides.filter((g) => g.data.pillar === p),
}));
---

<BaseLayout
  locale="fr"
  title="Guides — Studying, Visas, Travel & Sourcing Explained"
  description="In-depth guides for the East Asia corridor: MBBS in China, CSC scholarships, student visas, HSK preparation, China and Japan travel, and China sourcing — answer-first and regularly updated."
  path="/fr/guides"
  crumbs={[{ name: 'Guides', url: 'https://routetoabroad.com/guides' }]}
>
  <PageHero
    eyebrow="Guides"
    title="The reference shelf."
    lede="Long-form explainers written to be answers, not brochures — each one opens with the short answer, then earns it."
    crumbs={[{ name: 'Guides', url: '/guides' }]}
  />

  {byPillar.map(({ pillar, guides: group }) =>
    group.length > 0 ? (
      <section class="section" aria-label={pillarMeta[pillar]!.label}>
        <div class="container">
          <div class="guide-pillar-head" style={`--pillar: ${pillarMeta[pillar]!.color}`}>
            <p class="eyebrow" style={`color: ${pillarMeta[pillar]!.color}`}>{pillarMeta[pillar]!.label}</p>
          </div>
          <div class="guide-grid">
            {group.map((g, i) => (
              <ArticleCard
                title={g.data.title}
                href={`/fr/guides/${g.id}`}
                description={g.data.description}
                image={g.data.image}
                imageAlt={g.data.imageAlt}
                tag={g.data.pillar}
                pillar={g.data.pillar}
                meta={`${g.data.readTime} min${g.data.updatedDate ? ' · updated' : ''}`}
              />
            ))}
          </div>
        </div>
      </section>
    ) : null
  )}

  <CtaBand title="Guides answer general questions." text="Yours are specific. The fit check and the advisor desk answer those." />
</BaseLayout>

<style>
  .guide-pillar-head {
    border-left: 2px solid var(--pillar);
    padding-left: 1rem;
    margin-bottom: 1.6rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 64rem) {
    .guide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
