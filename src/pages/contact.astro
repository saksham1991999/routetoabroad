---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Contact — Talk to the New Delhi or Guangzhou Desk"
  description="Reach RouteToAbroad: education, tourism or trade enquiries answered within one working day. New Delhi office (Saket) and Guangzhou office (Tianhe), WhatsApp +91 96330 61109."
  path="/contact"
  crumbs={[{ name: 'Contact', url: 'https://routetoabroad.com/contact' }]}
>
  <PageHero
    eyebrow="Contact"
    title="Let's build your future, together."
    lede="Pick a desk, send a message, or just call. Someone accountable replies within one working day."
    crumbs={[{ name: 'Contact', url: '/contact' }]}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form card card-pad" data-reveal>
        <ContactForm />
      </div>

      <aside class="contact-side">
        <div class="c-office card card-pad" data-reveal>
          <p class="eyebrow">New Delhi · India desk</p>
          <address>
            {SITE.offices[0].street}<br />
            {SITE.offices[0].city} {SITE.offices[0].postal}
          </address>
          <a href={SITE.phoneIndiaHref} class="c-phone num">{SITE.phoneIndia}</a>
        </div>

        <div class="c-office card card-pad" data-reveal>
          <p class="eyebrow">Guangzhou · China desk</p>
          <address>
            {SITE.offices[1].street}<br />
            {SITE.offices[1].city}, China {SITE.offices[1].postal}
          </address>
          <a href={`mailto:${SITE.email}`} class="c-phone">{SITE.email}</a>
        </div>

        <div class="c-direct card card-pad" data-reveal>
          <h2>Faster than forms</h2>
          <div class="c-direct-btns">
            <a href={SITE.whatsapp} class="btn btn-primary" rel="noopener">WhatsApp an advisor</a>
            <a href={SITE.phoneIndiaHref} class="btn btn-outline">Call {SITE.phoneIndia}</a>
          </div>
          <p class="c-hours num">{SITE.hours}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .contact-side {
    display: grid;
    gap: 1.2rem;
  }

  .c-office address {
    margin-top: 0.8rem;
    font-style: normal;
    line-height: 1.6;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .c-phone {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s;
  }

  .c-phone:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .c-direct h2 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .c-direct-btns {
    margin-top: 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .c-direct-btns .btn {
    width: 100%;
  }

  .c-hours {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    text-align: center;
  }

  @media (max-width: 64rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
