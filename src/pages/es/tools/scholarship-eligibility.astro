---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
---

<BaseLayout
  locale="es"
  title="Scholarship Eligibility Check — CSC & University Awards"
  description="Check where your marks and study level actually sit for Chinese government (CSC) and university scholarships: full-award range, partial awards, or self-funded with better odds. Honest bands, no email required."
  path="/es/tools/scholarship-eligibility"
  crumbs={[
    { name: 'Tools', url: 'https://routetoabroad.com/tools' },
    { name: 'Scholarship eligibility', url: 'https://routetoabroad.com/tools/scholarship-eligibility' },
  ]}
>
  <PageHero
    eyebrow="Free tool · 2 minutes"
    title="Scholarship check. Honest bands, not flattery."
    lede="Scholarship committees don't publish cutoffs, and nobody can promise outcomes. What we can do is place your profile against the bands we've actually seen funded."
    crumbs={[
      { name: 'Tools', url: '/tools' },
      { name: 'Scholarship check', url: '/tools/scholarship-eligibility' },
    ]}
  />

  <section class="section">
    <div class="container-text">
      <div class="calc card card-pad">
        <div class="calc-form" id="sch-form">
          <div class="field">
            <label for="sch-level">Study level you're applying for</label>
            <select id="sch-level">
              <option value="">Select…</option>
              <option value="bachelor">Bachelor's</option>
              <option value="master">Master's</option>
              <option value="phd">PhD</option>
            </select>
          </div>
          <div class="field">
            <label for="sch-marks">Latest academic result</label>
            <select id="sch-marks">
              <option value="">Select…</option>
              <option value="90">90%+ / GPA 3.7+</option>
              <option value="80">80–89% / GPA 3.3+</option>
              <option value="70">70–79% / GPA 2.8+</option>
              <option value="60">Below 70% / GPA 2.8</option>
            </select>
          </div>
          <div class="field">
            <label for="sch-english">English proficiency evidence?</label>
            <select id="sch-english">
              <option value="">Select…</option>
              <option value="yes">Yes (medium-of-instruction cert / IELTS / TOEFL)</option>
              <option value="no">Not yet</option>
            </select>
          </div>
          <p class="field-error" id="sch-error" role="alert" hidden>
            Answer all three questions to see your band.
          </p>
          <button type="button" class="btn btn-primary" id="sch-go">Show my band</button>
        </div>

        <div class="calc-result" id="sch-result" hidden aria-live="polite"></div>
      </div>

      <div class="calc-note" data-reveal>
        <div class="quick-answer">
          <p class="qa-label">How these bands are built</p>
          <p>
            From placement records: full CSC awards concentrate in the 80%+ / GPA 3.3+ population, with PhD
            research profiles judged on publications and supervisor fit rather than marks alone. Provincial
            and university partial awards reach lower bands. Nobody — including us — controls committee
            decisions; we control file quality and university choice.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .calc {
    max-width: 40rem;
    margin-inline: auto;
  }

  .calc-form {
    display: grid;
    gap: 1.2rem;
  }

  .calc-form .btn {
    margin-top: 0.4rem;
    justify-self: start;
  }

  .calc-result {
    border-top: 1px solid var(--line);
    margin-top: 1.6rem;
    padding-top: 1.6rem;
  }

  .band-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }

  .band-title {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .band-body {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .band-actions {
    margin-top: 1.4rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .calc-note {
    max-width: 40rem;
    margin: 2rem auto 0;
  }

  .calc-note .quick-answer:empty {
    display: none;
  }
</style>

<script>
  const form = document.getElementById('sch-form') as HTMLElement;
  const result = document.getElementById('sch-result') as HTMLElement;
  const go = document.getElementById('sch-go') as HTMLButtonElement;
  const errorEl = document.getElementById('sch-error') as HTMLElement;
  const selects = ['sch-level', 'sch-marks', 'sch-english']
    .map((id) => document.getElementById(id) as HTMLSelectElement | null)
    .filter((el): el is HTMLSelectElement => !!el);

  selects.forEach((sel) => {
    sel.addEventListener('change', () => {
      if (sel.value) {
        sel.removeAttribute('aria-invalid');
        sel.closest('.field')?.classList.remove('invalid');
      }
      if (selects.every((s) => s.value)) errorEl.hidden = true;
    });
  });

  go?.addEventListener('click', () => {
    const level = (document.getElementById('sch-level') as HTMLSelectElement).value;
    const marks = (document.getElementById('sch-marks') as HTMLSelectElement).value;
    const english = (document.getElementById('sch-english') as HTMLSelectElement).value;

    if (!level || !marks || !english) {
      errorEl.hidden = false;
      // Clear the previous band — a validation error shouldn't sit beside a
      // result computed from answers that are no longer on the form.
      result.hidden = true;
      result.innerHTML = '';
      selects.forEach((sel) => {
        if (sel.value) return;
        sel.setAttribute('aria-invalid', 'true');
        sel.closest('.field')?.classList.add('invalid');
      });
      selects.find((sel) => !sel.value)?.focus();
      return;
    }

    errorEl.hidden = true;
    selects.forEach((sel) => {
      sel.removeAttribute('aria-invalid');
      sel.closest('.field')?.classList.remove('invalid');
    });

    let color = 'var(--warn)';
    let label = 'Competitive band';
    let title = '';
    let body = '';

    const strong = marks === '90';
    const good = marks === '80';
    const mid = marks === '70';
    const low = marks === '60';

    if (level === 'phd') {
      if (strong || good) {
        color = 'var(--ok)';
        label = 'Band 1 — Strong CSC position';
        title = 'You are in CSC PhD territory.';
        body = 'For PhD applicants, committees weigh publications, research fit and supervisor acceptance above marks alone — and your marks clear the bar. The decisive moves are emailing matched supervisors with a sharp proposal and applying Type B to 2–3 CSC-designated universities. Our desk writes these files weekly.';
      } else if (mid) {
        color = 'var(--warn)';
        label = 'Band 2 — Research-dependent';
        title = 'Marks are workable; research evidence decides.';
        body = 'PhD CSC awards at this band hinge on what sits behind the transcript: papers, projects, a supervisor who wants you. With a strong proposal and the right university, funding is realistic; without, plan tuition-only or provincial awards.';
      } else {
        color = 'var(--err)';
        label = 'Band 3 — Build the profile first';
        title = 'Funding will be difficult this cycle.';
        body = 'Honest read: PhD CSC at this marks band is a long shot unless research output is exceptional. Options: target provincial/university awards, take a funded MPhil route first, or strengthen publications for next cycle.';
      }
    } else if (level === 'master') {
      if (strong) {
        color = 'var(--ok)';
        label = 'Band 1 — Strong CSC position';
        title = 'You are in full-award range.';
        body = 'Master\'s applicants at 90%+ with English evidence sit inside the band that wins CSC full awards at strong universities — especially Type B applications to second-tier-city campuses where competition is thinner. Apply to three: one reach, one target, one high-probability.';
      } else if (good) {
        color = 'var(--ok)';
        label = 'Band 1–2 — CSC competitive';
        title = 'Full awards are in play; partials are likely.';
        body = 'This band wins CSC full awards regularly at provincial universities and partial awards (tuition-only) at top names. The study plan and recommendation letters move you up the pile — that is craftable work, and we do it with you.';
      } else if (mid) {
        color = 'var(--warn)';
        label = 'Band 2 — Partial awards territory';
        title = 'Think tuition waivers, not full rides.';
        body = 'Realistic outcome: university partial awards — tuition covered, dorm and stipend self-funded — plus provincial scholarships. Several partner universities stack partials aggressively for this band.';
      } else {
        color = 'var(--err)';
        label = 'Band 3 — Self-funded with smart picks';
        title = 'Plan self-funded; spend where it counts.';
        body = 'Scholarships will be unlikely this cycle. The good news: second-tier city engineering and business master\'s run US$2,500–4,000/year — the maths can still beat domestic options. Cut costs with city choice, not quality.';
      }
    } else {
      // bachelor
      if (strong) {
        color = 'var(--ok)';
        label = 'Band 1 — Top of the bachelor pool';
        title = 'Strong position for full and partial awards.';
        body = 'At 90%+ you compete for CSC bachelor slots (scarce but real), university presidential awards, and provincial scholarships. Bachelor CSC quota is much smaller than master\'s — pair every CSC application with 2 university-award applications.';
      } else if (good) {
        color = 'var(--warn)';
        label = 'Band 2 — Partial award range';
        title = 'University partials are your lane.';
        body = 'This band reliably wins tuition waivers and provincial partials at good universities. Full CSC at bachelor level happens, but plan fees assuming partial coverage and treat any full award as upside.';
      } else if (mid) {
        color = 'var(--warn)';
        label = 'Band 3 — Some university awards';
        title = 'Selective partials; value universities shine.';
        body = 'Expect tuition discounts at value-focused universities rather than named scholarships. Second-tier cities keep total costs workable — this is where city choice changes the math more than scholarship chasing.';
      } else {
        color = 'var(--err)';
        label = 'Band 4 — Self-funded route';
        title = 'Self-funded is the honest plan.';
        body = 'Plan on full fees and lean on low-tuition universities and low-cost cities. The degree matters more than the discount; a placed student beats an unfunded application.';
      }
    }

    if (!english.match(/yes/)) {
      body += ' <strong>Next blocker: English evidence.</strong> Get the medium-of-instruction certificate or book an IELTS/TOEFL date — files without language proof miss scholarship screens.';
    }

    result.hidden = false;
    result.innerHTML = `
      <p class="band-label" style="color: ${color}">${label}</p>
      <p class="band-title">${title}</p>
      <p class="band-body">${body}</p>
      <div class="band-actions">
        <a class="btn btn-primary" href="/es/guides/csc-scholarship">Read the CSC guide</a>
        <a class="btn btn-outline" href="/es/education#apply">Get a file review</a>
      </div>
    `;
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
