---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { uiFor } from '../../../i18n/ui';
import { EDUCATION_FAQS, TOURISM_FAQS, TRADE_FAQS } from '../../../data/faqs';
import { faqSchema } from '../../../lib/schema';

const faqs = TOURISM_FAQS;
const eyebrow = 'Tourism';
const color = 'var(--tourism)';
const title = 'Tourism FAQs — China & Japan Travel';
const description = "Questions about travelling to China and Japan: visa types, best seasons, business delegations, dietary handling, insurance and cancellations.";
---

<BaseLayout
  locale="es"
  title={title}
  description={description}
  path="/tourism/faq"
  crumbs={[{ name: eyebrow, url: 'https://routetoabroad.com/es/tourism' }, { name: 'FAQ', url: 'https://routetoabroad.com/es/tourism/faq' }]}
  jsonLd={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow={eyebrow}
    title="Frequently asked questions"
    lede={description}
    crumbs={[{ name: eyebrow, url: '/es/tourism' }, { name: 'FAQ', url: '/es/tourism/faq' }]}
  />

  <section class="section">
    <div class="container-text">
      <div class="faq-topline" style={`border-color: ${color}`}></div>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  {(() => { const pp = uiFor('es').cta.perPage["pillarFaq"]; return <CtaBand locale="es" title={pp.title} text={pp.text} />; })()}
</BaseLayout>

<style>
  .faq-topline {
    border-top: 3px solid;
    margin-bottom: 2.2rem;
  }
</style>
