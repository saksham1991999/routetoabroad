---
import { getCollection, render } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { articleSchema, faqSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);
const url = `https://routetoabroad.com/guides/${guide.id}`;
const faqs = data.faqs ?? [];

const pillarColor: Record<string, string> = {
  education: 'var(--edu)',
  tourism: 'var(--tourism)',
  trade: 'var(--trade)',
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={`/guides/${guide.id}`}
  type="article"
  crumbs={[
    { name: 'Guides', url: '/es/guides' },
    { name: data.title, url },
  ]}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  progress
  jsonLd={[
    articleSchema({
      headline: data.title,
      description: data.description,
      url,
      image: 'https://routetoabroad.com/og/default.jpg',
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      authorName: 'RouteToAbroad Desk',
      section: data.pillar,
    }),
    ...(faqs.length ? [faqSchema(faqs)] : []),
  ]}
>
  <article class="container-text guide">
    <header>
      <Breadcrumbs
        crumbs={[
          { name: 'Guides', url: '/es/guides' },
          { name: data.title, url: `/guides/${guide.id}` },
        ]}
      />
      <p class="eyebrow" style={`color: ${pillarColor[data.pillar]}`}>{data.pillar} guide</p>
      <h1>{data.title}</h1>
      <p class="guide-meta num">
        Updated {new Date(data.updatedDate ?? data.pubDate).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })}
        · {data.readTime} min read
        {data.tags.map((t) => <span class="guide-tag">{t}</span>)}
      </p>
    </header>

    <div class="guide-image">
      <Picture src={data.image} alt={data.imageAlt} widths={[768, 1280]} sizes="(max-width: 64rem) 100vw, 43rem" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </div>

    <div class="prose guide-body">
      <Content />
    </div>

    {faqs.length > 0 && (
      <section class="guide-faqs" aria-labelledby="gfaq-h">
        <h2 id="gfaq-h">Quick answers</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}

    <aside class="guide-cta card card-pad">
      <p class="eyebrow">Next step</p>
      <p>Want this guide applied to your case? The fit check takes four questions — or talk to the desk directly.</p>
      <div class="guide-cta-btns">
        <a href="/es/tools/fit-check" class="btn btn-primary btn-sm">Run the fit check</a>
        <a href="/es/contact" class="btn btn-outline btn-sm">Contact us</a>
      </div>
    </aside>
  </article>

  <CtaBand locale="es" />
</BaseLayout>

<style>
  .guide {
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
  }

  .guide-meta {
    margin-top: 1.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .guide-tag {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--accent);
  }

  .guide-image {
    margin-top: 1.8rem;
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .guide-image :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .guide-body {
    margin-top: 2.2rem;
  }

  .guide-faqs {
    margin-top: 3rem;
  }

  .guide-faqs h2 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }

  .guide-cta {
    margin-top: 2.5rem;
  }

  .guide-cta p:not(.eyebrow) {
    margin: 0.6rem 0 1.1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .guide-cta-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
