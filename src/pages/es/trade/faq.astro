---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { uiFor } from '../../../i18n/ui';
import { EDUCATION_FAQS, TOURISM_FAQS, TRADE_FAQS } from '../../../data/faqs';
import { faqSchema } from '../../../lib/schema';

const faqs = TRADE_FAQS;
const eyebrow = 'Trade';
const color = 'var(--trade)';
const title = 'Trade FAQs — Sourcing, QC & Logistics';
const description = "Insights into India\u2013China trade: MOQs, AQL quality inspections, shipping times, customs and BIS, payment terms, disputes and fees.";
---

<BaseLayout
  locale="es"
  title={title}
  description={description}
  path="/trade/faq"
  crumbs={[{ name: eyebrow, url: 'https://routetoabroad.com/es/trade' }, { name: 'FAQ', url: 'https://routetoabroad.com/es/trade/faq' }]}
  jsonLd={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow={eyebrow}
    title="Frequently asked questions"
    lede={description}
    crumbs={[{ name: eyebrow, url: '/es/trade' }, { name: 'FAQ', url: '/es/trade/faq' }]}
  />

  <section class="section">
    <div class="container-text">
      <div class="faq-topline" style={`border-color: ${color}`}></div>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  {(() => { const pp = uiFor('es').cta.perPage["pillarFaq"]; return <CtaBand locale="es" title={pp.title} text={pp.text} />; })()}
</BaseLayout>

<style>
  .faq-topline {
    border-top: 3px solid;
    margin-bottom: 2.2rem;
  }
</style>
