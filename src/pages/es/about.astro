---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { SITE, CLAIMS } from '../../lib/site';
import { AUTHORS } from '../../data/authors';
import { personSchema } from '../../lib/schema';

const minhajImg = (await import('../../assets/founders/ceo_minhaj.jpg')).default;

const founders = [
  {
    ...AUTHORS.minhaj,
    image: minhajImg,
    points: ['Sets direction and the partnerships we keep', 'Runs the trade desk', 'Fifteen years across the corridor'],
  },
];

const values = [
  {
    title: 'Relationships over transactions',
    text: 'We have taken students whose parents we later built trade relationships with, and tourists who came back as investors. The desk optimises for the decade, not the invoice.',
  },
  {
    title: 'Both sides of the bridge',
    text: 'Delhi answers to Indian families; Guangzhou answers to Chinese universities and factories. Each office can tell the other an uncomfortable truth — that is the point of having two.',
  },
  {
    title: 'No shortcuts',
    text: 'No guaranteed-admission promises, no fake scholarship letters, no document "adjustments". A false document ends an application; a false promise ends a firm. We intend to be here in twenty years.',
  },
];
---

<BaseLayout
  locale="es"
  title="About Us — The People Behind RouteToAbroad"
  description="RouteToAbroad runs from New Delhi and Guangzhou: founder-led education placement, tourism and India–China trade services. Meet the team and the standard we work to."
  path="/about"
  crumbs={[{ name: 'About', url: '/es/about' }]}
  jsonLd={founders.map((f) =>
    personSchema({
      name: f.name,
      jobTitle: f.role,
      url: f.linkedin,
      sameAs: f.linkedin ? [f.linkedin] : undefined,
      description: f.bio,
    })
  )}
>
  <PageHero
    eyebrow="About us"
    index="ABT / 07"
    title="We don't just connect countries. We connect people."
    lede="A founder-led consultancy working one corridor deeply — India and East Asia — with offices in both and something to lose in both."
    crumbs={[{ name: 'About', url: '/es/about' }]}
    facts={[
      { label: 'Offices', value: 'Delhi · Guangzhou' },
      { label: 'Practice', value: 'Edu · Travel · Trade' },
      { label: 'Team', value: 'Founder-led' },
      { label: 'Standard', value: 'No shortcuts' },
    ]}
    actions={[
      { href: '#team', label: 'Meet the team' },
      { href: '/es/contact', label: 'Talk to us', variant: 'outline' },
    ]}
    jumps={[
      { href: '#story', label: 'Story' },
      { href: '#values', label: 'Values' },
      { href: '#team', label: 'Team' },
    ]}
  />

  <section class="section" id="story">
    <div class="container story-grid">
      <div class="story" data-reveal>
        <p class="story-lead">
          RouteToAbroad began with a simple observation: the India–East Asia corridor was full of brokers,
          and short on accountable operators. Students were sold universities no one had visited. Importers
          wired deposits to factories no one had audited. Travellers saw the wall but not the country.
        </p>
        <p>
          So we built the firm we wished existed — one team that works <em>both</em> sides of the corridor
          professionally, with offices in New Delhi and Guangzhou, and staff who answer their phones on
          Saturday. Education led the way; the travel and trade desks grew out of the same network, the same
          standard, and the same families asking for one more kind of help.
        </p>
        <blockquote>
          "A student today is a trade partner tomorrow. A tourist today is an investor tomorrow."
          <cite>— Minhaj Al Shukoor, Founder & CEO</cite>
        </blockquote>
        <p>
          The corridor rewards operators who treat compliance as a product feature and honesty as a
          differentiator. That has been the job from day one — and it is why our students arrive,
          our containers clear, and our travellers come back.
        </p>
      </div>

      <aside class="nap card card-pad" data-reveal="right" aria-label="Company details">
        <p class="eyebrow">Entity details</p>
        <dl class="nap-list num">
          <div><dt>Founded</dt><dd>{SITE.founded} (in the corridor over a decade)</dd></div>
          <div><dt>Offices</dt><dd>{SITE.offices[0].city} · {SITE.offices[1].city}</dd></div>
          <div><dt>Email</dt><dd>{SITE.email}</dd></div>
          <div><dt>Phone</dt><dd>{SITE.phoneIndia}</dd></div>
          <div><dt>Hours</dt><dd>{SITE.hours}</dd></div>
          <div><dt>Students placed</dt><dd>{CLAIMS.studentsPlaced}</dd></div>
          <div><dt>Google rating</dt><dd>{CLAIMS.googleRating} ★</dd></div>
        </dl>
        <p class="nap-note">Consistent NAP details — also published in our structured data.</p>
      </aside>
    </div>
  </section>

  <section class="section section-sunken" id="values">
    <div class="container">
      <SectionHead
        eyebrow="Values"
        index="01 / 02"
        title="Three rules we don't break"
        lede="They cost us deals. They keep clients for decades."
      />
      <div class="values-grid">
        {values.map((v, i) => (
          <article class="value card card-pad" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="team">
    <div class="container">
      <SectionHead
        eyebrow="Leadership"
        index="02 / 02"
        title="The name on the door"
        lede="A small senior team on purpose. Every file has a name attached, and it's on this page."
      />
      <div class="team-grid">
        {founders.map((f, i) => (
          <article class="member card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="member-photo">
              <Picture src={f.image} alt={`Portrait of ${f.name}`} widths={[480, 800]} sizes="(max-width: 64rem) 100vw, 50vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="member-body">
              <h3>{f.name}</h3>
              <p class="member-role">{f.role}</p>
              <p class="member-bio">{f.bio}</p>
              <ul class="member-points">
                {f.points.map((pt) => <li>{pt}</li>)}
              </ul>
              {f.linkedin && (
                <a href={f.linkedin} class="arrow-link member-link" rel="noopener">LinkedIn profile</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <p class="team-note">
        Student contributors write with us too — you'll find their bylines on the
        <a href="/es/blog">insights page</a>.
      </p>
    </div>
  </section>

  {(() => { const pp = uiFor('es').cta.perPage["about"]; return <CtaBand locale="es" title={pp.title} text={pp.text} />; })()}
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .story {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .story-lead {
    font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.45;
    color: var(--ink);
  }

  .story p + p {
    margin-top: 1.2rem;
  }

  .story blockquote {
    margin: 1.8rem 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--accent);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--ink);
  }

  .story cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .nap {
    position: sticky;
    top: 6rem;
    background: var(--paper-raised);
  }

  .nap-list {
    margin: 1rem 0 0;
  }

  .nap-list div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .nap-list div:last-of-type {
    border-bottom: 0;
  }

  .nap-list dt {
    color: var(--ink-faint);
    font-weight: 500;
  }

  .nap-list dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
  }

  .nap-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
    font-family: var(--font-body);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .value h3 {
    font-size: 1.25rem;
  }

  .value p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .member {
    overflow: hidden;
    max-width: 44rem;
    margin-inline: auto;
  }

  .member-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .member-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(15%) contrast(1.05);
  }

  .member-body {
    padding: 1.5rem 1.6rem 1.7rem;
  }

  .member-body h3 {
    font-size: 1.4rem;
  }

  .member-role {
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .member-bio {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .member-points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .member-points li::before {
    content: '—';
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .member-link {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.9rem;
  }

  .team-note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .team-note a {
    color: var(--accent);
  }

  @media (max-width: 64rem) {
    .story-grid,
    .values-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
    .nap {
      position: static;
    }
  }
</style>
