---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import StatsBand from '../components/StatsBand.astro';
import { GENERAL_FAQS } from '../data/faqs';
import { faqSchema, reviewSchema } from '../lib/schema';

const campusImg = (await import('../assets/images/hero-campus-ink.jpg')).default;
const eduImg = (await import('../assets/images/hero-education.jpg')).default;
const tourismImg = (await import('../assets/images/hero-tourism.jpg')).default;
const tradeImg = (await import('../assets/images/hero-trade.jpg')).default;

const posts = (await getCollection('blog'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeFaqs = GENERAL_FAQS.slice(0, 5);

const stats = [
  { value: '500+', counter: '500', suffix: '+', label: 'Students placed' },
  { value: '12+', counter: '12', suffix: '+', label: 'Years in the corridor' },
  { value: '98%', counter: '98', suffix: '%', label: 'Visa success rate' },
  { value: '3', counter: '3', label: 'Countries served' },
];

const pillars = [
  {
    n: '01',
    key: 'Education',
    href: '/education',
    image: eduImg,
    alt: 'Students collaborating in a bright modern Chinese university laboratory',
    lead: 'Subsidised global education',
    text: 'University placement, CSC and university scholarships, MBBS and engineering tracks, visas and arrival — run end to end from application to campus registration.',
    stat: '500+ students placed',
  },
  {
    n: '02',
    key: 'Tourism',
    href: '/tourism',
    image: tourismImg,
    alt: 'A traveller looking over the Great Wall of China at golden hour',
    lead: 'Bespoke heritage journeys',
    text: 'Private and group travel through China and Japan — curated itineraries, bilingual guides, visa concierge, and a 24/7 desk while you travel.',
    stat: 'China · Japan · custom groups',
  },
  {
    n: '03',
    key: 'Trade',
    href: '/trade',
    image: tradeImg,
    alt: 'Container cranes working at the Guangzhou port at dawn',
    lead: 'Cross-border trade, handled',
    text: 'Sourcing, factory audits, AQL quality gates, customs and freight between India and China — on a success fee tied to shipped value.',
    stat: '200+ vetted suppliers',
  },
];

const illuminated = [
  {
    text: 'Match you to a programme.',
    gloss:
      'University placement, CSC scholarships, MBBS and engineering tracks, visas and arrival — run end to end.',
  },
  {
    text: 'Design the journey.',
    gloss:
      'Private and group travel through China and Japan — curated itineraries, bilingual guides, a 24/7 desk while you travel.',
  },
  {
    text: 'Move the goods.',
    gloss:
      'Sourcing, factory audits, customs and freight between India and China — on a success fee tied to shipped value.',
  },
];

const tools = [
  { n: '01', href: '/tools/fit-check', label: 'Fit check', desc: 'Four questions. A straight yes, maybe, or not this intake.' },
  { n: '02', href: '/tools/scholarship-eligibility', label: 'Scholarship check', desc: 'Where your profile actually sits for CSC and university awards.' },
  { n: '03', href: '/tools/cost-calculator', label: 'Cost calculator', desc: 'Tuition plus living costs by city, programme and lifestyle.' },
  { n: '04', href: '/tools/document-checklist', label: 'Document checklist', desc: 'Your personalised list, printable, nothing missing.' },
  { n: '05', href: '/tools/timeline-planner', label: 'Timeline planner', desc: 'Your intake date, worked backwards into a month-by-month plan.' },
];
---

<BaseLayout
  title="RouteToAbroad — Study in China, Travel East Asia, Trade Across Borders"
  description="We place students in Chinese universities, design journeys through East Asia, and run India–China trade operations. Offices in New Delhi and Guangzhou. Start with a free fit check."
  path="/"
  jsonLd={[faqSchema(homeFaqs), reviewSchema(
    // @ts-expect-error rating optional mismatch is fine here
    [{ author: 'Ananya Krishnan', reviewBody: 'RouteToAbroad didn\'t just find me a university; they found me a future.', rating: 5 }]
  )]}
>
  <!-- ============================================================
       1 · PINNED JOURNEY HERO — two 100vw slides on a flex track,
       translated by scroll progress; dashed route + paper plane
       driven from one rAF-throttled scroll handler.
       ============================================================ -->
  <section class="journey" id="journey" data-tone="light" aria-label="From anywhere to campus">
    <div class="journey-stage" id="journey-stage">
      <div class="journey-track" id="journey-track">
        <!-- Slide 1 · origin -->
        <div class="journey-slide slide-origin" id="slide-origin">
          <div class="slide-origin-inner" id="slide-origin-inner">
            <h1 class="journey-title">
              <span class="jline"><span class="jline-inner">From</span></span>
              <span class="jline"><span class="jline-inner">anywhere</span></span>
              <span class="visually-hidden"> to campus.</span>
            </h1>

            <div class="globe-wrap">
              <canvas
                id="globe-canvas"
                class="globe"
                aria-hidden="true"
                role="img"
                aria-label="Dotted globe highlighting Delhi and Guangzhou"
              ></canvas>
            </div>

            <form class="origin-form" id="origin-form">
              <label class="origin-label" for="origin-input">where do you live?</label>
              <input
                class="origin-input"
                id="origin-input"
                name="origin"
                type="text"
                maxlength="60"
                autocomplete="address-level2"
                placeholder="Delhi · Kochi · Guwahati"
              />
            </form>
          </div>
        </div>

        <!-- Journey spacer -->
        <div class="journey-spacer" id="journey-spacer" aria-hidden="true"></div>

        <!-- Slide 2 · campus -->
        <div class="journey-slide slide-campus" id="slide-campus">
          <div class="slide-campus-inner">
            <p class="display campus-echo" aria-hidden="true" data-reveal>to campus.</p>
            <div class="campus-frame" id="campus-frame">
              <Picture
                src={campusImg}
                alt="Fine ink-line drawing of a university campus with trees and walkways"
                widths={[960, 1600, 2000]}
                sizes="(max-width: 64rem) 92vw, 66vw"
                formats={['avif', 'webp']}
                loading="lazy"
                class="campus-img"
              />
            </div>
            <div class="campus-foot" id="journey-cta" data-reveal style="--reveal-delay: 160ms">
              <p class="campus-lede">
                Admissions, visas, journeys and freight between India and East Asia — run by people
                who live on both sides.
              </p>
              <div class="campus-actions">
                <a href="/tools/fit-check" class="btn btn-primary">Check if you fit</a>
                <a href="/education" class="btn btn-ghost">Explore programmes</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Route overlay: dashed Bézier + paper plane -->
      <svg class="route-svg" id="route-svg" aria-hidden="true" focusable="false">
        <path id="route-path" d="" />
      </svg>
      <span class="plane" id="plane" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path transform="rotate(-45 12 12)" d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" fill="#111"></path>
        </svg>
      </span>
    </div>
  </section>

  <!-- ============================================================
       2 · ILLUMINATED STATEMENT — words light up word-by-word
       ============================================================ -->
  <section class="illum" id="illum" data-tone="light" aria-label="What we do">
    <div class="illum-pin">
      <div class="illum-inner">
        <p class="eyebrow">This is what we do</p>
        <div class="illum-lines">
          {illuminated.map((line) => (
            <div class="illum-row">
              <p class="display illum-line">
                {line.text.split(' ').map((w, i) => (
                  <span data-word style={`--wd: ${i * 110}ms`}>{w}{' '}</span>
                ))}
              </p>
              <p class="illum-gloss">{line.gloss}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 · PILLARS — numbered ruled rows
       ============================================================ -->
  <section class="section pillars" data-tone="light" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHead
        eyebrow="What we do"
        title="<span id='pillars-title'>Three ways across one corridor.</span>"
        lede="Three capabilities, one corridor, run by people who live on both sides of it. Pick the door — they all open."
      />
      <div class="pillar-rows">
        {pillars.map((p, i) => (
          <a href={p.href} class="pillar-row" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="pillar-id">
              <span class="pillar-n num">{p.n}</span>
              <h3 class="pillar-name">{p.key}</h3>
            </div>
            <div class="pillar-desc">
              <p class="pillar-lead">{p.lead}</p>
              <p class="pillar-text">{p.text}</p>
              <p class="pillar-stat num">{p.stat}</p>
            </div>
            <div class="pillar-media">
              <Picture
                src={p.image}
                alt={p.alt}
                widths={[480, 800]}
                sizes="(max-width: 64rem) 100vw, 30vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
            <span class="pillar-go arrow-link">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · PROOF STRIP -->
  <Marquee />

  <!-- 5 · STATS — black instrument band -->
  <div data-tone="dark">
    <StatsBand stats={stats} />
  </div>

  <!-- ============================================================
       6 · TOOLS — numbered ruled rows
       ============================================================ -->
  <section class="section tools" data-tone="light" aria-labelledby="tools-title">
    <div class="container">
      <SectionHead
        eyebrow="Free tools"
        title="<span id='tools-title'>Start with facts, not brochures.</span>"
        lede="Five quick tools that give you real numbers before you ever talk to us. No email required."
      />
      <div class="tool-rows">
        {tools.map((t, i) => (
          <a href={t.href} class="tool-row" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="tool-n num">{t.n}</span>
            <span class="tool-body">
              <h3 class="tool-name">{t.label}</h3>
              <span class="tool-desc">{t.desc}</span>
            </span>
            <span class="tool-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       7 · INSIGHTS — featured posts as ruled rows
       ============================================================ -->
  <section class="section insights" data-tone="light" aria-labelledby="insights-title">
    <div class="container">
      <div class="insights-head">
        <SectionHead
          eyebrow="Latest insights"
          title="<span id='insights-title'>From the desk.</span>"
          lede="Field notes on studying, travelling and trading across the corridor."
        />
        <a href="/blog" class="arrow-link insights-all">All articles</a>
      </div>
      <div class="post-rows">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class="post-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div class="post-body">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <p class="post-meta">
                {post.data.pubDate.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}
                {' '}· {post.data.category} · {post.data.readTime} min read
              </p>
            </div>
            <div class="post-thumb">
              <Picture
                src={post.data.image}
                alt={post.data.imageAlt}
                widths={[320, 480]}
                sizes="(max-width: 64rem) 28vw, 176px"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · TESTIMONIALS -->
  <div data-tone="light">
    <TestimonialCarousel />
  </div>

  <!-- ============================================================
       9 · FAQ
       ============================================================ -->
  <section class="section faq" data-tone="light" aria-labelledby="faq-title">
    <div class="container-text">
      <SectionHead
        center
        eyebrow="Common questions"
        title="<span id='faq-title'>The honest answers.</span>"
        lede="The ones we hear most, kept short. The rest live in the FAQ."
      />
      <FaqAccordion faqs={homeFaqs} />
      <p class="faq-more">
        <a href="/faq" class="arrow-link">All frequently asked questions</a>
      </p>
    </div>
  </section>

  <!-- 10 · CLOSE -->
  <div data-tone="dark">
    <CtaBand />
  </div>
</BaseLayout>

<style>
  /* ============================================================
     1 · PINNED JOURNEY HERO
     ============================================================ */
  .journey {
    position: relative;
    height: 300vh;
    background: #f7f7f7;
  }

  .journey-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .journey-track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
  }

  .journey-slide {
    position: relative;
    flex: 0 0 100vw;
    height: 100%;
  }

  .journey-spacer {
    flex: 0 0 18vw;
  }

  /* --- Slide 1 · origin --- */
  .slide-origin {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-origin-inner {
    width: min(34rem, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 1.5rem 6.5rem;
  }

  .journey-title {
    display: block;
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: #111;
  }

  .jline {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .jline-inner {
    display: block;
    transition:
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .jline:nth-of-type(2) .jline-inner {
    transition-delay: 0.1s;
  }

  /* Hidden only while Agent F's loader is set to play (html[data-loader]),
     until it dispatches 'rta:loaded' and we add .hero-in (or the 2.5s fallback). */
  :global(html[data-loader]) .journey:not(.hero-in) .jline-inner {
    transform: translateY(130%);
    opacity: 0;
  }

  .globe-wrap,
  .origin-form {
    opacity: 1;
    transition: opacity 0.9s ease 0.45s;
  }

  :global(html[data-loader]) .journey:not(.hero-in) .globe-wrap,
  :global(html[data-loader]) .journey:not(.hero-in) .origin-form {
    opacity: 0;
  }

  .globe-wrap {
    margin-top: clamp(1.4rem, 3.5dvh, 2.4rem);
  }

  .globe {
    display: block;
    width: min(34vh, 260px);
    width: min(34dvh, 260px);
    height: min(34vh, 260px);
    height: min(34dvh, 260px);
    cursor: grab;
    touch-action: pan-y;
  }

  .globe:active {
    cursor: grabbing;
  }

  .origin-form {
    margin-top: clamp(1.6rem, 4dvh, 2.6rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .origin-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: rgba(17, 17, 17, 0.62);
  }

  .origin-input {
    margin-top: 0.8rem;
    width: min(18rem, 100%);
    padding: 0.45rem 0.25rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 0;
    font-size: 15px;
    text-align: center;
    color: #111;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .origin-input:focus {
    border-bottom-color: #111;
  }

  .origin-input::placeholder {
    color: rgba(0, 0, 0, 0.3);
  }

  /* --- Slide 2 · campus --- */
  .slide-campus {
    display: flex;
  }

  .slide-campus-inner {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(5rem, 10dvh, 7rem) clamp(1.25rem, 5vw, 4rem) clamp(6rem, 12dvh, 8rem);
  }

  .campus-echo {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.9;
    color: #111;
  }

  .campus-frame {
    margin-top: clamp(1.2rem, 3dvh, 2.2rem);
    width: min(72vw, 62rem);
    aspect-ratio: 21 / 9;
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 0.6rem;
  }

  .campus-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .campus-foot {
    margin-top: auto;
    padding-top: clamp(1.4rem, 3dvh, 2.4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .campus-lede {
    margin: 0;
    max-width: 44ch;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(17, 17, 17, 0.6);
  }

  .campus-actions {
    margin-top: 1.4rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* --- Route overlay + plane --- */
  .route-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
  }

  .route-svg path {
    fill: none;
    stroke: #111;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
  }

  .plane {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    width: 24px;
    height: 24px;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }

  .plane svg {
    display: block;
  }

  /* --- Mobile --- */
  @media (max-width: 64rem) {
    .globe {
      width: min(32vh, 180px);
      width: min(32dvh, 180px);
      height: min(32vh, 180px);
      height: min(32dvh, 180px);
    }

    .slide-origin-inner {
      padding: 5.5rem 1.25rem 6rem;
    }

    .campus-frame {
      width: min(86vw, 62rem);
    }
  }

  /* --- Reduced motion: static stacked narrative, no pin/plane/route --- */
  @media (prefers-reduced-motion: reduce) {
    .journey {
      height: auto;
    }

    .journey-stage {
      position: static;
      height: auto;
      overflow: visible;
    }

    .journey-track {
      display: block;
      width: auto;
      transform: none !important;
    }

    .journey-slide {
      flex: initial;
      width: 100%;
    }

    .journey-spacer,
    .route-svg,
    .plane {
      display: none;
    }

    .slide-origin {
      min-height: 88vh;
    }

    .slide-origin-inner {
      padding-block: 5rem 3rem;
    }

    .slide-campus-inner {
      padding-top: 3rem;
    }

    .jline-inner {
      transition: none;
      transform: none !important;
      opacity: 1 !important;
    }

    .globe-wrap,
    .origin-form {
      opacity: 1 !important;
    }

    .globe {
      cursor: default;
    }
  }

  /* --- No-JS fallback: same static stacked narrative --- */
  :global(html.no-js) .journey {
    height: auto;
  }

  :global(html.no-js) .journey-stage {
    position: static;
    height: auto;
    overflow: visible;
  }

  :global(html.no-js) .journey-track {
    display: block;
    width: auto;
  }

  :global(html.no-js) .journey-slide {
    flex: initial;
    width: 100%;
  }

  :global(html.no-js) .journey-spacer,
  :global(html.no-js) .route-svg,
  :global(html.no-js) .plane {
    display: none;
  }

  :global(html.no-js) .slide-origin {
    min-height: 88vh;
  }

  :global(html.no-js) .jline-inner {
    transform: none;
    opacity: 1;
  }

  /* ============================================================
     2 · ILLUMINATED STATEMENT
     ============================================================ */
  .illum {
    position: relative;
    min-height: 160vh;
    background: #f7f7f7;
  }

  /* The illum section is an always-light island — pin the global eyebrow to it */
  .illum .eyebrow {
    color: #4a63d8;
  }

  .illum-pin {
    position: sticky;
    top: 0;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  .illum-inner {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 6rem clamp(1.25rem, 5vw, 3rem) 5rem;
  }

  .illum-row + .illum-row {
    margin-top: clamp(2.2rem, 6dvh, 3.8rem);
  }

  .illum-line {
    margin: 0;
    font-size: clamp(2rem, 5.6vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .illum-line [data-word] {
    color: rgba(94, 120, 238, 0.22);
    transition: color 0.3s ease;
  }

  .illum-row.lit .illum-line [data-word] {
    color: #5e78ee;
  }

  .illum-gloss {
    margin: 0.7rem 0 0;
    max-width: 40ch;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(17, 17, 17, 0.6);
    opacity: 1;
    transition: opacity 0.7s ease 0.1s;
  }

  /* With JS active, glosses wait for their line to light up */
  :global(html:not(.no-js)) .illum-gloss {
    opacity: 0;
  }

  .illum-row.lit .illum-gloss {
    opacity: 1;
  }

  /* No-JS: everything lit and readable */
  :global(html.no-js) .illum-line [data-word] {
    color: #5e78ee !important;
  }

  :global(html.no-js) .illum-gloss {
    opacity: 1 !important;
  }

  /* Mobile: no pin — IO adds .lit per row, words stagger via --wd */
  @media (max-width: 64rem) {
    .illum {
      min-height: 0;
    }

    .illum-pin {
      position: static;
      min-height: 0;
      padding-block: 1rem 2rem;
    }

    .illum-line [data-word] {
      transition-delay: var(--wd, 0ms);
    }

    .illum-gloss {
      transition-delay: 0.45s;
    }
  }

  /* Reduced motion: everything lit, no pin */
  @media (prefers-reduced-motion: reduce) {
    .illum {
      min-height: 0;
    }

    .illum-pin {
      position: static;
      min-height: 0;
      padding-block: 1rem 2rem;
    }

    .illum-line [data-word] {
      color: #5e78ee !important;
      transition: none;
    }

    .illum-gloss {
      opacity: 1 !important;
    }
  }

  /* ============================================================
     3 · PILLARS — numbered ruled rows
     ============================================================ */
  .pillar-rows {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pillar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 0.9fr) auto;
    grid-template-areas: 'id desc media go';
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding-block: clamp(1.8rem, 3.5vw, 2.6rem);
