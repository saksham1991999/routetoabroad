</style>

<script>
  // ==================================================================
  // RouteToAbroad home — scroll narrative (vanilla TS, no libraries)
  //   1. Loader handoff (waits for Agent F's 'rta:loaded')
  //   2. Dotted globe (canvas, drag-to-spin, DPR-capped)
  //   3. Journey scroll driver (track, route Bézier, paper plane)
  //   4. Origin form → eased 2.8s flight through the journey
  //   5. Illuminated statement (word-by-word lighting)
  // ==================================================================

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeInOutQuart = (t: number) =>
    t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;

  /* ---------------- 1 · Loader handoff ----------------
     Starts hidden ONLY when Agent F's loader will play (html[data-loader]).
     Rises on 'rta:loaded', or after a 2.5s fallback timeout.
     No loader attr (repeat visit / RM) → CSS keeps everything visible. */
  (function initLoaderHandoff() {
    const journey = document.getElementById('journey');
    if (!journey || reduced) return;
    if (!document.documentElement.hasAttribute('data-loader')) return;
    let done = false;
    const rise = () => {
      if (done) return;
      done = true;
      journey.classList.add('hero-in');
    };
    window.addEventListener('rta:loaded', rise, { once: true });
    setTimeout(rise, 2500);
  })();

  /* ---------------- 2 · Dotted globe ---------------- */
  function initGlobe() {
    const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const INK = 'rgba(17,17,17,0.55)';
    const INK_FAINT = 'rgba(17,17,17,0.20)';
    const LABEL = 'rgba(17,17,17,0.72)';
    const SIGNAL = '#5e78ee';
    const STEP = 7.5; // degrees
    const TILT = -0.34; // radians, axial tilt for depth
    const BASE_SPIN = (0.2 * Math.PI) / 180; // ~0.2°/frame

    // Precompute the graticule grid — every (lat, lon) dot sits on both a
    // latitude line and a longitude line (step ~7.5°).
    const cosLat: number[] = [];
    const sinLat: number[] = [];
    const cosLon: number[] = [];
    const sinLon: number[] = [];
    for (let lat = -90; lat <= 90.001; lat += STEP) {
      const la = (lat * Math.PI) / 180;
      for (let lon = 0; lon < 360; lon += STEP) {
        const lo = (lon * Math.PI) / 180;
        cosLat.push(Math.cos(la));
        sinLat.push(Math.sin(la));
        cosLon.push(Math.cos(lo));
        sinLon.push(Math.sin(lo));
      }
    }
    const N = cosLat.length;

    const markers = [
      { name: 'Delhi', lat: 28.61, lon: 77.21 },
      { name: 'Guangzhou', lat: 23.13, lon: 113.26 },
    ].map((m) => {
      const la = (m.lat * Math.PI) / 180;
      const lo = (m.lon * Math.PI) / 180;
      return {
        name: m.name,
        cl: Math.cos(la),
        sl: Math.sin(la),
        co: Math.cos(lo),
        so: Math.sin(lo),
      };
    });

    let rot = (-95 * Math.PI) / 180; // India & East Asia face the viewer on load
    let spin = BASE_SPIN;
    let W = 0;
    let H = 0;
    let R = 0;
    let DPR = 1;
    let dragging = false;
    let lastX = 0;
    let dragVel = 0;

    function size() {
      const rect = canvas!.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      DPR = Math.min(devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      canvas!.width = Math.round(W * DPR);
      canvas!.height = Math.round(H * DPR);
      R = Math.min(W, H) / 2 - 6;
    }

    function draw() {
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx!.clearRect(0, 0, W, H);
      const cR = Math.cos(rot);
      const sR = Math.sin(rot);
      const cT = Math.cos(TILT);
      const sT = Math.sin(TILT);
      const cx = W / 2;
      const cy = H / 2;
      const TAU = Math.PI * 2;

      // Two passes: faint near-limb dots, then full-strength front dots.
      for (let pass = 0; pass < 2; pass++) {
        ctx!.beginPath();
        for (let i = 0; i < N; i++) {
          const x = cosLat[i] * cosLon[i];
          const y = sinLat[i];
          const z = cosLat[i] * sinLon[i];
          const x1 = x * cR + z * sR; // spin about Y
          const z1 = z * cR - x * sR;
          const y2 = y * cT - z1 * sT; // tilt about X
          const z2 = y * sT + z1 * cT;
          if (z2 <= 0) continue; // back hemisphere
          if ((pass === 0 && z2 > 0.3) || (pass === 1 && z2 <= 0.3)) continue;
          const sx = cx + R * x1;
          const sy = cy - R * y2;
          ctx!.moveTo(sx + 0.7, sy);
          ctx!.arc(sx, sy, 0.7, 0, TAU); // ~1.4px dot
        }
        ctx!.fillStyle = pass === 0 ? INK_FAINT : INK;
        ctx!.fill();
      }

      // Signal markers + tiny labels
      ctx!.font = '10px Helvetica, Arial, sans-serif';
      ctx!.textBaseline = 'middle';
      for (const m of markers) {
        const x = m.cl * m.co;
        const y = m.sl;
        const z = m.cl * m.so;
        const x1 = x * cR + z * sR;
        const z1 = z * cR - x * sR;
        const y2 = y * cT - z1 * sT;
        const z2 = y * sT + z1 * cT;
        if (z2 <= 0.08) continue;
        const sx = cx + R * x1;
        const sy = cy - R * y2;
        ctx!.globalAlpha = Math.min(1, (z2 - 0.08) / 0.35);
        ctx!.fillStyle = SIGNAL;
        ctx!.beginPath();
        ctx!.arc(sx, sy, 2.6, 0, TAU);
        ctx!.fill();
        ctx!.fillStyle = LABEL;
        ctx!.fillText(m.name, sx + 6, sy + 0.5);
        ctx!.globalAlpha = 1;
      }
    }

    function tick() {
      requestAnimationFrame(tick);
      if (document.hidden) return; // pause work when tab hidden
      if (!dragging) {
        rot += spin;
        spin += (BASE_SPIN - spin) * 0.02; // inertia decays back to base spin
      }
      draw();
    }

    size();
    const ro = new ResizeObserver(() => {
      size();
      if (reduced) draw();
    });
    ro.observe(canvas);

    if (reduced) {
      draw(); // static globe, no spin, no drag
      return;
    }

    // Drag to spin, with inertia on release.
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      dragVel = 0;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      rot += dx * 0.005;
      dragVel = dx * 0.005;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      spin = Math.max(-0.09, Math.min(0.09, dragVel));
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    requestAnimationFrame(tick);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) draw();
    });
  }

  /* ---------------- 3 · Journey scroll driver ----------------
     ONE rAF-throttled scroll handler drives everything:
       p 0→0.15  slide-1 holds
       p 0.15→0.3 slide-1 fades, route + plane appear
       p 0.3→0.85 track translates -(slide1+spacer), plane flies the Bézier
       p 0.85→1  plane fades, slide-2 rises (its own [data-reveal])       */
  function initJourney() {
    if (reduced) return; // RM: static stacked layout, no driver at all
    const journey = document.getElementById('journey');
    const stage = document.getElementById('journey-stage');
    const track = document.getElementById('journey-track');
    const slideOrigin = document.getElementById('slide-origin');
    const originInner = document.getElementById('slide-origin-inner');
    const slideCampus = document.getElementById('slide-campus');
    const campusFrame = document.getElementById('campus-frame');
    const spacer = document.getElementById('journey-spacer');
    const globeCanvas = document.getElementById('globe-canvas');
    const routeSvg = document.getElementById('route-svg');
    const routePath = document.getElementById('route-path') as SVGPathElement | null;
    const plane = document.getElementById('plane');
    if (
      !journey || !stage || !track || !slideOrigin || !originInner || !slideCampus ||
      !campusFrame || !spacer || !globeCanvas || !routeSvg || !routePath || !plane
    ) {
      return;
    }

    let stageH = 0;
    let shiftTotal = 0;
    let globe = { x: 0, y: 0, r: 0 };
    let target = { x: 0, y: 0 };
    let ticking = false;

    // Cached on resize only — stage-local coordinates, independent of scroll.
    function measure() {
      stageH = stage!.offsetHeight;
      shiftTotal = slideOrigin!.offsetWidth + spacer!.offsetWidth;
      const sRect = stage!.getBoundingClientRect();
      const oRect = slideOrigin!.getBoundingClientRect();
      const cRect = slideCampus!.getBoundingClientRect();
      const gRect = globeCanvas!.getBoundingClientRect();
      const fRect = campusFrame!.getBoundingClientRect();
      globe = {
        x: gRect.left - oRect.left + gRect.width / 2,
        y: gRect.top - oRect.top + gRect.height / 2,
        r: gRect.width / 2,
      };
      target = {
        x: slideCampus!.offsetLeft + (fRect.left - cRect.left) + fRect.width * 0.5,
        y: fRect.top - cRect.top,
      };
    }

    function render() {
      ticking = false;
      const rect = journey!.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < -80 || rect.top > vh + 80) return; // offscreen — skip work

      const span = Math.max(journey!.offsetHeight - vh, 1);
      const p = clamp01(-rect.top / span);

      // Slide-1 fade & route appear
      const fade = 1 - clamp01((p - 0.15) / 0.15);
      originInner!.style.opacity = fade.toFixed(3);
      originInner!.style.visibility = fade <= 0.01 ? 'hidden' : 'visible';
      routeSvg!.style.opacity = clamp01((p - 0.15) / 0.15).toFixed(3);

      // Track translation, eased, across p 0.3 → 0.85
      const fp = clamp01((p - 0.3) / 0.55);
      const eased = easeInOutCubic(fp);
      const shift = shiftTotal * eased;
      track!.style.transform = `translate3d(${(-shift).toFixed(1)}px, 0, 0)`;

      // Quadratic Bézier: globe right edge (slide 1) → campus frame (slide 2)
      const p0x = globe.x - shift + globe.r * 0.82;
      const p0y = globe.y - globe.r * 0.38;
      const p1x = target.x - shift;
      const p1y = target.y;
      const pcx = (p0x + p1x) / 2;
      const pcy = Math.min(p0y, p1y) - stageH * 0.3;
      routePath!.setAttribute(
        'd',
        `M ${p0x.toFixed(1)} ${p0y.toFixed(1)} Q ${pcx.toFixed(1)} ${pcy.toFixed(1)} ${p1x.toFixed(1)} ${p1y.toFixed(1)}`
      );

      // Plane: position P(t), rotation = tangent + 45° (glyph nose is pre-rotated -45°),
      // scale 0.85 → 1.45 → 1 on a sin curve.
      const planeOpacity = Math.min(clamp01((p - 0.15) / 0.15), 1 - clamp01((p - 0.85) / 0.15));
      plane!.style.opacity = planeOpacity.toFixed(3);
      if (planeOpacity > 0.001) {
        // t follows the SAME eased value as the track, so the plane lands
        // exactly on the campus frame when the translation completes.
        const t = eased;
        const px = (1 - t) * (1 - t) * p0x + 2 * (1 - t) * t * pcx + t * t * p1x;
        const py = (1 - t) * (1 - t) * p0y + 2 * (1 - t) * t * pcy + t * t * p1y;
        const dx = 2 * (1 - t) * (pcx - p0x) + 2 * t * (p1x - pcx);
        const dy = 2 * (1 - t) * (pcy - p0y) + 2 * t * (p1y - pcy);
        const ang = (Math.atan2(dy, dx) * 180) / Math.PI;
        const sc = 0.85 + 0.6 * Math.sin(Math.PI * t);
        plane!.style.transform = `translate(${(px - 12).toFixed(1)}px, ${(py - 12).toFixed(1)}px) rotate(${(ang + 45).toFixed(1)}deg) scale(${sc.toFixed(3)})`;
      }
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    measure();
    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      render();
    });
    window.addEventListener('load', () => {
      measure();
      render();
    });
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        measure();
        render();
      }).observe(stage!);
    }
  }

  /* ---------------- 4 · Origin form → the flight ----------------
     On submit, scroll the window through the whole 300vh journey over
     ~2.8s with easeInOutQuart — the plane flies their answer.
     User wheel/touch input cancels the flight. Reduced motion: jump. */
  function initOriginForm() {
    const form = document.getElementById('origin-form') as HTMLFormElement | null;
    const journey = document.getElementById('journey');
    const cta = document.getElementById('journey-cta');
    if (!form || !journey || !cta) return;

    let rafId = 0;
    let flying = false;
    const cancelFlight = () => {
      flying = false;
      cancelAnimationFrame(rafId);
    };
    window.addEventListener('wheel', cancelFlight, { passive: true });
    window.addEventListener('touchstart', cancelFlight, { passive: true });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (reduced) {
        cta.scrollIntoView({ block: 'center' }); // instant under RM
        return;
      }
      const rect = journey!.getBoundingClientRect();
      const targetY = rect.top + window.scrollY + journey!.offsetHeight - window.innerHeight;
      const startY = window.scrollY;
      if (targetY - startY < 4) return; // already flown
      cancelFlight();
      flying = true;
      const t0 = performance.now();
      const DURATION = 2800;
      const step = (now: number) => {
        if (!flying) return;
        const t = Math.min((now - t0) / DURATION, 1);
        window.scrollTo(0, startY + (targetY - startY) * easeInOutQuart(t));
        if (t < 1) rafId = requestAnimationFrame(step);
        else flying = false;
      };
      rafId = requestAnimationFrame(step);
    });
  }

  /* ---------------- 5 · Illuminated statement ----------------
     Desktop: pinned (CSS) + scroll progress lights words sequentially.
     Mobile: no pin — IntersectionObserver adds .lit per row, words
     stagger via --wd transition-delay. Reduced motion: CSS forces lit. */
  function initIlluminated() {
    const section = document.getElementById('illum');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#illum .illum-row'));
    if (!section || !rows.length) return;
    const words = Array.from(section.querySelectorAll<HTMLElement>('[data-word]'));
    if (!words.length) return;

    if (reduced) return; // CSS keeps everything lit

    const pinned = matchMedia('(min-width: 64rem)').matches;

    if (!pinned) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            entry.target.classList.add('lit');
          }
        },
        { threshold: 0.35 }
      );
      rows.forEach((row) => io.observe(row));
      return;
    }

    const counts = rows.map((row) => row.querySelectorAll('[data-word]').length);
    const total = words.length;
    const DIM = 'rgba(94, 120, 238, 0.22)';
    const LIT = '#5e78ee';
    let ticking = false;

    function render() {
      ticking = false;
      const rect = section!.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;

      const span = Math.max(section!.offsetHeight - vh, 1);
      const p = clamp01(-rect.top / span);
      const lit = Math.round(total * clamp01((p - 0.1) / 0.72));

      let seen = 0;
      rows.forEach((row, ri) => {
        const rowLit = Math.max(0, Math.min(counts[ri], lit - seen));
        const ws = row.querySelectorAll<HTMLElement>('[data-word]');
        ws.forEach((w, wi) => {
          w.style.color = wi < rowLit ? LIT : DIM;
        });
        if (rowLit >= counts[ri]) row.classList.add('lit');
        seen += counts[ri];
      });
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    render();
  }

  initGlobe();
  initJourney();
  initOriginForm();
  initIlluminated();
</script>
