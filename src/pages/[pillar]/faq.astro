---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { EDUCATION_FAQS, TOURISM_FAQS, TRADE_FAQS } from '../../data/faqs';
import { faqSchema } from '../../lib/schema';

export function getStaticPaths() {
  return [
    {
      params: { pillar: 'education' },
      props: {
        faqs: EDUCATION_FAQS,
        title: 'Education FAQs — Studying in China',
        description:
          'Common questions about studying in China: MBBS recognition, CSC scholarships, HSK requirements, visa timelines, costs and student life.',
        eyebrow: 'Education',
        color: 'var(--edu)',
      },
    },
    {
      params: { pillar: 'tourism' },
      props: {
        faqs: TOURISM_FAQS,
        title: 'Tourism FAQs — China & Japan Travel',
        description:
          'Questions about travelling to China and Japan: visa types, best seasons, business delegations, dietary handling, insurance and cancellations.',
        eyebrow: 'Tourism',
        color: 'var(--tourism)',
      },
    },
    {
      params: { pillar: 'trade' },
      props: {
        faqs: TRADE_FAQS,
        title: 'Trade FAQs — Sourcing, QC & Logistics',
        description:
          'Insights into India–China trade: MOQs, AQL quality inspections, shipping times, customs and BIS, payment terms, disputes and fees.',
        eyebrow: 'Trade',
        color: 'var(--trade)',
      },
    },
  ];
}

const { faqs, title, description, eyebrow, color } = Astro.props;
const ctaPerPage = uiFor('en').cta.perPage['pillarFaq'];
---

<BaseLayout
  title={title}
  description={description}
  path={`/${eyebrow.toString().toLowerCase()}/faq`}
  crumbs={[
    { name: eyebrow, url: `https://routetoabroad.com/${eyebrow.toString().toLowerCase()}` },
    { name: 'FAQ', url: `https://routetoabroad.com/${eyebrow.toString().toLowerCase()}/faq` },
  ]}
  jsonLd={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow={eyebrow}
    title="Frequently asked questions"
    lede={description}
    crumbs={[
      { name: eyebrow, url: `/${eyebrow.toString().toLowerCase()}` },
      { name: 'FAQ', url: `/${eyebrow.toString().toLowerCase()}/faq` },
    ]}
  />

  <section class="section">
    <div class="container-text">
      <div class="faq-topline" style={`border-color: ${color}`}></div>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <CtaBand title={ctaPerPage.title} text={ctaPerPage.text} />
</BaseLayout>

<style>
  .faq-topline {
    border-top: 3px solid;
    margin-bottom: 2.2rem;
  }
</style>
