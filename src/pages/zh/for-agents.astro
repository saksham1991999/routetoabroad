---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { SITE } from '../../lib/site';
---

<BaseLayout
  locale="zh"
  title="For Agents — Your China Desk, White-Labelled"
  description="Already counselling students in the GCC, Africa or India? RouteToAbroad is the China desk behind you: co-branded pages, transparent file status, honest scholarship communication."
  path="/zh/for-agents"
  crumbs={[{ name: 'For Agents', url: '/zh/for-agents'}]}
>
  <PageHero
    eyebrow="For agents"
    title="Keep your students. We run China."
    lede="If you already counsel in the GCC, Africa, India or another region, RouteToAbroad is the China desk behind your desk — co-branded, transparent, and honest about what we can and cannot do."
    crumbs={[{ name: 'For Agents', url: '/zh/for-agents'}]}
  />

  <section class="section">
    <div class="container agent-grid">
      <section class="agent-col" data-reveal>
        <h2>What you get</h2>
        <ul class="agent-list">
          <li>
            <strong>Co-branded materials</strong>
            <p>Pages and offer documents that carry your name and number — your client stays your client.</p>
          </li>
          <li>
            <strong>File status you can repeat</strong>
            <p>Application, JW202 and visa milestones visible to you without chasing us across time zones.</p>
          </li>
          <li>
            <strong>Scholarship honesty</strong>
            <p>We tell your student what is real before you have to. No invented awards for you to defend later.</p>
          </li>
          <li>
            <strong>On-ground arrival support</strong>
            <p>Airport, dorm, residence permit, SIM, bank — handled by our China team, reflected in your service.</p>
          </li>
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>What you send</h2>
        <ul class="agent-list agent-list--simple">
          <li>Student profile: qualification, marks, field, target intake</li>
          <li>Scanned passport and transcripts when ready</li>
          <li>Budget ceiling and scholarship expectations, stated plainly</li>
          <li>One signed co-operation note — no exclusivity traps</li>
        </ul>

        <h2 class="agent-h2">What you don't need to do</h2>
        <ul class="agent-list agent-list--simple agent-list--no">
          <li>Learn every provincial rule or JW202 timeline</li>
          <li>Promise universities you cannot name</li>
          <li>File a student we have not shortlisted</li>
          <li>Explain a scholarship result you did not create</li>
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>What we will not do</h2>
        <ul class="agent-list agent-list--no">
          <li>Hide a language requirement to close a file</li>
          <li>Invent a scholarship result</li>
          <li>Run tourism or trade on the side of your offer letter</li>
          <li>Market to your students behind your back</li>
        </ul>
        <div class="agent-note card card-pad">
          <p class="eyebrow">Who this is for</p>
          <p>
            Counsellors and study-abroad offices with students who want China — especially in the GCC and
            Africa, where our partner network is active and growing. An India desk is being built now.
          </p>
        </div>
      </section>
    </div>

    <div class="container agent-cta-wrap">
      <div class="agent-cta card card-pad" data-reveal>
        <div>
          <h2>Apply to partner</h2>
          <p>
            Send your office name, region and rough annual student volume. We reply with a partnership note
            and a working session — usually within two working days.
          </p>
        </div>
        <div class="agent-cta-btns">
          <a href={`mailto:${SITE.email}?subject=Agent%20partnership`} class="btn btn-primary">Email the partnerships desk</a>
          <a href={SITE.whatsapp} class="btn btn-outline" rel="noopener">WhatsApp {SITE.phoneIndia}</a>
        </div>
      </div>
      <p class="portal-note num">Agent portal: coming soon</p>
    </div>
  </section>

  {(() => { const pp = uiFor('zh').cta.perPage["forAgents"]; return <CtaBand locale="zh" title={pp.title} text={pp.text} />; })()}
</BaseLayout>

<style>
  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .agent-col h2 {
    font-size: var(--step-2);
    margin-bottom: 1.2rem;
  }

  .agent-h2 {
    margin-top: 2.2rem;
  }

  .agent-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .agent-list li {
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
  }

  .agent-list li strong {
    display: block;
    font-size: 1rem;
    font-weight: 500;
  }

  .agent-list li p {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-list--simple li {
    padding: 0.8rem 0 0.8rem 1.3rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    position: relative;
  }

  .agent-list--simple li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .agent-list--no li::before {
    content: '✕';
    color: var(--err);
  }

  .agent-note {
    margin-top: 1.8rem;
  }

  .agent-note p:not(.eyebrow) {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .agent-cta {
    max-width: 46rem;
    margin-inline: auto;
  }

  .agent-cta p {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-btns {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .portal-note {
    margin-top: 1.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 64rem) {
    .agent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
