---
import { SITE } from '../lib/site';
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema } from '../lib/schema';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /**
   * Absolute path beginning with /, e.g. /education. Must be the *canonical
   * English URL* (unprefixed). For a localized page under /zh/education,
   * pass path="/education" and locale="zh"; the canonical and hreflang links
   * are computed from those.
   */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: { name: string; url: string }[];
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object[];
  /** Page locale. When omitted, defaults to 'en' (the root, unprefixed tree). */
  locale?: Locale;
}

const {
  title,
  description,
  path,
  image = '/og/default.jpg',
  type = 'website',
  noindex = false,
  crumbs,
  publishedTime,
  modifiedTime,
  jsonLd = [],
  locale = DEFAULT_LOCALE,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
// i18n: when this page is a localized copy (locale prop is set), the
// canonical points at the localized URL, not the English one. The English
// version stays reachable via the hreflang links emitted below.
const canonicalHref =
  locale !== DEFAULT_LOCALE
    ? new URL(path.replace(/^\/+(zh|fr|ar|es)(?=\/|$)/, ''), SITE.url).href.replace(
        /$/,
        '/'
      )
      : canonical;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = path === '/' || path === `/${locale}` ? title : `${title} | ${SITE.name}`;
const pageLocale = LOCALE_META[locale].code;
const ogLocaleTag = LOCALE_META[locale].code.replace('-', '_');

/** Build an absolute URL for the same page under every configured locale. */
function localeUrl(code: string): string {
  // The English canonical path for this page.
  const englishPath = path.replace(/^\/+(zh|fr|ar|es)(?=\/|$)/, '');
  const p = englishPath === '/' ? '' : englishPath;
  if (code === DEFAULT_LOCALE) return SITE.url + p;
  return SITE.url + '/' + code + p;
}
const alternateLinks = LOCALES.map((code) => ({
  hreflang: code,
  href: code === locale ? canonical : localeUrl(code),
}));

/** Trim long descriptions to ~158 chars at a word boundary (Google truncates ~160). */
function trimDesc(d: string): string {
  if (d.length <= 158) return d;
  return d.slice(0, 155).replace(/\s+\S*$/, '') + '…';
}
const descMeta = trimDesc(description);
---

<title>{fullTitle}</title>
<meta name="description" content={descMeta} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
{!noindex && alternateLinks.map((l) => (
  <link rel="alternate" hreflang={l.hreflang} href={l.href} />
))}
{!noindex && <link rel="alternate" hreflang="x-default" href={localeUrl(DEFAULT_LOCALE)} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={descMeta} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocaleTag} />
{LOCALES.filter((c) => c !== locale).map((c) => (
  <meta property="og:locale:alternate" content={LOCALE_META[c].code.replace('-', '_')} />
))}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@routetoabroad" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={descMeta} />
<meta name="twitter:image" content={ogImage} />

{crumbs && crumbs.length > 0 && <JsonLd schema={breadcrumbSchema(crumbs)} />}
{jsonLd.map((schema) => <JsonLd schema={schema} />)}
<slot />
