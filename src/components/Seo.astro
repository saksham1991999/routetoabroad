---
import { SITE } from '../lib/site';
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema } from '../lib/schema';
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, translatePath, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /**
   * Path beginning with /, e.g. /education. For a localized page, pass
   * EITHER the unprefixed English path with the `locale` prop
   * (path="/education" + locale="zh"), OR the localized path
   * (path="/zh/education" + locale="zh"). Both produce the same, correct
   * self-canonical and hreflang output — prefixed values are stripped first.
   */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  crumbs?: { name: string; url: string }[];
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: object[];
  /** Page locale. When omitted, defaults to 'en' (the root, unprefixed tree). */
  locale?: Locale;
}

const {
  title,
  description,
  path,
  image = '/og/default.jpg',
  type = 'website',
  noindex = false,
  crumbs,
  publishedTime,
  modifiedTime,
  jsonLd = [],
  locale = DEFAULT_LOCALE,
} = Astro.props;

// The English canonical path for this page. Locale-prefixed callers pass
// e.g. path="/zh/education" + locale="zh"; strip the locale segment so every
// URL computation (canonical, hreflang, og:url) is derived from one source.
const englishPath = path.replace(/^\/+(zh|fr|ar|es)(?=\/|$)/, '');
// i18n: when this page is a localized copy, the canonical points at the
// localized URL (self-reference), not the English one. The English version
// stays reachable via the hreflang links emitted below.
const canonical = new URL(translatePath(englishPath, locale), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = englishPath === '/' ? title : `${title} | ${SITE.name}`;
const pageLocale = LOCALE_META[locale].code;
// og:locale wants language_TERRITORY (en_US, zh_CN, fr_FR, ar_AE, es_ES).
const OG_TERRITORY: Record<string, string> = {
  en: 'US',
  zh: 'CN',
  fr: 'FR',
  ar: 'AE',
  es: 'ES',
};
const ogLocaleTag = `${pageLocale.replace('-', '_')}_${OG_TERRITORY[pageLocale] ?? 'US'}`;

/** Build an absolute URL for the same page under every configured locale. */
function localeUrl(code: string): string {
  const p = englishPath === '/' ? '/' : englishPath;
  if (code === DEFAULT_LOCALE) return SITE.url + p;
  return SITE.url + '/' + code + p;
}
const alternateLinks = LOCALES.map((code) => ({
  hreflang: code,
  href: code === locale ? canonical : localeUrl(code),
}));


/** Trim long descriptions to ~158 chars at a word boundary (Google truncates ~160). */
function trimDesc(d: string): string {
  if (d.length <= 158) return d;
  return d.slice(0, 155).replace(/\s+\S*$/, '') + '…';
}
const descMeta = trimDesc(description);
---

<title>{fullTitle}</title>
<meta name="description" content={descMeta} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
{!noindex && alternateLinks.map((l) => (
  <link rel="alternate" hreflang={l.hreflang} href={l.href} />
))}
{!noindex && <link rel="alternate" hreflang="x-default" href={localeUrl(DEFAULT_LOCALE)} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={descMeta} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocaleTag} />
{LOCALES.filter((c) => c !== locale).map((c) => (
  <meta
    property="og:locale:alternate"
    content={`${LOCALE_META[c].code.replace('-', '_')}_${OG_TERRITORY[LOCALE_META[c].code] ?? 'US'}`}
  />
))}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@routetoabroad" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={descMeta} />
<meta name="twitter:image" content={ogImage} />

{crumbs && crumbs.length > 0 && <JsonLd schema={breadcrumbSchema(crumbs)} />}
{jsonLd.map((schema) => <JsonLd schema={schema} />)}
<slot />
