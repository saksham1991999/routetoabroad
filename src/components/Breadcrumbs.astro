---
import { SITE } from '../lib/site';
import { localeFromPath, translatePath } from '../lib/i18n';
import { uiFor } from '../i18n/ui';

interface Props {
  crumbs: { name: string; url: string }[];
}

const { crumbs } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const withHome = [{ name: uiFor(locale).breadcrumbsHome, url: translatePath('/', locale) }, ...crumbs];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {withHome.map((c, i) => (
      <li>
        {i === withHome.length - 1 ? (
          <span aria-current="page">{c.name}</span>
        ) : (
          <a href={c.url.replace(SITE.url, '') || '/'}>{c.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
