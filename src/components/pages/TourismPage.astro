---
/**
 * Tourism pillar page — shared by all five locales (route shells under
 * src/pages/tourism/ and src/pages/<locale>/tourism/ pass `locale`). All
 * copy comes from the per-locale dictionary in src/i18n/pages/tourism.ts;
 * internal links are localized through translatePath and forms/CTA take the
 * locale prop.
 */
import { getCollection } from 'astro:content';
import { localizedEntries, entrySlug } from '../../lib/content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import TourismForm from '../forms/TourismForm.astro';
import { TOURISM_FAQS } from '../../data/faqs';
import { faqSchema, serviceSchema } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { TOURISM } from '../../i18n/pages/tourism';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localized page copy. */
const t = TOURISM[locale];

const heroImg = (await import('../../assets/images/hero-tourism.jpg')).default;
const liRiver = (await import('../../assets/images/guide-li-river.jpg')).default;
const kyoto = (await import('../../assets/images/country-japan.jpg')).default;

const cities = localizedEntries(await getCollection('cities'), locale).sort((a, b) => a.data.order - b.data.order);
const pageFaqs = TOURISM_FAQS[locale].slice(0, 6);

/* Card imagery stays in the component; names/alts/circuits come from the
   dictionary (card order fixed: China first, then Japan). */
const destinationImages = [liRiver, kyoto];
const destinations = t.destinations.cards.map((d, i) => ({ ...d, image: destinationImages[i] }));

const modes = t.modes.items;
const care = t.care.items;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/tourism"
  image="/og/tourism.jpg"
  crumbs={[{ name: t.crumb, url: translatePath('/tourism', locale) }]}
  jsonLd={[
    serviceSchema({
      name: t.schema.serviceName,
      description: t.schema.serviceDescription,
      url: translatePath('/tourism', locale),
      serviceType: t.schema.serviceType,
      areaServed: ['IN', 'CN', 'JP'],
    }),
    faqSchema(pageFaqs),
  ]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/tourism', locale) }]}
    facts={t.hero.facts}
    actions={[
      { href: '#plan', label: t.hero.primaryCta },
      { href: '#destinations', label: t.hero.secondaryCta, variant: 'outline' },
    ]}
    jumps={[
      { href: '#destinations', label: t.hero.jumps[0] },
      { href: '#modes', label: t.hero.jumps[1] },
      { href: '#care', label: t.hero.jumps[2] },
      { href: '#plan', label: t.hero.jumps[3] },
      { href: '#faq', label: t.hero.jumps[4] },
    ]}
  />

  <!-- Hero image band -->
  <section class="hero-band">
    <Picture
      src={heroImg}
      alt={t.heroBand.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <p class="hero-band-caption num">{t.heroBand.caption}</p>
  </section>

  <!-- Destinations -->
  <section class="section" id="destinations">
    <div class="container">
      <SectionHead
        eyebrow={t.destinations.eyebrow}
        index={t.destinations.index}
        title={t.destinations.title}
        lede={t.destinations.lede}
      />
      <div class="dest-grid">
        {destinations.map((d, i) => (
          <article class="dest-card card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="dest-media">
              <Picture src={d.image} alt={d.alt} widths={[640, 1024]} sizes="(max-width: 64rem) 100vw, 50vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="dest-body">
              <h2>{d.name}</h2>
              <ul>
                {d.circuits.map((c) => (
                  <li>
                    <strong>{c.title}.</strong> {c.text}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <div class="city-links" data-reveal>
        <p class="divider-label">{t.destinations.cityGuides}</p>
        <div class="city-chips">
          {cities.map((c) => (
            <a href={translatePath(`/cities/${entrySlug(c)}`, locale)} class="chip">{c.data.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Travel modes -->
  <section class="section section-sunken" id="modes">
    <div class="container">
      <SectionHead
        eyebrow={t.modes.eyebrow}
        index={t.modes.index}
        title={t.modes.title}
        lede={t.modes.lede}
      />
      <div class="modes-grid">
        {modes.map((m, i) => (
          <article class="mode-card card card-pad" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <h3>{m.name}</h3>
            <p>{m.text}</p>
            <ul>
              {m.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Care -->
  <section class="section" id="care">
    <div class="container">
      <SectionHead
        eyebrow={t.care.eyebrow}
        index={t.care.index}
        title={t.care.title}
        lede={t.care.lede}
      />
      <div class="care-grid">
        {care.map((c, i) => (
          <div class="care-item" data-reveal style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <span class="care-check" aria-hidden="true">✓</span>
            <div>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section-sunken" id="plan">
    <div class="container form-split">
      <div data-reveal>
        <SectionHead
          eyebrow={t.plan.eyebrow}
          title={t.plan.title}
          lede={t.plan.lede}
        />
        <div class="guarantee card card-pad">
          <p class="eyebrow">{t.plan.promise.eyebrow}</p>
          <p>
            <strong>{t.plan.promise.strong}</strong> {t.plan.promise.rest}
          </p>
        </div>
      </div>
      <div class="form-card card card-pad" data-reveal>
        <TourismForm locale={locale} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container-text">
      <SectionHead center eyebrow={t.faq.eyebrow} index={t.faq.index} title={t.faq.title} />
      <FaqAccordion faqs={pageFaqs} />
      <p class="faq-more"><a href={translatePath('/tourism/faq', locale)} class="arrow-link">{t.faq.more}</a></p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .hero-band {
    position: relative;
  }

  .hero-band :global(img) {
    width: 100%;
    max-height: 68vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .hero-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent 38%);
    pointer-events: none;
  }

  .hero-band-caption {
    position: absolute;
    bottom: 1rem;
    right: 1.25rem;
    z-index: 1;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
  }

  .dest-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .dest-card {
    overflow: hidden;
  }

  .dest-media {
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .dest-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dest-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .dest-body {
    padding: 1.7rem 1.8rem 2rem;
  }

  .dest-body h2 {
    font-size: var(--step-3);
  }

  .dest-body ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .dest-body li {
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .dest-body strong {
    color: var(--ink);
  }

  .city-links {
    margin-top: 2.5rem;
  }

  .city-chips {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .city-chips .chip {
    text-decoration: none;
  }

  .city-chips .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .modes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .mode-card h3 {
    font-size: 1.3rem;
  }

  .mode-card > p {
    margin-top: 0.6rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .mode-card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    font-size: 0.88rem;
  }

  .mode-card li::before {
    content: '—';
    color: var(--tourism);
    margin-right: 0.5rem;
  }

  .care-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem 2rem;
  }

  .care-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
  }

  .care-check {
    color: var(--accent);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.5;
  }

  .care-item h3 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .care-item p {
    margin-top: 0.25rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .form-split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .guarantee {
    margin-top: 1.8rem;
  }

  .guarantee p:last-child {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .faq-more {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .dest-grid,
    .modes-grid,
    .care-grid,
    .form-split {
      grid-template-columns: 1fr;
    }
  }
</style>
