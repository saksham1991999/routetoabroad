---
/**
 * blog detail page — shared by all five locales. Route shells under
 * src/pages/blog/[slug].astro and src/pages/<locale>/blog/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the locale-resolved collection entry; template copy comes from the
 * per-locale dictionary in src/i18n/pages/blog-post.ts, entry frontmatter
 * renders as-is (en fallback or localized copy), and links localize through
 * translatePath.
 */
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import ArticleCard from '../ArticleCard.astro';
import CtaBand from '../CtaBand.astro';
import { AUTHORS } from '../../data/authors';
import { articleSchema } from '../../lib/schema';
import { localizedEntries, entrySlug } from '../../lib/content';
import { BLOG_POST } from '../../i18n/pages/blog-post';


import { translatePath, DEFAULT_LOCALE, DATE_TAG, localizeHtmlLinks, type Locale } from '../../lib/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale?: Locale;
  post: CollectionEntry<'blog'>;
}
const { locale = DEFAULT_LOCALE, post } = Astro.props;
/** Localized template copy. */
const t = BLOG_POST[locale];
const { data } = post;
const { Content } = await render(post);
const author = AUTHORS[data.author];
const slug = entrySlug(post);
const url = `${SITE.url}${translatePath(`/blog/${slug}`, locale)}`;

const related = localizedEntries(await getCollection('blog'), locale)
  .filter((p) => entrySlug(p) !== slug && p.data.category === data.category)
  .slice(0, 3);
const relatedFallback =
  related.length < 3
    ? [
        ...localizedEntries(await getCollection('blog'), locale).filter(
          (p) => entrySlug(p) !== slug && !related.find((r) => entrySlug(r) === entrySlug(p))
        ),
      ].slice(0, 3 - related.length)
    : [];
const relatedAll = [...related, ...relatedFallback];
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  path={`/blog/${slug}`}
  type="article"
  image="/og/default.jpg"
  crumbs={[
    { name: t.crumb, url: translatePath('/blog', locale) },
    { name: data.title, url },
  ]}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  progress
  jsonLd={[
    articleSchema({
      headline: data.title,
      description: data.description,
      url,
      image: `${SITE.url}/og/default.jpg`,
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      authorName: author?.name ?? data.author,
      authorUrl: author?.linkedin,
      section: data.category,
    }),
  ]}
>
  <article class="container-text post">
    <header class="post-head">
      <Breadcrumbs
        crumbs={[
          { name: t.crumb, url: translatePath('/blog', locale) },
          { name: data.title, url: translatePath(`/blog/${slug}`, locale) },
        ]}
      />
      <p class="eyebrow">{t.categories[data.category]}</p>
      <h1>{data.title}</h1>
      <p class="post-desc">{data.description}</p>

      <div class="post-meta">
        <div class="post-author">
          {author?.image ? (
            <img src={author.image} alt="" width="44" height="44" loading="lazy" class="author-img" />
          ) : (
            <span class="author-initials num" aria-hidden="true">{author?.initials ?? 'RT'}</span>
          )}
          <div>
            <strong>{author?.name ?? data.author}</strong>
            <span>{author?.role[locale]}</span>
          </div>
        </div>
        <div class="post-dates num">
          <span>{data.pubDate.toLocaleDateString(DATE_TAG[locale], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>
          {data.updatedDate && (
            <span>{t.updated.replace('{date}', data.updatedDate.toLocaleDateString(DATE_TAG[locale], { month: 'short', year: 'numeric', timeZone: 'UTC' }))}</span>
          )}
          <span>{t.readTime.replace('{n}', String(data.readTime))}</span>
        </div>
      </div>
    </header>

    <div class="post-image">
      <Picture src={data.image} alt={data.imageAlt} widths={[768, 1280]} sizes="(max-width: 64rem) 100vw, 43rem" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </div>

    <div class="prose post-body">
      {post.rendered?.html ? <Fragment set:html={localizeHtmlLinks(post.rendered.html, locale)} /> : <Content />}
    </div>

    <footer class="post-foot">
      <div class="tags">
        {data.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
      <div class="post-cta card card-pad">
        <p class="eyebrow">{t.cta.eyebrow}</p>
        <p class="post-cta-text">{t.cta.text}</p>
        <div class="post-cta-btns">
          <a href={translatePath('/tools/fit-check', locale)} class="btn btn-primary btn-sm">{t.cta.primary}</a>
          <a href={translatePath('/contact', locale)} class="btn btn-outline btn-sm">{t.cta.secondary}</a>
        </div>
      </div>
    </footer>
  </article>

  {relatedAll.length > 0 && (
    <section class="section section-sunken related">
      <div class="container">
        <p class="divider-label">{t.related}</p>
        <div class="related-grid">
          {relatedAll.map((p) => (
            <ArticleCard
              locale={locale}
              title={p.data.title}
              href={translatePath(`/blog/${entrySlug(p)}`, locale)}
              description={p.data.description}
              image={p.data.image}
              imageAlt={p.data.imageAlt}
              tag={t.categories[p.data.category]}
              pillar={p.data.category}
              meta={t.minShort.replace('{n}', String(p.data.readTime))}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }

  .post-head h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
  }

  .post-desc {
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .post-meta {
    margin-top: 1.8rem;
    padding-block: 1.1rem;
    border-block: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .author-img {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
  }

  .author-initials {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .post-author strong {
    display: block;
    font-size: 0.92rem;
  }

  .post-author span {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .post-dates {
    font-size: 0.8rem;
    color: var(--ink-faint);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .post-image {
    margin-top: 1.8rem;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .post-image :global(img) {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    filter: grayscale(15%) contrast(1.05);
  }

  .post-body {
    margin-top: 2.2rem;
  }

  .post-foot {
    margin-top: 3rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-cta {
    margin-top: 2rem;
  }

  .post-cta-text {
    margin: 0.6rem 0 1.1rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 46ch;
  }

  .post-cta-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .related {
    margin-top: 4rem;
  }

  .related-grid {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 64rem) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
