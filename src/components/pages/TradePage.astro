---
/**
 * Trade pillar page — shared by all five locales (route shells under
 * src/pages/trade/ and src/pages/<locale>/trade/ pass `locale`). All
 * copy comes from the per-locale dictionary in src/i18n/pages/trade.ts;
 * internal links are localized through translatePath and forms/CTA take the
 * locale prop.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import TradeForm from '../forms/TradeForm.astro';
import { TRADE_FAQS } from '../../data/faqs';
import { faqSchema, serviceSchema } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { TRADE } from '../../i18n/pages/trade';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localized page copy. */
const t = TRADE[locale];

const heroImg = (await import('../../assets/images/hero-trade.jpg')).default;
const pageFaqs = TRADE_FAQS[locale].slice(0, 6);

/* Discipline numerals are glyphs, not copy — they stay in the component. */
const disciplineNs = ['01', '02', '03', '04', '05'];
const disciplines = t.disciplines.items.map((d, i) => ({ ...d, n: disciplineNs[i] }));

const industries = t.industries.items;
const process = t.process.steps;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/trade"
  image="/og/trade.jpg"
  crumbs={[{ name: t.crumb, url: translatePath('/trade', locale) }]}
  jsonLd={[
    serviceSchema({
      name: t.schema.serviceName,
      description: t.schema.serviceDescription,
      url: translatePath('/trade', locale),
      serviceType: t.schema.serviceType,
      areaServed: ['IN', 'CN'],
    }),
    faqSchema(pageFaqs),
  ]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/trade', locale) }]}
    facts={t.hero.facts}
    actions={[
      { href: '#enquire', label: t.hero.primaryCta },
      { href: '#disciplines', label: t.hero.secondaryCta, variant: 'outline' },
    ]}
    jumps={[
      { href: '#disciplines', label: t.hero.jumps[0] },
      { href: '#process', label: t.hero.jumps[1] },
      { href: '#industries', label: t.hero.jumps[2] },
      { href: '#enquire', label: t.hero.jumps[3] },
      { href: '#faq', label: t.hero.jumps[4] },
    ]}
  />

  <section class="hero-band">
    <Picture
      src={heroImg}
      alt={t.heroBand.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <p class="hero-band-caption num">{t.heroBand.caption}</p>
  </section>

  <!-- Disciplines -->
  <section class="section" id="disciplines">
    <div class="container">
      <SectionHead
        eyebrow={t.disciplines.eyebrow}
        index={t.disciplines.index}
        title={t.disciplines.title}
        lede={t.disciplines.lede}
      />
      <div class="disc-grid">
        {disciplines.map((d, i) => (
          <article class="disc-card card" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms`}>
            <span class="disc-n num" aria-hidden="true">{d.n}</span>
            <h3>{d.name}</h3>
            <p>{d.text}</p>
            <p class="disc-stat num">{d.stat}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section-sunken" id="process">
    <div class="container-text">
      <SectionHead
        eyebrow={t.process.eyebrow}
        index={t.process.index}
        title={t.process.title}
        lede={t.process.lede}
      />
      <ol class="timeline">
        {process.map((step, i) => (
          <li class="timeline-step" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="t-num num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.name}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Industries -->
  <section class="section" id="industries">
    <div class="container">
      <SectionHead
        eyebrow={t.industries.eyebrow}
        index={t.industries.index}
        title={t.industries.title}
        lede={t.industries.lede}
      />
      <div class="industry-chips" data-reveal>
        {industries.map((ind) => <span class="chip">{ind}</span>)}
      </div>

      <div class="pay-strip" data-reveal>
        {t.payStrip.map((item) => (
          <div class="pay-item">
            <p class="num">{item.num}</p>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section-sunken" id="enquire">
    <div class="container form-split">
      <div data-reveal>
        <SectionHead
          eyebrow={t.enquire.eyebrow}
          title={t.enquire.title}
          lede={t.enquire.lede}
        />
        <ul class="why-trade">
          {t.enquire.why.map((item) => (
            <li><strong>{item.lead}</strong> {item.text}</li>
          ))}
        </ul>
      </div>
      <div class="form-card card card-pad" data-reveal>
        <TradeForm locale={locale} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container-text">
      <SectionHead center eyebrow={t.faq.eyebrow} index={t.faq.index} title={t.faq.title} />
      <FaqAccordion faqs={pageFaqs} />
      <p class="faq-more"><a href={translatePath('/trade/faq', locale)} class="arrow-link">{t.faq.more}</a></p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .hero-band {
    position: relative;
  }

  .hero-band :global(img) {
    width: 100%;
    max-height: 62vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .hero-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent 38%);
    pointer-events: none;
  }

  .hero-band-caption {
    position: absolute;
    bottom: 1rem;
    right: 1.25rem;
    z-index: 1;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
  }

  .disc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  .disc-card {
    padding: 1.7rem 1.8rem 1.8rem;
    position: relative;
    transition: border-color 0.2s var(--ease-out);
  }

  .disc-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .disc-n {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-text);
    letter-spacing: 0.1em;
  }

  .disc-card h3 {
    margin-top: 0.6rem;
    font-size: 1.35rem;
  }

  .disc-card p {
    margin-top: 0.55rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.62;
  }

  .disc-stat {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1.4rem;
    position: relative;
    padding-bottom: 2.2rem;
  }

  .timeline-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    top: 2.1rem;
    bottom: 0.3rem;
    width: 0;
    border-left: 1px dotted color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .t-num {
    text-align: center;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .timeline h3 {
    font-size: 1.25rem;
  }

  .timeline p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 58ch;
  }

  .industry-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .pay-strip {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }

  .pay-item {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .pay-item + .pay-item {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }

  .pay-item .num {
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .pay-item p:last-child {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .form-split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .why-trade {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .why-trade li {
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .faq-more {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .disc-grid,
    .form-split {
      grid-template-columns: 1fr;
    }
    .pay-strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .pay-item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .pay-item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 30rem) {
    .pay-strip {
      grid-template-columns: 1fr;
    }
    .pay-item + .pay-item {
      border-left: 0;
      padding-left: 0;
    }
    .pay-item:nth-child(n + 2) {
      border-top: 1px solid var(--line);
    }
  }
</style>
