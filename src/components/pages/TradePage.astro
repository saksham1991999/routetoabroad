---
/**
 * Trade pillar page — shared by all five locales (route shells under
 * src/pages/trade/ and src/pages/<locale>/trade/ pass `locale`). All
 * copy comes from the per-locale dictionary in src/i18n/pages/trade.ts;
 * internal links are localized through translatePath and forms/CTA take the
 * locale prop.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import TradeForm from '../forms/TradeForm.astro';
import { TRADE_FAQS } from '../../data/faqs';
import {
  TRADE_CATEGORIES,
  TRADE_SKUS,
  SOURCING_CLUSTERS,
  COMPLIANCE_MATRIX,
} from '../../data/trade-catalog';
import { faqSchema, serviceSchema, tradeOfferCatalogSchema } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { TRADE } from '../../i18n/pages/trade';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localized page copy. */
const t = TRADE[locale];

const heroImg = (await import('../../assets/images/hero-trade.jpg')).default;
const pageFaqs = TRADE_FAQS[locale].slice(0, 6);

/* Discipline numerals are glyphs, not copy — they stay in the component. */
const disciplineNs = ['01', '02', '03', '04', '05'];
const disciplines = t.disciplines.items.map((d, i) => ({ ...d, n: disciplineNs[i] }));

const industries = t.industries.items;
const process = t.process.steps;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/trade"
  image="/og/trade.jpg"
  crumbs={[{ name: t.crumb, url: translatePath('/trade', locale) }]}
  jsonLd={[
    serviceSchema({
      name: t.schema.serviceName,
      description: t.schema.serviceDescription,
      url: translatePath('/trade', locale),
      serviceType: t.schema.serviceType,
      areaServed: ['US', 'IN', 'CN', 'AE', 'SA', 'NG', 'KE', 'GB', 'DE'],
    }),
    tradeOfferCatalogSchema(
      TRADE_SKUS.map((s) => ({
        name: s.name,
        sku: s.sku,
        category: s.category,
        description: `${s.moq} · ${s.fobRange} · ${s.port}`,
      }))
    ),
    faqSchema(pageFaqs),
  ]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/trade', locale) }]}
    facts={t.hero.facts}
    actions={[
      { href: '#enquire', label: t.hero.primaryCta },
      { href: '#disciplines', label: t.hero.secondaryCta, variant: 'outline' },
    ]}
    jumps={[
      { href: '#disciplines', label: t.hero.jumps[0] },
      { href: '#process', label: t.hero.jumps[1] },
      { href: '#industries', label: t.hero.jumps[2] },
      { href: '#enquire', label: t.hero.jumps[3] },
      { href: '#faq', label: t.hero.jumps[4] },
    ]}
  />

  <section class="hero-band">
    <Picture
      src={heroImg}
      alt={t.heroBand.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <p class="hero-band-caption num">{t.heroBand.caption}</p>
  </section>

  <!-- Disciplines -->
  <section class="section" id="disciplines">
    <div class="container">
      <SectionHead
        eyebrow={t.disciplines.eyebrow}
        index={t.disciplines.index}
        title={t.disciplines.title}
        lede={t.disciplines.lede}
      />
      <div class="disc-grid">
        {disciplines.map((d, i) => (
          <article class="disc-card card" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms`}>
            <span class="disc-n num" aria-hidden="true">{d.n}</span>
            <h3>{d.name}</h3>
            <p>{d.text}</p>
            <p class="disc-stat num">{d.stat}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section-sunken" id="process">
    <div class="container-text">
      <SectionHead
        eyebrow={t.process.eyebrow}
        index={t.process.index}
        title={t.process.title}
        lede={t.process.lede}
      />
      <ol class="timeline">
        {process.map((step, i) => (
          <li class="timeline-step" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="t-num num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.name}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Industries -->
  <section class="section" id="industries">
    <div class="container">
      <SectionHead
        eyebrow={t.industries.eyebrow}
        index={t.industries.index}
        title={t.industries.title}
        lede={t.industries.lede}
      />
      <div class="industry-chips" data-reveal>
        {industries.map((ind) => <span class="chip">{ind}</span>)}
      </div>

      <div class="pay-strip" data-reveal>
        {t.payStrip.map((item) => (
          <div class="pay-item">
            <p class="num">{item.num}</p>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sourcing Catalog -->
  <section class="section section-sunken" id="catalog">
    <div class="container">
      <SectionHead
        eyebrow="Sourcing Catalog"
        index="CAT / 08"
        title="Verified SKUs & factory benchmarks"
        lede="Filter 16 benchmark SKUs across 8 core manufacturing categories. Indicative FOB ranges, port of departure, MOQ and target compliance marks — ready for OEM customisation."
      />

      <div class="catalog-controls" data-reveal>
        <div class="catalog-search-wrap">
          <label for="catalog-search" class="visually-hidden">Search SKUs, ports, or compliance marks</label>
          <input
            id="catalog-search"
            type="search"
            class="catalog-search"
            placeholder="Search SKU, product, port, or compliance (e.g. BIS, Shenzhen, GaN)…"
            autocomplete="off"
          />
          <span class="catalog-count num" id="catalog-count" aria-live="polite">
            {TRADE_SKUS.length} / {TRADE_SKUS.length} SKUs
          </span>
        </div>

        <div class="catalog-cats" role="group" aria-label="Filter by product category">
          <button type="button" class="cat-pill is-active" data-cat="all">
            All categories ({TRADE_SKUS.length})
          </button>
          {TRADE_CATEGORIES.map((cat) => (
            <button type="button" class="cat-pill" data-cat={cat.id}>
              {cat.name}
            </button>
          ))}
        </div>
      </div>

      <div class="catalog-grid" id="catalog-grid">
        {TRADE_SKUS.map((item) => {
          const catObj = TRADE_CATEGORIES.find((c) => c.id === item.category);
          const searchBlob = `${item.sku} ${item.name} ${catObj?.name ?? ''} ${item.port} ${item.compliance.join(' ')}`.toLowerCase();
          return (
            <article
              class="sku-card card"
              data-category={item.category}
              data-search={searchBlob}
            >
              <div class="sku-top">
                <span class="sku-code num">{item.sku}</span>
                <span class="sku-cat">{catObj?.name}</span>
              </div>
              <h3 class="sku-name">{item.name}</h3>
              <dl class="sku-meta">
                <div>
                  <dt>MOQ</dt>
                  <dd class="num">{item.moq}</dd>
                </div>
                <div>
                  <dt>FOB Range</dt>
                  <dd class="num sku-fob">{item.fobRange}</dd>
                </div>
                <div>
                  <dt>Port</dt>
                  <dd>{item.port}</dd>
                </div>
                <div>
                  <dt>Lead Time</dt>
                  <dd class="num">{item.leadTime}</dd>
                </div>
              </dl>
              <div class="sku-bottom">
                <div class="sku-badges" aria-label="Compliance marks">
                  {item.compliance.map((mark) => (
                    <span class="comp-badge num">{mark}</span>
                  ))}
                </div>
                <a href="#enquire" class="arrow-link sku-cta">Quote</a>
              </div>
            </article>
          );
        })}
      </div>

      <p class="catalog-empty" id="catalog-empty" hidden>
        No SKUs match your current filter. Try clearing the search or selecting another category.
      </p>

      <div class="catalog-tool-bar" data-reveal>
        <p>Need FCL, LCL CBM, or air freight landed cost to India, GCC, Africa, EU, or Americas?</p>
        <a href={translatePath('/tools/trade-cost-calculator', locale)} class="btn btn-primary">
          Open Landed Cost Estimator
        </a>
      </div>
    </div>
  </section>

  <!-- Sourcing Clusters -->
  <section class="section" id="clusters">
    <div class="container">
      <SectionHead
        eyebrow="China Manufacturing Hubs"
        index="HUB / 04"
        title="Four industrial clusters, one QC team"
        lede="We match your BOM to the province where tier-1 component suppliers and export ports actually sit — cutting domestic drayage and middleman markups."
      />
      <div class="clusters-grid">
        {SOURCING_CLUSTERS.map((hub, i) => (
          <article class="cluster-card card" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms`}>
            <div class="cluster-head">
              <span class="cluster-num num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{hub.province}</h3>
            </div>
            <p class="cluster-cities num">{hub.cities}</p>
            <p class="cluster-spec"><strong>Specialties:</strong> {hub.specialties}</p>
            <p class="cluster-ports"><strong>Primary ports:</strong> {hub.ports}</p>
            <p class="cluster-notes">{hub.notes}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Matrix -->
  <section class="section section-sunken" id="compliance">
    <div class="container">
      <SectionHead
        eyebrow="Import & Regulatory Matrix"
        index="REG / 06"
        title="Global & India compliance before dispatch"
        lede="Certifications and pre-shipment inspections are verified at the factory gate so containers do not stall at destination customs."
      />
      <div class="matrix-wrap card" data-reveal>
        <table class="matrix-table">
          <thead>
            <tr>
              <th>Region</th>
              <th>Marks</th>
              <th>Authority</th>
              <th>Applies To</th>
              <th>Lead Time</th>
              <th>Verification</th>
            </tr>
          </thead>
          <tbody>
            {COMPLIANCE_MATRIX.map((row) => (
              <tr>
                <td class="matrix-region"><strong>{row.region}</strong></td>
                <td class="num matrix-mark">{row.mark}</td>
                <td>{row.authority}</td>
                <td>{row.appliesTo}</td>
                <td class="num">{row.leadTime}</td>
                <td class="matrix-notes">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section" id="enquire">
    <div class="container form-split">
      <div data-reveal>
        <SectionHead
          eyebrow={t.enquire.eyebrow}
          title={t.enquire.title}
          lede={t.enquire.lede}
        />
        <ul class="why-trade">
          {t.enquire.why.map((item) => (
            <li><strong>{item.lead}</strong> {item.text}</li>
          ))}
        </ul>
      </div>
      <div class="form-card card card-pad" data-reveal>
        <TradeForm locale={locale} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-sunken" id="faq">
    <div class="container-text">
      <SectionHead center eyebrow={t.faq.eyebrow} index={t.faq.index} title={t.faq.title} />
      <FaqAccordion faqs={pageFaqs} />
      <p class="faq-more"><a href={translatePath('/trade/faq', locale)} class="arrow-link">{t.faq.more}</a></p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .hero-band {
    position: relative;
  }

  .hero-band :global(img) {
    width: 100%;
    max-height: 62vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .hero-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent 38%);
    pointer-events: none;
  }

  .hero-band-caption {
    position: absolute;
    bottom: 1rem;
    right: 1.25rem;
    z-index: 1;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
  }

  .disc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  .disc-card {
    padding: 1.7rem 1.8rem 1.8rem;
    position: relative;
    transition: border-color 0.2s var(--ease-out);
  }

  .disc-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .disc-n {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-text);
    letter-spacing: 0.1em;
  }

  .disc-card h3 {
    margin-top: 0.6rem;
    font-size: 1.35rem;
  }

  .disc-card p {
    margin-top: 0.55rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.62;
  }

  .disc-stat {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1.4rem;
    position: relative;
    padding-bottom: 2.2rem;
  }

  .timeline-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    top: 2.1rem;
    bottom: 0.3rem;
    width: 0;
    border-left: 1px dotted color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .t-num {
    text-align: center;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .timeline h3 {
    font-size: 1.25rem;
  }

  .timeline p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 58ch;
  }

  .industry-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .pay-strip {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }

  .pay-item {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }

  .pay-item + .pay-item {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }

  .pay-item .num {
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .pay-item p:last-child {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .form-split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .why-trade {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .why-trade li {
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .faq-more {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .disc-grid,
    .form-split {
      grid-template-columns: 1fr;
    }
    .pay-strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .pay-item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .pay-item:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 30rem) {
    .pay-strip {
      grid-template-columns: 1fr;
    }
    .pay-item + .pay-item {
      border-left: 0;
      padding-left: 0;
    }
    .pay-item:nth-child(n + 2) {
      border-top: 1px solid var(--line);
    }
  }

  /* Sourcing Catalog */
  .catalog-controls {
    display: grid;
    gap: 1.1rem;
    margin-bottom: 1.8rem;
  }

  .catalog-search-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .catalog-search {
    flex: 1 1 20rem;
    padding: 0.75rem 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    transition: border-color 0.15s;
  }

  .catalog-search:focus {
    outline: none;
    border-color: var(--trade);
    box-shadow: var(--glow-accent);
  }

  .catalog-count {
    font-size: 0.8rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .catalog-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-pill {
    padding: 0.45rem 0.9rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }

  .cat-pill:hover {
    border-color: var(--trade);
    color: var(--ink);
  }

  .cat-pill.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .sku-card {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-top: 2px solid var(--trade);
  }

  .sku-card[hidden] {
    display: none;
  }

  .sku-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sku-code {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }

  .sku-cat {
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .sku-name {
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .sku-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem 1rem;
    margin: 0;
    padding-block: 0.75rem;
    border-block: 1px solid var(--line);
  }

  .sku-meta dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .sku-meta dd {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .sku-fob {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .sku-bottom {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sku-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .comp-badge {
    font-size: 0.7rem;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--paper);
    color: var(--ink-soft);
  }

  .sku-cta {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .catalog-empty {
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-m);
    color: var(--ink-soft);
  }

  .catalog-tool-bar {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .catalog-tool-bar p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* Sourcing Clusters */
  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .cluster-card {
    padding: 1.5rem;
    display: grid;
    gap: 0.55rem;
    border-top: 2px solid var(--trade);
  }

  .cluster-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .cluster-num {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .cluster-head h3 {
    font-size: 1.25rem;
  }

  .cluster-cities {
    font-size: 0.82rem;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .cluster-spec,
  .cluster-ports,
  .cluster-notes {
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  /* Compliance Matrix */
  .matrix-wrap {
    overflow-x: auto;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 44rem;
  }

  .matrix-table th,
  .matrix-table td {
    text-align: start;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .matrix-table th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    background: var(--paper);
  }

  .matrix-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .matrix-mark {
    font-weight: 600;
    color: var(--accent-text);
    white-space: nowrap;
  }

  .matrix-notes {
    color: var(--ink-soft);
    line-height: 1.5;
  }

  @media (max-width: 56rem) {
    .catalog-grid,
    .clusters-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
  const countEl = document.getElementById('catalog-count');
  const emptyEl = document.getElementById('catalog-empty');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#catalog-grid .sku-card'));
  const catButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.catalog-cats .cat-pill'));

  let activeCat = 'all';
  let query = '';

  function applyCatalogFilter() {
    let visible = 0;
    const q = query.trim().toLowerCase();

    for (const card of cards) {
      const catMatch = activeCat === 'all' || card.dataset.category === activeCat;
      const searchMatch = !q || (card.dataset.search ?? '').includes(q);
      const show = catMatch && searchMatch;
      card.hidden = !show;
      if (show) visible++;
    }

    if (countEl) {
      countEl.textContent = `${visible} / ${cards.length} SKUs`;
    }
    if (emptyEl) {
      emptyEl.hidden = visible > 0;
    }
  }

  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    applyCatalogFilter();
  });

  for (const btn of catButtons) {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat ?? 'all';
      for (const b of catButtons) {
        b.classList.toggle('is-active', b === btn);
      }
      applyCatalogFilter();
    });
  }
</script>
