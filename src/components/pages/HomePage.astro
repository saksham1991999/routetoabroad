---
/**
 * Homepage — shared by all five locales (route shells at src/pages/index.astro
 * and src/pages/<locale>/index.astro pass `locale`). All copy comes from the
 * per-locale dictionary in src/i18n/pages/home.ts; hrefs localize through
 * translatePath and chrome/CTA/stats/carousel take the locale prop.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Marquee from '../Marquee.astro';
import SectionHead from '../SectionHead.astro';
import TestimonialCarousel from '../TestimonialCarousel.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import StatsBand from '../StatsBand.astro';
import { GENERAL_FAQS } from '../../data/faqs';
import { faqSchema, reviewSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';
import { translatePath, DEFAULT_LOCALE, DATE_TAG, type Locale } from '../../lib/i18n';
import { localizedEntries, entrySlug } from '../../lib/content';
import { uiFor } from '../../i18n/ui';
import { HOME } from '../../i18n/pages/home';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = HOME[locale];

const campusImg = (await import('../../assets/images/hero-campus-ink.jpg')).default;
const eduImg = (await import('../../assets/images/hero-education.jpg')).default;
const tourismImg = (await import('../../assets/images/hero-tourism.jpg')).default;
const tradeImg = (await import('../../assets/images/hero-trade.jpg')).default;

const posts = localizedEntries(await getCollection('blog'), locale)
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeFaqs = GENERAL_FAQS[locale].slice(0, 5);

// Corridor coordinates — single source of truth, same pattern as PageHero:
// the instrument labels below and the canvas-globe markers all derive from
// SITE.offices so the numbers can't drift from the rest of the site.
const OFFICES = [
  { code: 'DEL', city: SITE.offices[0].city, lat: SITE.offices[0].lat, lng: SITE.offices[0].lng },
  { code: 'CAN', city: SITE.offices[1].city, lat: SITE.offices[1].lat, lng: SITE.offices[1].lng },
];
const [DELHI, GUANGZHOU] = OFFICES;
// Passed to the client script via the globe canvas's data-markers attribute
// (the bundled script can't import SITE directly).
const globeMarkers = [
  { name: 'Delhi', lat: DELHI.lat, lon: DELHI.lng },
  { name: 'Guangzhou', lat: GUANGZHOU.lat, lon: GUANGZHOU.lng },
];

const stats = [
  { value: '500+', counter: '500', suffix: '+', label: t.stats.labels[0] },
  { value: '12+', counter: '12', suffix: '+', label: t.stats.labels[1] },
  { value: '98%', counter: '98', suffix: '%', label: t.stats.labels[2] },
  { value: '3', counter: '3', label: t.stats.labels[3] },
];

const pillars = [
  { n: '01', key: t.pillars.names[0], href: link('/education'), image: eduImg },
  { n: '02', key: t.pillars.names[1], href: link('/tourism'), image: tourismImg },
  { n: '03', key: t.pillars.names[2], href: link('/trade'), image: tradeImg },
].map((pillar, i) => ({ ...pillar, ...t.pillars.items[i] }));

const illuminated = t.illum.lines;

const tools = [
  { n: '01', href: link('/tools/fit-check'), ...t.tools.items[0] },
  { n: '02', href: link('/tools/scholarship-eligibility'), ...t.tools.items[1] },
  { n: '03', href: link('/tools/cost-calculator'), ...t.tools.items[2] },
  { n: '04', href: link('/tools/document-checklist'), ...t.tools.items[3] },
  { n: '05', href: link('/tools/timeline-planner'), ...t.tools.items[4] },
];
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/"
  jsonLd={[faqSchema(homeFaqs), reviewSchema(
    [{ author: 'Ananya Krishnan', reviewBody: 'RouteToAbroad didn\'t just find me a university; they found me a future.', rating: 5 }]
  )]}
>
  <!-- ============================================================
       1 · PINNED JOURNEY HERO — two 100vw slides on a flex track,
       translated by scroll progress; dashed route + paper plane
       driven from one rAF-throttled scroll handler.
       ============================================================ -->
  <section class="journey" id="journey" data-tone="light" aria-label={t.journey.aria}>
    <div class="journey-stage" id="journey-stage">
      <div class="journey-track" id="journey-track">
        <!-- Slide 1 · origin -->
        <div class="journey-slide slide-origin" id="slide-origin">
          <div class="slide-origin-inner" id="slide-origin-inner">
            <p class="journey-eyebrow">{t.journey.eyebrow}</p>
            <h1 class="journey-title">
              <span class="jline"><span class="jline-inner">{t.journey.titleLine1}</span></span>
              <span class="jline"><span class="jline-inner">{t.journey.titleLine2}</span></span>
              <span class="visually-hidden">{t.journey.titleHidden}</span>
            </h1>
            <p class="journey-sub">
              {t.journey.sub}
            </p>

            <div class="globe-wrap" id="globe-wrap">
              <canvas
                id="globe-canvas"
                class="globe"
                role="img"
                aria-label={t.journey.globeAria}
                data-markers={JSON.stringify(globeMarkers)}
              ></canvas>
            </div>

            <form class="origin-form" id="origin-form">
              <label class="origin-label" for="origin-input">{t.journey.originLabel}</label>
              <input
                class="origin-input"
                id="origin-input"
                name="origin"
                type="text"
                maxlength="60"
                autocomplete="address-level2"
                placeholder={t.journey.originPlaceholder}
              />
              <span class="origin-hint">{t.journey.originHint}</span>
            </form>

          </div>
        </div>

        <!-- Journey spacer -->
        <div class="journey-spacer" id="journey-spacer" aria-hidden="true"></div>

        <!-- Slide 2 · campus -->
        <div class="journey-slide slide-campus" id="slide-campus">
          <div class="slide-campus-inner">
            <p class="campus-kicker">{t.journey.campusKicker}</p>
            <p class="display campus-echo" aria-hidden="true">{t.journey.campusEcho}</p>
            <div class="campus-frame" id="campus-frame">
              <Picture
                src={campusImg}
                alt={t.journey.campusImgAlt}
                widths={[960, 1600, 2000]}
                sizes="(max-width: 64rem) 92vw, 66vw"
                formats={['avif', 'webp']}
                loading="lazy"
                class="campus-img"
              />
            </div>
            <p class="campus-coord num">Guangzhou · {GUANGZHOU.lat.toFixed(2)}°N / {GUANGZHOU.lng.toFixed(2)}°E</p>
            <div class="campus-foot" id="journey-cta">
              <p class="campus-lede">
                {t.journey.campusLede}
              </p>
              <div class="campus-actions">
                <a href={link('/tools/fit-check')} class="btn btn-primary">{t.journey.campusCtaPrimary}</a>
                <a href={link('/education')} class="btn btn-ghost">{t.journey.campusCtaSecondary}</a>
              </div>
              <p class="campus-note">{t.journey.campusNote}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Instrument coordinates, pinned to the stage -->
      <span class="stage-coord stage-coord--left" aria-hidden="true">{DELHI.lat.toFixed(2)}°N · {DELHI.code}</span>
      <span class="stage-coord stage-coord--right" aria-hidden="true">{GUANGZHOU.lng.toFixed(2)}°E · {GUANGZHOU.code}</span>

      <!-- Journey progress strip: fills the narrative gap between slides -->
      <div class="journey-strip" aria-hidden="true">
        <span class="js-stop is-active">01 {t.journey.stops[0]}</span>
        <span class="js-stop">02 {t.journey.stops[1]}</span>
        <span class="js-stop">03 {t.journey.stops[2]}</span>
        <span class="journey-strip-progress" id="journey-progress"></span>
      </div>

      <!-- Route overlay: dashed Bézier + paper plane -->
      <svg class="route-svg" id="route-svg" aria-hidden="true" focusable="false">
        <path id="route-path" d="" />
      </svg>
      <span class="plane" id="plane" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
          <path transform="rotate(-45 12 12)" d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"></path>
        </svg>
      </span>
    </div>
  </section>

  <!-- ============================================================
       2 · ILLUMINATED STATEMENT — words light up word-by-word
       ============================================================ -->
  <section class="illum" id="illum" data-tone="light" aria-label={t.illum.eyebrow}>
    <div class="illum-pin">
      <div class="illum-inner">
        <p class="eyebrow">{t.illum.eyebrow}</p>
        <div class="illum-lines">
          {illuminated.map((line) => (
            <div class="illum-row">
              <p class="display illum-line">
                {line.text.split(' ').map((w, i) => (
                  <span data-word style={`--wd: ${i * 110}ms`}>{w}{' '}</span>
                ))}
              </p>
              <p class="illum-gloss">{line.gloss}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 · PILLARS — numbered ruled rows
       ============================================================ -->
  <section class="section pillars" data-tone="light" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHead
        eyebrow={t.pillars.eyebrow}
        index={t.pillars.index}
        title={`<span id='pillars-title'>${t.pillars.title}</span>`}
        lede={t.pillars.lede}
      />
      <div class="pillar-rows">
        {pillars.map((p, i) => (
          <a href={p.href} class="pillar-row" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="pillar-id">
              <span class="pillar-n num">{p.n}</span>
              <h3 class="pillar-name">{p.key}</h3>
            </div>
            <div class="pillar-desc">
              <p class="pillar-lead">{p.lead}</p>
              <p class="pillar-text">{p.text}</p>
              <p class="pillar-stat num">{p.stat}</p>
            </div>
            <div class="pillar-media">
              <Picture
                src={p.image}
                alt={p.alt}
                widths={[480, 800]}
                sizes="(max-width: 64rem) 100vw, 30vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
            <span class="pillar-go arrow-link">{t.pillars.explore}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · PROOF STRIP -->
  <Marquee locale={locale} />

  <!-- 5 · STATS — black instrument band -->
  <div data-tone="dark">
    <StatsBand stats={stats} locale={locale} />
  </div>

  <!-- ============================================================
       6 · TOOLS — numbered ruled rows
       ============================================================ -->
  <section class="section tools" data-tone="light" aria-labelledby="tools-title">
    <div class="container">
      <SectionHead
        eyebrow={t.tools.eyebrow}
        index={t.tools.index}
        title={`<span id='tools-title'>${t.tools.title}</span>`}
        lede={t.tools.lede}
        action={{ href: link('/tools'), label: t.tools.action }}
      />
      <div class="tool-rows">
        {tools.map((t, i) => (
          <a href={t.href} class="tool-row" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="tool-n num">{t.n}</span>
            <span class="tool-body">
              <h3 class="tool-name">{t.label}</h3>
              <span class="tool-desc">{t.desc}</span>
            </span>
            <span class="tool-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       7 · INSIGHTS — featured posts as ruled rows
       ============================================================ -->
  <section class="section insights" data-tone="light" aria-labelledby="insights-title">
    <div class="container">
      <SectionHead
        eyebrow={t.insights.eyebrow}
        index={t.insights.index}
        title={`<span id='insights-title'>${t.insights.title}</span>`}
        lede={t.insights.lede}
        action={{ href: link('/blog'), label: t.insights.action }}
      />
      <div class="post-rows">
        {posts.map((post, i) => (
          <a href={link(`/blog/${entrySlug(post)}`)} class="post-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div class="post-body">
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <p class="post-meta">
                {post.data.pubDate.toLocaleDateString(DATE_TAG[locale], { month: 'short', year: 'numeric' })}
                {' '}· {uiFor(locale).categories[post.data.category]} · {t.insights.readTime.replace('{n}', String(post.data.readTime))}
              </p>
            </div>
            <div class="post-thumb">
              <Picture
                src={post.data.image}
                alt={post.data.imageAlt}
                widths={[320, 480]}
                sizes="(max-width: 64rem) 28vw, 176px"
                formats={['avif', 'webp']}
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 · TESTIMONIALS -->
  <div data-tone="light">
    <TestimonialCarousel locale={locale} />
  </div>

  <!-- ============================================================
       9 · FAQ
       ============================================================ -->
  <section class="section faq" data-tone="light" aria-labelledby="faq-title">
    <div class="container-wide faq-grid">
      <div class="faq-aside">
        <SectionHead
          eyebrow={t.faq.eyebrow}
          index={t.faq.index}
          title={`<span id='faq-title'>${t.faq.title}</span>`}
          lede={t.faq.lede}
        />
        <p class="faq-note">
          {t.faq.notePre}<a href={link('/faq')}>{t.faq.noteLink1}</a>{t.faq.noteMid}<a href={link('/contact')}>{t.faq.noteLink2}</a>{t.faq.notePost}
        </p>
      </div>
      <div class="faq-panel">
        <FaqAccordion faqs={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- 10 · CLOSE -->
  <div data-tone="dark">
    <CtaBand locale={locale} />
  </div>
</BaseLayout>

<style>
  /* ============================================================
     1 · PINNED JOURNEY HERO
     ============================================================ */
  .journey {
    position: relative;
    height: 300vh;
    background: var(--paper);
  }

  .journey-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .journey-track {
    display: flex;
    width: max-content;
    height: 100%;
    will-change: transform;
  }

  .journey-slide {
    position: relative;
    flex: 0 0 100vw;
    height: 100%;
  }

  .journey-spacer {
    flex: 0 0 18vw;
  }

  /* --- Slide 1 · origin --- */
  .slide-origin {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .slide-origin-inner {
    width: min(34rem, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 1.5rem 6.5rem;
  }

  .journey-eyebrow {
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 52%, transparent);
  }

  .journey-title {
    display: block;
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--ink);
  }

  .journey-sub {
    margin-top: 1.2rem;
    max-width: 38ch;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 62%, transparent);
    text-wrap: pretty;
  }

  .jline {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .jline-inner {
    display: block;
    transition:
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .jline:nth-of-type(2) .jline-inner {
    transition-delay: 0.1s;
  }

  /* Hidden only while Agent F's loader is set to play (html[data-loader]),
     until it dispatches 'rta:loaded' and we add .hero-in (or the 2.5s fallback). */
  :global(html[data-loader]) .journey:not(.hero-in) .jline-inner {
    transform: translateY(130%);
    opacity: 0;
  }

  .globe-wrap,
  .origin-form {
    opacity: 1;
    transition: opacity 0.9s ease 0.45s;
  }

  :global(html[data-loader]) .journey:not(.hero-in) .globe-wrap,
  :global(html[data-loader]) .journey:not(.hero-in) .origin-form {
    opacity: 0;
  }

  .globe-wrap {
    margin-top: clamp(1.4rem, 3.5dvh, 2.4rem);
    /* Rides the track with slide 1; the scroll driver only fades it
       (dissolved before the campus stage arrives). */
    will-change: opacity;
  }

  .globe {
    display: block;
    width: min(28vh, 224px);
    width: min(28dvh, 224px);
    height: min(28vh, 224px);
    height: min(28dvh, 224px);
    cursor: grab;
    touch-action: pan-y;
  }

  .globe:active {
    cursor: grabbing;
  }

  .origin-form {
    margin-top: clamp(1.2rem, 3dvh, 2rem);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .origin-label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: color-mix(in srgb, var(--ink) 62%, transparent);
  }

  .origin-input {
    margin-top: 0.8rem;
    width: min(18rem, 100%);
    padding: 0.45rem 0.25rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 0;
    font-size: 15px;
    text-align: center;
    color: var(--ink);
    outline: none;
    transition: border-color 0.25s ease;
  }

  .origin-input:focus {
    border-bottom-color: var(--ink);
    animation: origin-caret 1.6s ease-in-out infinite;
  }

  /* A soft signal pulse on the rule while the field is focused */
  @keyframes origin-caret {
    0%,
    100% {
      box-shadow: 0 1px 0 0 rgba(94, 120, 238, 0);
    }
    50% {
      box-shadow: 0 1px 0 0 rgba(94, 120, 238, 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-input:focus {
      animation: none;
    }
  }

  .origin-input::placeholder {
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .origin-hint {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  /* --- Slide 2 · campus --- */
  .slide-campus {
    display: flex;
  }

  .slide-campus-inner {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(4.5rem, 8dvh, 6rem) clamp(1.25rem, 5vw, 4rem) clamp(5rem, 8dvh, 6.5rem);
  }

  .campus-kicker {
    margin-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .campus-echo {
    margin: 0;
    font-size: clamp(2.4rem, 6.4vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.9;
    color: var(--ink);
  }

  .campus-coord {
    margin-top: 0.5rem;
    align-self: flex-end;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .campus-frame {
    margin-top: clamp(1.1rem, 2.4dvh, 1.8rem);
    width: min(64vw, 56rem);
    aspect-ratio: 2000 / 857;
    border: 1px solid var(--line);
    padding: 0.55rem;
    background: var(--paper-raised);
  }

  .campus-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Dark theme: the ink-line drawing is dark ink on light paper — multiply
     would sink it into the dark frame. Invert to light ink and screen-drop
     the (now dark) field instead. */
  :global(html[data-theme='dark']) .campus-img {
    mix-blend-mode: screen;
    filter: invert(1);
  }

  /* Footer reads as an instrument row: statement left, actions right,
     note underneath — rather than three centred blocks stacked. */
  .campus-foot {
    margin-top: auto;
    padding-top: clamp(1.1rem, 2.4dvh, 1.8rem);
    width: min(64vw, 56rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem 2rem;
    text-align: left;
  }

  .campus-lede {
    margin: 0;
    max-width: 48ch;
    font-size: 14px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .campus-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .campus-note {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }

  /* --- Stage instrument marks --- */
  .stage-coord {
    position: absolute;
    /* Sits above the vertical centre so the floating "Fit check" tab, which
       starts at 50% and hangs downward, never clips it. */
    top: 40%;
    z-index: 2;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--ink) 28%, transparent);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .stage-coord--left {
    left: 1.25rem;
    transform: translateY(-50%) rotate(180deg);
  }

  .stage-coord--right {
    right: 1.25rem;
  }

