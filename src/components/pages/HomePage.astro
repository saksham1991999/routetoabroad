<script>
  // ==================================================================
  // RouteToAbroad home — scroll narrative (vanilla TS, no libraries)
  //   1. Loader handoff (waits for Agent F's 'rta:loaded')
  //   2. Dotted globe (canvas, drag-to-spin, DPR-capped)
  //   3. Journey scroll driver (track, route Bézier, paper plane)
  //   4. Origin form → eased 2.8s flight through the journey
  //   5. Illuminated statement (word-by-word lighting)
  // ==================================================================

  import { initGlobe } from '../../scripts/globe';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeInOutQuart = (t: number) =>
    t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;

  /* ---------------- 1 · Loader handoff ----------------
     Starts hidden ONLY when Agent F's loader will play (html[data-loader]).
     Rises on 'rta:loaded', or after a 2.5s fallback timeout.
     No loader attr (repeat visit / RM) → CSS keeps everything visible. */
  (function initLoaderHandoff() {
    const journey = document.getElementById('journey');
    if (!journey || reduced) return;
    if (!document.documentElement.hasAttribute('data-loader')) return;
    let done = false;
    const rise = () => {
      if (done) return;
      done = true;
      journey.classList.add('hero-in');
    };
    window.addEventListener('rta:loaded', rise, { once: true });
    setTimeout(rise, 2500);
  })();

  /* ---------------- 2 · Dotted globe ---------------- */
  function mountGlobe() {
    const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    // Marker coordinates come from SITE.offices via the canvas's data-markers
    // attribute (built in the frontmatter) — no hardcoded lat/lng here.
    const markers = JSON.parse(canvas.dataset.markers || '[]') as Array<{
      name: string;
      lat: number;
      lon: number;
    }>;
    initGlobe(canvas, markers);
  }

  /* ---------------- 3 · Journey scroll driver ----------------
     ONE rAF-throttled scroll handler drives everything:
       p 0→0.34      slide-1 holds, globe centred under the copy
       p 0.28→0.5    copy fades out
       p 0.40→0.62   globe dissolves — it travels off with slide 1 and is
                     gone well before the campus arrives
       p 0.12→0.78   track translates -(slide1+spacer), campus arrives
       p 0.78→0.84   HELD FRAME: dotted route · university (no globe)
       p 0.84→0.95   plane + route dissolve onto the frame               */
  function initJourney() {
    if (reduced) return; // RM: static stacked layout, no driver at all
    const journey = document.getElementById('journey');
    const stage = document.getElementById('journey-stage');
    const track = document.getElementById('journey-track');
    const slideOrigin = document.getElementById('slide-origin');
    const originInner = document.getElementById('slide-origin-inner');
    const globeWrap = document.getElementById('globe-wrap');
    const slideCampus = document.getElementById('slide-campus');
    const campusFrame = document.getElementById('campus-frame');
    const spacer = document.getElementById('journey-spacer');
    const globeCanvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
    const routeSvg = document.getElementById('route-svg');
    const routePath = document.getElementById('route-path') as SVGPathElement | null;
    const plane = document.getElementById('plane');
    const journeyProgress = document.getElementById('journey-progress');
    const stops = Array.from(document.querySelectorAll<HTMLElement>('.js-stop'));
    if (
      !journey || !stage || !track || !slideOrigin || !originInner || !globeWrap ||
      !slideCampus || !campusFrame || !spacer || !globeCanvas || !routeSvg ||
      !routePath || !plane
    ) {
      return;
    }

    // The globe no longer docks: it stays in slide 1, travels off with the
    // track, and dissolves mid-transit so the campus stage (act 03) is
    // campus + route only. On narrow screens it dissolves the same way.
    const GLOBE_FADE_START = 0.4;
    const GLOBE_FADE_END = 0.62;
    const HELD_FADE_START = 0.84; // plane + route dissolve onto the frame

    // Copy that fades on scroll — everything in slide 1 except the globe,
    // which gets its own later fade window (see render).
    const fadeEls = Array.from(
      originInner.children
    ).filter((el): el is HTMLElement => el !== globeWrap && el instanceof HTMLElement);

    let stageH = 0;
    let shiftTotal = 0;
    let globe = { x: 0, y: 0, r: 0 };
    let target = { x: 0, y: 0 };
    let copyFaded = false;
    let ticking = false;

    /** Layout offset of `el` inside `ancestor` — ignores transforms, so it
        stays correct while the track is translated. */
    function offsetWithin(el: HTMLElement, ancestor: HTMLElement) {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;
      while (node && node !== ancestor) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    }

    // Cached on resize only — stage-local coordinates, independent of scroll.
    function measure() {
      stageH = stage!.offsetHeight;
      shiftTotal = slideOrigin!.offsetWidth + spacer!.offsetWidth;
      const g = offsetWithin(globeWrap!, slideOrigin!);
      const gw = globeWrap!.offsetWidth;
      globe = { x: g.x + gw / 2, y: g.y + globeWrap!.offsetHeight / 2, r: gw / 2 };

      const f = offsetWithin(campusFrame!, slideCampus!);
      // Land the route on the frame's top-left corner, not its top centre —
      // at the held frame the centre sits right under the display headline and
      // the dashed arc would cut through the type.
      target = {
        x: slideCampus!.offsetLeft + f.x + campusFrame!.offsetWidth * 0.08,
        y: f.y + campusFrame!.offsetHeight * 0.1,
      };
    }

    function render() {
      ticking = false;
      const rect = journey!.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < -80 || rect.top > vh + 80) return; // offscreen — skip work

      const span = Math.max(journey!.offsetHeight - vh, 1);
      const p = clamp01(-rect.top / span);

      // Overlap the origin fade with the track translation. The old
      // 0.15–0.30 gap faded the first slide before the second could enter,
      // leaving the pinned stage empty for ~45vh of scroll.
      const fade = 1 - clamp01((p - 0.28) / 0.22);
      if (p > 0.002) {
        // Inline styles only once scrolling starts, so the loader's intro
        // reveal (CSS, 0.45s delayed) is never overridden at p = 0.
        copyFaded = true;
        const vis = fade <= 0.01 ? 'hidden' : 'visible';
        for (const el of fadeEls) {
          el.style.opacity = fade.toFixed(3);
          el.style.visibility = vis;
        }
      } else if (copyFaded) {
        copyFaded = false;
        for (const el of fadeEls) {
          el.style.opacity = '';
          el.style.visibility = '';
        }
      }

      // The globe rides the track (no counter-transform) and dissolves on its
      // own window so the campus stage is always globe-free.
      const globeFade = 1 - clamp01((p - GLOBE_FADE_START) / (GLOBE_FADE_END - GLOBE_FADE_START));
      globeWrap!.style.opacity = globeFade.toFixed(3);
      globeWrap!.style.visibility = globeFade <= 0.01 ? 'hidden' : 'visible';

      // Route + plane fade in from the origin, then dissolve onto the held
      // frame so the campus view stays clean: no globe, no crossing line.
      const heldFade = 1 - clamp01((p - HELD_FADE_START) / 0.11);
      routeSvg!.style.opacity = (clamp01((p - 0.08) / 0.12) * heldFade).toFixed(3);

      // Track translation, eased, across p 0.12 → 0.78. It finishes just
      // before the held frame so the campus coord line is never clipped.
      const fp = clamp01((p - 0.12) / 0.66);
      const eased = easeInOutCubic(fp);
      const shift = shiftTotal * eased;
      track!.style.transform = `translate3d(${(-shift).toFixed(1)}px, 0, 0)`;

      // Persistent three-act strip
      if (journeyProgress) journeyProgress.style.transform = `scaleX(${p.toFixed(3)})`;
      const activeStop = p < 0.28 ? 0 : p < 0.8 ? 1 : 2;
      stops.forEach((stop, i) => stop.classList.toggle('is-active', i === activeStop));

      // Quadratic Bézier: travelling globe → campus frame. The start point
      // carries the track shift, so the dashed line keeps growing out of the
      // globe as it drifts off the left edge.
      const p0x = globe.x - shift + globe.r * 0.82;
      const p0y = globe.y - globe.r * 0.38;
      const p1x = target.x - shift;
      const p1y = target.y;
      const pcx = (p0x + p1x) / 2;
      const pcy = Math.min(p0y, p1y) - stageH * 0.3;
      routePath!.setAttribute(
        'd',
        `M ${p0x.toFixed(1)} ${p0y.toFixed(1)} Q ${pcx.toFixed(1)} ${pcy.toFixed(1)} ${p1x.toFixed(1)} ${p1y.toFixed(1)}`
      );

      // Plane: position P(t), rotation = tangent + 45° (glyph nose is pre-rotated -45°),
      // scale 0.85 → 1.45 → 1 on a sin curve.
      const planeOpacity = Math.min(clamp01((p - 0.15) / 0.15), 1 - clamp01((p - 0.84) / 0.11));
      plane!.style.opacity = planeOpacity.toFixed(3);
      if (planeOpacity > 0.001) {
        // t follows the SAME eased value as the track, so the plane lands
        // exactly on the campus frame when the translation completes.
        const t = eased;
        const px = (1 - t) * (1 - t) * p0x + 2 * (1 - t) * t * pcx + t * t * p1x;
        const py = (1 - t) * (1 - t) * p0y + 2 * (1 - t) * t * pcy + t * t * p1y;
        const dx = 2 * (1 - t) * (pcx - p0x) + 2 * t * (p1x - pcx);
        const dy = 2 * (1 - t) * (pcy - p0y) + 2 * t * (p1y - pcy);
        const ang = (Math.atan2(dy, dx) * 180) / Math.PI;
        const sc = 0.85 + 0.6 * Math.sin(Math.PI * t);
        plane!.style.transform = `translate(${(px - 12).toFixed(1)}px, ${(py - 12).toFixed(1)}px) rotate(${(ang + 45).toFixed(1)}deg) scale(${sc.toFixed(3)})`;
      }
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    measure();
    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      render();
    });
    window.addEventListener('load', () => {
      measure();
      render();
    });
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        measure();
        render();
      }).observe(stage!);
    }
  }

  /* ---------------- 4 · Origin form → the flight ----------------
     On submit, scroll the window to the held frame (dotted route ·
     university in one view) over ~2.8s with easeInOutQuart — the plane flies
     their answer. User wheel/touch input cancels the flight. Reduced motion:
     jump straight to the campus CTA. */
  function initOriginForm() {
    const form = document.getElementById('origin-form') as HTMLFormElement | null;
    const journey = document.getElementById('journey');
    const cta = document.getElementById('journey-cta');
    if (!form || !journey || !cta) return;

    // Matches the dock's resting point in initJourney.
    const HELD_FRAME = 0.8;

    let rafId = 0;
    let flying = false;
    const cancelFlight = () => {
      flying = false;
      cancelAnimationFrame(rafId);
    };
    window.addEventListener('wheel', cancelFlight, { passive: true });
    window.addEventListener('touchstart', cancelFlight, { passive: true });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (reduced || !matchMedia('(min-width: 64rem)').matches) {
        cta.scrollIntoView({ block: 'center' }); // instant under RM / mobile
        return;
      }
      const rect = journey!.getBoundingClientRect();
      const span = Math.max(journey!.offsetHeight - window.innerHeight, 1);
      const targetY = rect.top + window.scrollY + span * HELD_FRAME;
      const startY = window.scrollY;
      if (targetY - startY < 4) return; // already flown
      cancelFlight();
      flying = true;
      const t0 = performance.now();
      const DURATION = 2800;
      const step = (now: number) => {
        if (!flying) return;
        const t = Math.min((now - t0) / DURATION, 1);
        window.scrollTo(0, startY + (targetY - startY) * easeInOutQuart(t));
        if (t < 1) rafId = requestAnimationFrame(step);
        else flying = false;
      };
      rafId = requestAnimationFrame(step);
    });
  }

  /* ---------------- 5 · Illuminated statement ----------------
     Desktop: pinned (CSS) + scroll progress lights words sequentially.
     Mobile: no pin — IntersectionObserver adds .lit per row, words
     stagger via --wd transition-delay. Reduced motion: CSS forces lit. */
  function initIlluminated() {
    const section = document.getElementById('illum');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#illum .illum-row'));
    if (!section || !rows.length) return;
    const words = Array.from(section.querySelectorAll<HTMLElement>('[data-word]'));
    if (!words.length) return;

    if (reduced) return; // CSS keeps everything lit

    const pinned = matchMedia('(min-width: 64rem)').matches;

    if (!pinned) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            entry.target.classList.add('lit');
          }
        },
        { threshold: 0.35 }
      );
      rows.forEach((row) => io.observe(row));
      return;
    }

    const counts = rows.map((row) => row.querySelectorAll('[data-word]').length);
    const total = words.length;
    let ticking = false;

    function render() {
      ticking = false;
      const rect = section!.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;

      const span = Math.max(section!.offsetHeight - vh, 1);
      const p = clamp01(-rect.top / span);
      const lit = Math.round(total * clamp01((p - 0.1) / 0.72));

      let seen = 0;
      rows.forEach((row, ri) => {
        const rowLit = Math.max(0, Math.min(counts[ri], lit - seen));
        const ws = row.querySelectorAll<HTMLElement>('[data-word]');
        ws.forEach((w, wi) => {
          w.classList.toggle('is-lit', wi < rowLit);
        });
        if (rowLit >= counts[ri]) row.classList.add('lit');
        seen += counts[ri];
      });
    }

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    render();
  }

  mountGlobe();
  initJourney();
  initOriginForm();
  initIlluminated();
</script>
