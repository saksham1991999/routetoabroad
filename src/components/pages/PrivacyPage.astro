---
/**
 * Privacy policy page — shared by all five locales (route shells under
 * src/pages/ and src/pages/<locale>/ pass `locale`). All copy comes from the
 * per-locale dictionary in src/i18n/pages/privacy.ts; facts (email, phone,
 * office address) are interpolated from src/lib/site.ts, never inlined.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CURRENT_YEAR } from '../../lib/site';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import PageHero from '../PageHero.astro';
import { PRIVACY } from '../../i18n/pages/privacy';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = PRIVACY[locale];
const s = t.sections;
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/privacy"
  locale={locale}
  noindex={false}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="section">
    <div class="container-text legal">
      <p class="legal-updated num">{t.updated}</p>

      <h2>{s.collect.h}</h2>
      <p>{s.collect.p}</p>

      <h2>{s.never.h}</h2>
      <p>{s.never.p}</p>

      <h2>{s.storage.h}</h2>
      <p>{s.storage.p}</p>

      <h2>{s.forms.h}</h2>
      <p>{s.forms.p}</p>

      <h2>{s.retention.h}</h2>
      <p>{s.retention.p}</p>

      <h2>{s.rights.h}</h2>
      <p>
        {s.rights.pre}<a href={`mailto:${SITE.email}`}>{SITE.email}</a>{s.rights.post}
      </p>

      <h2>{s.contact.h}</h2>
      <p>
        {s.contact.label} {SITE.email} · {SITE.phoneIndia} · {SITE.offices[0].street}, {SITE.offices[0].city}.
      </p>

      <p class="legal-foot">© {CURRENT_YEAR} {SITE.name}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h2 {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 2.2rem;
  }

  .legal p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .legal a {
    color: var(--accent);
  }

  .legal-updated {
    font-size: 0.6875rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-foot {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
</style>
