---
/**
 * University profiles index — shared by all five locales (route shells under
 * src/pages/universities/ and src/pages/<locale>/universities/ pass `locale`).
 * All copy comes from the per-locale dictionary in
 * src/i18n/pages/universities-index.ts; entry cards render whatever the
 * localized collection carries (localizedEntries falls back to English),
 * hrefs use entrySlug and internal links localize through translatePath.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ArticleCard from '../ArticleCard.astro';
import CtaBand from '../CtaBand.astro';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { localizedEntries, entrySlug } from '../../lib/content';
import { UNIVERSITIES_INDEX } from '../../i18n/pages/universities-index';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localized page copy. */
const t = UNIVERSITIES_INDEX[locale];

const universities = localizedEntries(await getCollection('universities'), locale).sort(
  (a, b) => a.data.order - b.data.order
);

const universityItems = universities.map((u) => {
  const recognitions = u.data.recognitions ?? [];
  const programmes = u.data.programmes ?? [];
  const scholarships = u.data.scholarships ?? '';
  const faqText = (u.data.faqs ?? []).map((f) => `${f.question} ${f.answer}`).join(' ');
  const hasMbbs = u.data.type === 'medical' || programmes.some((p) => /mbbs/i.test(p));
  const hasWhoNmcMoe =
    recognitions.some((r) => /who|nmc|moe|wdoms/i.test(r)) || u.data.type === 'medical';
  const hasCsc =
    /csc/i.test(scholarships) ||
    recognitions.some((r) => /csc/i.test(r)) ||
    /csc/i.test(faqText);
  const searchBlob = [
    u.data.name,
    u.data.chineseName,
    u.data.city,
    u.data.type,
    ...programmes,
    ...recognitions,
    scholarships,
  ]
    .join(' ')
    .toLowerCase();

  return {
    entry: u,
    hasMbbs,
    hasWhoNmcMoe,
    hasCsc,
    searchBlob,
  };
});
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/universities"
  crumbs={[{ name: t.crumb, url: translatePath('/universities', locale) }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/universities', locale) }]}
    facts={t.hero.facts}
    actions={[{ href: translatePath('/contact', locale), label: t.hero.action }]}
  />

  <section class="section">
    <div class="container">
      <div class="uni-controls" data-uni-controls>
        <div class="uni-search-wrap">
          <label for="uni-search" class="sr-only">{t.controls.searchLabel}</label>
          <input
            id="uni-search"
            type="search"
            class="uni-search"
            placeholder={t.controls.searchPlaceholder}
            autocomplete="off"
            data-uni-search
          />
          <span class="uni-count num" data-uni-count data-count-suffix={t.controls.countSuffix}>
            {universityItems.length} / {universityItems.length} {t.controls.countSuffix}
          </span>
        </div>

        <div class="uni-pills" role="group" aria-label={t.controls.filterAriaLabel}>
          <button type="button" class="uni-pill is-active" data-uni-filter="all" aria-pressed="true">
            {t.controls.filters.all}
          </button>
          <button type="button" class="uni-pill" data-uni-filter="medical" aria-pressed="false">
            {t.controls.filters.medical}
          </button>
          <button type="button" class="uni-pill" data-uni-filter="comprehensive" aria-pressed="false">
            {t.controls.filters.comprehensive}
          </button>
          <button type="button" class="uni-pill" data-uni-filter="technical" aria-pressed="false">
            {t.controls.filters.technical}
          </button>
          <button type="button" class="uni-pill" data-uni-filter="who-nmc-moe" aria-pressed="false">
            {t.controls.filters.whoNmcMoe}
          </button>
          <button type="button" class="uni-pill" data-uni-filter="csc" aria-pressed="false">
            {t.controls.filters.csc}
          </button>
        </div>
      </div>

      <div class="uni-grid" data-uni-grid>
        {universityItems.map(({ entry: u, hasMbbs, hasWhoNmcMoe, hasCsc, searchBlob }) => (
          <div
            class="uni-item"
            data-uni-item
            data-type={u.data.type}
            data-mbbs={hasMbbs ? 'true' : 'false'}
            data-rec={hasWhoNmcMoe ? 'true' : 'false'}
            data-csc={hasCsc ? 'true' : 'false'}
            data-search={searchBlob}
          >
            <ArticleCard
              locale={locale}
              title={u.data.name}
              href={translatePath(`/universities/${entrySlug(u)}`, locale)}
              description={u.data.intro}
              image={u.data.image}
              imageAlt={u.data.imageAlt}
              tag={u.data.city}
              meta={`${t.card.estLabel} ${u.data.founded}`}
              pillar="education"
            />
          </div>
        ))}
      </div>

      <p class="uni-empty" data-uni-empty hidden>
        {t.controls.emptyState}
      </p>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="universities" />
</BaseLayout>

<script>
  function initUniversityDirectory() {
    const controls = document.querySelector('[data-uni-controls]');
    if (!controls) return;

    const searchInput = controls.querySelector<HTMLInputElement>('[data-uni-search]');
    const countEl = controls.querySelector<HTMLElement>('[data-uni-count]');
    const countSuffix = countEl?.dataset.countSuffix ?? '';
    const pills = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-uni-filter]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-uni-item]'));
    const emptyEl = document.querySelector<HTMLElement>('[data-uni-empty]');

    if (!searchInput || !items.length) return;

    let activeFilter = 'all';

    function matchesFilter(el: HTMLElement, filter: string): boolean {
      switch (filter) {
        case 'medical':
          return el.dataset.mbbs === 'true';
        case 'comprehensive':
          return el.dataset.type === 'comprehensive';
        case 'technical':
          return el.dataset.type === 'technical';
        case 'who-nmc-moe':
          return el.dataset.rec === 'true';
        case 'csc':
          return el.dataset.csc === 'true';
        default:
          return true;
      }
    }

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const terms = query ? query.split(/\s+/).filter(Boolean) : [];
      let visible = 0;

      for (const item of items) {
        const haystack = item.dataset.search ?? '';
        const matchesQuery = terms.every((term) => haystack.includes(term));
        const show = matchesQuery && matchesFilter(item, activeFilter);
        item.hidden = !show;
        if (show) visible += 1;
      }

      if (countEl) {
        countEl.textContent = countSuffix
          ? `${visible} / ${items.length} ${countSuffix}`
          : `${visible} / ${items.length}`;
      }
      if (emptyEl) {
        emptyEl.hidden = visible > 0;
      }
    }

    searchInput.addEventListener('input', applyFilters);

    for (const pill of pills) {
      pill.addEventListener('click', () => {
        activeFilter = pill.dataset.uniFilter ?? 'all';
        for (const p of pills) {
          const isCurrent = p === pill;
          p.classList.toggle('is-active', isCurrent);
          p.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
        }
        applyFilters();
      });
    }
  }

  initUniversityDirectory();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .uni-controls {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  .uni-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 0.25rem 0.9rem;
    transition: border-color 0.2s var(--ease-out);
  }

  .uni-search-wrap:focus-within {
    border-color: var(--accent);
  }

  .uni-search {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    padding: 0.65rem 0;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    outline: none;
  }

  .uni-search::placeholder {
    color: var(--ink-faint);
  }

  .uni-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .uni-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .uni-pill {
    appearance: none;
    background: var(--paper-raised);
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .uni-pill:hover {
    border-color: var(--ink-soft);
    color: var(--ink);
  }

  .uni-pill.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .uni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .uni-item {
    display: flex;
  }

  .uni-item[hidden] {
    display: none;
  }

  .uni-item > :global(.article-card) {
    width: 100%;
  }

  .uni-empty {
    margin-top: 2rem;
    padding: 2rem;
    text-align: center;
    color: var(--ink-soft);
    border: 1px dashed var(--line);
    border-radius: var(--radius-m);
    font-size: 0.95rem;
  }

  @media (max-width: 64rem) {
    .uni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .uni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
