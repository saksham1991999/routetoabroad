---
/**
 * University profiles index — shared by all five locales (route shells under
 * src/pages/universities/ and src/pages/<locale>/universities/ pass `locale`).
 * All copy comes from the per-locale dictionary in
 * src/i18n/pages/universities-index.ts; entry cards render whatever the
 * localized collection carries (localizedEntries falls back to English),
 * hrefs use entrySlug and internal links localize through translatePath.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ArticleCard from '../ArticleCard.astro';
import CtaBand from '../CtaBand.astro';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { localizedEntries, entrySlug } from '../../lib/content';
import { UNIVERSITIES_INDEX } from '../../i18n/pages/universities-index';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = UNIVERSITIES_INDEX[locale];

const universities = localizedEntries(await getCollection('universities'), locale).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/universities"
  crumbs={[{ name: t.crumb, url: link('/universities') }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/universities') }]}
    facts={t.hero.facts}
    actions={[{ href: link('/contact'), label: t.hero.action }]}
  />

  <section class="section">
    <div class="container">
      <div class="uni-grid">
        {universities.map((u) => (
          <ArticleCard
              locale={locale}
            title={u.data.name}
            href={link(`/universities/${entrySlug(u)}`)}
            description={u.data.intro}
            image={u.data.image}
            imageAlt={u.data.imageAlt}
            tag={u.data.city}
            meta={`${t.card.estLabel} ${u.data.founded}`}
            pillar="education"
          />
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="universities" />
</BaseLayout>

<style>
  .uni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 64rem) {
    .uni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .uni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
