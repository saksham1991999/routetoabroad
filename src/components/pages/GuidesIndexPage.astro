---
/**
 * Guides index page — shared by all five locales (route shells under
 * src/pages/guides/ and src/pages/<locale>/guides/ pass `locale`). All copy
 * comes from the per-locale dictionary in src/i18n/pages/guides-index.ts; the
 * guide list resolves through localizedEntries (localized copy or English
 * fallback) and links localize through translatePath.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ArticleCard from '../ArticleCard.astro';
import CtaBand from '../CtaBand.astro';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { localizedEntries, entrySlug } from '../../lib/content';
import { GUIDES_INDEX } from '../../i18n/pages/guides-index';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = GUIDES_INDEX[locale];

const guides = localizedEntries(await getCollection('guides'), locale).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pillarMeta: Record<string, { color: string; label: string }> = {
  education: { color: 'var(--edu)', label: t.sections.education },
  tourism: { color: 'var(--tourism)', label: t.sections.tourism },
  trade: { color: 'var(--trade)', label: t.sections.trade },
};

const byPillar = (['education', 'tourism', 'trade'] as const).map((p) => ({
  pillar: p,
  guides: guides.filter((g) => g.data.pillar === p),
}));
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/guides"
  locale={locale}
  crumbs={[{ name: t.crumb, url: link('/guides') }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/guides') }]}
  />

  {byPillar.map(({ pillar, guides: group }) =>
    group.length > 0 ? (
      <section class="section" aria-label={pillarMeta[pillar]!.label}>
        <div class="container">
          <div class="guide-pillar-head" style={`--pillar: ${pillarMeta[pillar]!.color}`}>
            <p class="eyebrow" style={`color: ${pillarMeta[pillar]!.color}`}>{pillarMeta[pillar]!.label}</p>
          </div>
          <div class="guide-grid">
            {group.map((g) => (
              <ArticleCard
              locale={locale}
                title={g.data.title}
                href={link(`/guides/${entrySlug(g)}`)}
                description={g.data.description}
                image={g.data.image}
                imageAlt={g.data.imageAlt}
                tag={t.categories[g.data.pillar]}
                pillar={g.data.pillar}
                meta={`${t.minShort.replace('{n}', String(g.data.readTime))}${g.data.updatedDate ? ` ${t.updatedSuffix}` : ''}`}
              />
            ))}
          </div>
        </div>
      </section>
    ) : null
  )}

  <CtaBand locale={locale} ctaKey="guides" />
</BaseLayout>

<style>
  .guide-pillar-head {
    border-left: 2px solid var(--pillar);
    padding-left: 1rem;
    margin-bottom: 1.6rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 64rem) {
    .guide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
