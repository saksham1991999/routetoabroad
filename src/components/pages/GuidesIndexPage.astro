---
/**
 * Guides index page — shared by all five locales (route shells under
 * src/pages/guides/ and src/pages/<locale>/guides/ pass `locale`). Page
 * structure and body copy are identical across locales by design; guide
 * links are localized through translatePath.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ArticleCard from '../ArticleCard.astro';
import CtaBand from '../CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pillarMeta: Record<string, { color: string; label: string }> = {
  education: { color: 'var(--edu)', label: 'Education guides' },
  tourism: { color: 'var(--tourism)', label: 'Travel guides' },
  trade: { color: 'var(--trade)', label: 'Trade guides' },
};

const byPillar = (['education', 'tourism', 'trade'] as const).map((p) => ({
  pillar: p,
  guides: guides.filter((g) => g.data.pillar === p),
}));
---

<BaseLayout
  title="Guides — Studying, Visas, Travel & Sourcing Explained"
  description="In-depth guides for the East Asia corridor: MBBS in China, CSC scholarships, student visas, HSK preparation, China and Japan travel, and China sourcing — answer-first and regularly updated."
  path="/guides"
  locale={locale}
  crumbs={[{ name: 'Guides', url: link('/guides') }]}
>
  <PageHero
    eyebrow="Guides"
    title="The reference shelf."
    lede="Long-form explainers written to be answers, not brochures — each one opens with the short answer, then earns it."
    crumbs={[{ name: 'Guides', url: link('/guides') }]}
  />

  {byPillar.map(({ pillar, guides: group }) =>
    group.length > 0 ? (
      <section class="section" aria-label={pillarMeta[pillar]!.label}>
        <div class="container">
          <div class="guide-pillar-head" style={`--pillar: ${pillarMeta[pillar]!.color}`}>
            <p class="eyebrow" style={`color: ${pillarMeta[pillar]!.color}`}>{pillarMeta[pillar]!.label}</p>
          </div>
          <div class="guide-grid">
            {group.map((g, i) => (
              <ArticleCard
                title={g.data.title}
                href={link(`/guides/${g.id}`)}
                description={g.data.description}
                image={g.data.image}
                imageAlt={g.data.imageAlt}
                tag={g.data.pillar}
                pillar={g.data.pillar}
                meta={`${g.data.readTime} min${g.data.updatedDate ? ' · updated' : ''}`}
              />
            ))}
          </div>
        </div>
      </section>
    ) : null
  )}

  <CtaBand locale={locale} ctaKey="guides" />
</BaseLayout>

<style>
  .guide-pillar-head {
    border-left: 2px solid var(--pillar);
    padding-left: 1rem;
    margin-bottom: 1.6rem;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 64rem) {
    .guide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
