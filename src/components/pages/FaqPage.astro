---
/**
 * FAQ hub page — shared by all five locales (route shells under src/pages/
 * and src/pages/<locale>/ pass `locale`). All copy comes from the per-locale
 * dictionary in src/i18n/pages/faq.ts; the Q&A sets come from
 * src/data/faqs.ts (Record<Locale, Faq[]>) and feed both the accordions and
 * the FAQPage JSON-LD. Internal links localize through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { EDUCATION_FAQS, TOURISM_FAQS, TRADE_FAQS, GENERAL_FAQS } from '../../data/faqs';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { faqSchema } from '../../lib/schema';
import { FAQ } from '../../i18n/pages/faq';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = FAQ[locale];

const all = [...GENERAL_FAQS[locale], ...EDUCATION_FAQS[locale], ...TOURISM_FAQS[locale], ...TRADE_FAQS[locale]];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/faq"
  locale={locale}
  crumbs={[{ name: t.crumb, url: translatePath('/faq', locale) }]}
  jsonLd={[faqSchema(all)]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/faq', locale) }]}
  />

  <section class="section">
    <div class="container-faq">
      <section aria-labelledby="general-h">
        <h2 id="general-h" class="faq-h">{t.groups.general.heading}</h2>
        <FaqAccordion faqs={GENERAL_FAQS[locale]} />
      </section>

      <section aria-labelledby="edu-h" class="faq-group">
        <p class="eyebrow">{t.groups.education.eyebrow}</p>
        <h2 id="edu-h" class="faq-h">{t.groups.education.heading}</h2>
        <FaqAccordion faqs={EDUCATION_FAQS[locale]} />
        <a href={translatePath('/education/faq', locale)} class="arrow-link faq-link">{t.groups.education.link}</a>
      </section>

      <section aria-labelledby="tour-h" class="faq-group">
        <p class="eyebrow">{t.groups.tourism.eyebrow}</p>
        <h2 id="tour-h" class="faq-h">{t.groups.tourism.heading}</h2>
        <FaqAccordion faqs={TOURISM_FAQS[locale]} />
        <a href={translatePath('/tourism/faq', locale)} class="arrow-link faq-link">{t.groups.tourism.link}</a>
      </section>

      <section aria-labelledby="trade-h" class="faq-group">
        <p class="eyebrow">{t.groups.trade.eyebrow}</p>
        <h2 id="trade-h" class="faq-h">{t.groups.trade.heading}</h2>
        <FaqAccordion faqs={TRADE_FAQS[locale]} />
        <a href={translatePath('/trade/faq', locale)} class="arrow-link faq-link">{t.groups.trade.link}</a>
      </section>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="faqHub" />
</BaseLayout>

<style>
  .container-faq {
    width: min(var(--container-text), 100% - var(--gutter) * 2);
    margin-inline: auto;
  }

  .faq-h {
    font-size: var(--step-3);
    margin-bottom: 1rem;
  }

  .faq-group {
    margin-top: 3.5rem;
  }

  .faq-group .faq-h {
    margin-top: 0.5rem;
  }

  .faq-link {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.9rem;
  }
</style>
