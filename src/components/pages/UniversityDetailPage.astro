---
/**
 * universities detail page — shared by all five locales. Route shells under
 * src/pages/universities/[slug].astro and src/pages/<locale>/universities/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the locale-resolved collection entry (rendered as-is — entry frontmatter may
 * be English fallback or localized). Template chrome comes from the per-locale
 * dictionary in src/i18n/pages/university-detail.ts; links localize through
 * translatePath and slugs always come from entrySlug, never raw entry.id.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { faqSchema, courseSchema } from '../../lib/schema';


import { translatePath, DEFAULT_LOCALE, localizeHtmlLinks, type Locale } from '../../lib/i18n';
import { entrySlug } from '../../lib/content';
import { UNIVERSITY_DETAIL } from '../../i18n/pages/university-detail';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale?: Locale;
  university: CollectionEntry<'universities'>;
}
const { locale = DEFAULT_LOCALE, university } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = UNIVERSITY_DETAIL[locale];
const slug = entrySlug(university);
const { data } = university;
const { Content } = await render(university);
const faqs = data.faqs ?? [];
const hasBody = Boolean(university.body && university.body.trim());
---

<BaseLayout
  locale={locale}
  title={t.metaTitleTemplate.replace('{name}', data.name)}
  description={data.intro}
  path={`/universities/${slug}`}
  crumbs={[
    { name: t.crumb, url: link('/universities') },
    { name: data.name, url: `${SITE.url}${link(`/universities/${slug}`)}` },
  ]}
  jsonLd={[
    courseSchema({
      name: t.schemaStudyAtTemplate.replace('{name}', data.name),
      description: data.intro,
      url: `${SITE.url}${link(`/universities/${slug}`)}`,
      // The provider is the university itself, not the consultancy.
      providerName: data.name,
      providerUrl: `${SITE.url}${link(`/universities/${slug}`)}`,
    }),
    faqSchema(faqs),
  ]}
>
  <article>
    <header class="u-hero">
      <div class="container">
        <Breadcrumbs
          crumbs={[
            { name: t.crumb, url: link('/universities') },
            { name: data.name, url: link(`/universities/${slug}`) },
          ]}
        />
        <p class="eyebrow">{data.chineseName}</p>
        <h1>{data.name}</h1>
        {data.nickname && <p class="u-nickname">{data.nickname}</p>}
        <p class="u-intro">{data.intro}</p>
      </div>
    </header>

    <div class="u-media">
      <Picture
        src={data.image}
        alt={data.imageAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <section class="section">
      <div class="container u-grid">
        <div class="u-main">
          <section aria-labelledby="strengths-h">
            <h2 id="strengths-h">{t.headings.why}</h2>
            <div class="strengths">
              {data.strengths.map((s) => (
                <div class="strength" data-reveal>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              ))}
            </div>
          </section>

          <section aria-labelledby="prog-h" class="u-section">
            <h2 id="prog-h">{t.headings.programmes}</h2>
            <ul class="prog-list">
              {data.programmes.map((p) => <li>{p}</li>)}
            </ul>
          </section>

          {hasBody && (
            <section class="prose u-section">{university.rendered?.html ? <Fragment set:html={localizeHtmlLinks(university.rendered.html, locale)} /> : <Content />}</section>
          )}

          {faqs.length > 0 && (
            <section class="u-section" aria-labelledby="faq-h">
              <h2 id="faq-h">{t.headings.faqTemplate.replace('{name}', data.name)}</h2>
              <FaqAccordion faqs={faqs} />
            </section>
          )}
        </div>

        <aside class="u-side">
          <div class="u-card card card-pad" data-reveal>
            <h2>{t.costs.title}</h2>
            <dl class="costs">
              <div><dt>{t.costs.tuition}</dt><dd>{data.costs.tuition}</dd></div>
              <div><dt>{t.costs.dormitory}</dt><dd>{data.costs.dorm}</dd></div>
              <div><dt>{t.costs.living}</dt><dd>{data.costs.living}</dd></div>
            </dl>
            <a href={link('/tools/cost-calculator')} class="btn btn-outline btn-sm">{t.costs.estimateCta}</a>
          </div>

          <div class="u-card card card-pad" data-reveal>
            <h2>{t.facts.title}</h2>
            <dl class="facts">
              {data.facts.map((f) => (
                <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
              ))}
            </dl>
          </div>

          <div class="u-cta card card-pad" data-reveal>
            <h2>{t.cta.title}</h2>
            <p>{t.cta.text}</p>
            <a href={link('/education#apply')} class="btn btn-primary btn-sm">{t.cta.button}</a>
          </div>
        </aside>
      </div>
    </section>

    <CtaBand locale={locale} />
  </article>
</BaseLayout>

<style>
  .u-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .u-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .u-nickname {
    margin-top: 0.7rem;
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  .u-intro {
    margin-top: 1.2rem;
    max-width: 42rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .u-media {
    max-height: 56vh;
    overflow: hidden;
  }

  .u-media :global(img) {
    width: 100%;
    height: 100%;
    max-height: 56vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .u-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .u-main h2 {
    font-size: var(--step-3);
    margin-bottom: 1.4rem;
  }

  .u-section {
    margin-top: 3rem;
  }

  .strengths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
  }

  .strength {
    padding: 1.3rem 1.4rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .strength h3 {
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .strength p {
    margin-top: 0.45rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .prog-list {
    padding-left: 1.3em;
    display: grid;
    gap: 0.5rem;
  }

  .prog-list li::marker {
    color: var(--accent);
    font-weight: 700;
  }

  .u-side {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.2rem;
  }

  .u-card h2,
  .u-cta h2 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .costs div,
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .costs div:last-child,
  .facts div:last-child {
    border-bottom: 0;
  }

  .costs dd,
  .facts dd {
    margin: 0;
    text-align: right;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .u-card .btn {
    margin-top: 0.9rem;
    width: 100%;
  }

  .u-cta {
    background: #f0f0f0;
  }

  :global([data-theme='dark']) .u-cta {
    background: var(--paper-sunken);
  }

  .u-cta p {
    margin: 0.5rem 0 1rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  @media (max-width: 64rem) {
    .u-grid {
      grid-template-columns: 1fr;
    }
    .u-side {
      position: static;
    }
    .strengths {
      grid-template-columns: 1fr;
    }
  }
</style>
