---
/**
 * Terms of service page — shared by all five locales (route shells under
 * src/pages/ and src/pages/<locale>/ pass `locale`). All copy comes from the
 * per-locale dictionary in src/i18n/pages/terms.ts; facts (email, phone,
 * office address) are interpolated from src/lib/site.ts, never inlined.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CURRENT_YEAR } from '../../lib/site';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import PageHero from '../PageHero.astro';
import { TERMS } from '../../i18n/pages/terms';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = TERMS[locale];
const s = t.sections;
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/terms"
  locale={locale}
>
  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

  <section class="section">
    <div class="container-text legal">
      <p class="legal-updated num">{t.updated}</p>

      <h2>{s.services.h}</h2>
      <p>{s.services.p}</p>

      <h2>{s.noGuarantee.h}</h2>
      <ul>
        {s.noGuarantee.items.map((item) => (
          <li><strong>{item.strong}</strong>{item.text}</li>
        ))}
      </ul>

      <h2>{s.obligations.h}</h2>
      <p>
        {s.obligations.pre}<strong>{s.obligations.strong}</strong>{s.obligations.post}
      </p>

      <h2>{s.fees.h}</h2>
      <p>{s.fees.p}</p>

      <h2>{s.cancellations.h}</h2>
      <p>{s.cancellations.p}</p>

      <h2>{s.tools.h}</h2>
      <p>{s.tools.p}</p>

      <h2>{s.liability.h}</h2>
      <p>{s.liability.p}</p>

      <h2>{s.law.h}</h2>
      <p>{s.law.p}</p>

      <h2>{s.contact.h}</h2>
      <p>
        {SITE.email} · {SITE.phoneIndia} · {SITE.offices[0].street}, {SITE.offices[0].city} {SITE.offices[0].postal}.
      </p>

      <p class="legal-foot">© {CURRENT_YEAR} {SITE.name}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal h2 {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 2.2rem;
  }

  .legal p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .legal ul {
    margin-top: 1rem;
    padding-left: 1.4em;
    display: grid;
    gap: 0.7rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .legal ul li::marker {
    color: var(--accent-text);
  }

  .legal-updated {
    font-size: 0.6875rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .legal-foot {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
</style>
