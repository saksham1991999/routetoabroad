---
/**
 * Cities index page — shared by all five locales (route shells under
 * src/pages/cities/ and src/pages/<locale>/cities/ pass `locale`). All copy
 * comes from the per-locale dictionary in src/i18n/pages/cities-index.ts;
 * entry cards render whatever the localized collection carries
 * (localizedEntries falls back to English), hrefs use entrySlug and internal
 * links localize through translatePath.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { localizedEntries, entrySlug } from '../../lib/content';
import { CITIES_INDEX } from '../../i18n/pages/cities-index';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = CITIES_INDEX[locale];

const cities = localizedEntries(await getCollection('cities'), locale).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/cities"
  locale={locale}
  crumbs={[{ name: t.crumb, url: link('/cities') }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/cities') }]}
  />

  <section class="section">
    <div class="container">
      <div class="city-grid">
        {cities.map((c, i) => (
          <a href={link(`/cities/${entrySlug(c)}`)} class="city-card" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms`}>
            <div class="city-media">
              <Picture src={c.data.image} alt={c.data.imageAlt} widths={[640, 1024]} sizes="(max-width: 64rem) 100vw, 50vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="city-body">
              <div class="city-title-row">
                <h2>{c.data.name}</h2>
                <span class="num city-zh">{c.data.chineseName}</span>
              </div>
              <p>{c.data.intro}</p>
              <div class="city-costs num">
                <span>{t.card.studentsLabel} ${c.data.studentMonthly.low}–{c.data.studentMonthly.high}{t.card.perMonth}</span>
                <span>{t.card.travellersLabel} ${c.data.touristDaily.low}–{c.data.touristDaily.high}{t.card.perDay}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="cities" />
</BaseLayout>

<style>
  .city-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .city-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    transition: border-color 0.2s var(--ease-out);
  }

  .city-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .city-media {
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .city-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
    transition: transform 0.5s var(--ease-out);
  }

  .city-card:hover .city-media :global(img) {
    transform: scale(1.03);
  }

  .city-body {
    padding: 1.6rem 1.7rem 1.8rem;
  }

  .city-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .city-title-row h2 {
    font-size: var(--step-3);
  }

  .city-zh {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .city-body > p {
    margin-top: 0.7rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .city-costs {
    margin-top: 1.1rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 64rem) {
    .city-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
