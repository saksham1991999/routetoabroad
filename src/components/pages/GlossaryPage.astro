---
/**
 * Glossary page — shared by all five locales (route shells under src/pages/
 * and src/pages/<locale>/ pass `locale`). All page copy comes from the
 * per-locale dictionary in src/i18n/pages/glossary.ts; the terms come from
 * src/data/glossary.ts (Record<Locale, GlossaryTerm[]>) and feed both the
 * definition list and the DefinedTerm JSON-LD. Term names keep their
 * canonical form across locales, so anchors (`#slug`) stay stable.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import { GLOSSARY } from '../../data/glossary';
import { definedTermSchemas } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { GLOSSARY_PAGE } from '../../i18n/pages/glossary';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = GLOSSARY_PAGE[locale];
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
const terms = GLOSSARY[locale];

const categories = (
  [
    { key: 'education', label: t.categories.education },
    { key: 'visas', label: t.categories.visas },
    { key: 'exams', label: t.categories.exams },
    { key: 'travel', label: t.categories.travel },
    { key: 'trade', label: t.categories.trade },
  ] as const
);

const grouped = categories.map((cat) => ({
  ...cat,
  terms: terms.filter((term) => term.category === cat.key),
}));
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/glossary"
  locale={locale}
  crumbs={[{ name: t.crumb, url: link('/glossary') }]}
  jsonLd={[...definedTermSchemas(terms.map((term) => ({ term: term.term, definition: term.definition })))]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/glossary') }]}
  />

  <section class="section">
    <div class="container-text">
      <nav class="glossary-toc" aria-label={t.tocAria}>
        {grouped.map((g) => (
          <a href={`#${g.key}`} class="chip">{g.label} ({g.terms.length})</a>
        ))}
      </nav>

      {grouped.map((g) => (
        <section class="glossary-group" id={g.key} aria-labelledby={`h-${g.key}`}>
          <h2 id={`h-${g.key}`}>{g.label}</h2>
          <dl class="glossary-list">
            {g.terms.map((term) => (
              <div class="term" id={term.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')} data-reveal>
                <dt>
                  {term.term}
                  {term.zh && <span class="term-zh num">{term.zh}</span>}
                </dt>
                <dd>{term.definition}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <p class="glossary-note">
        {t.notePre}<a href={link('/contact')}>{t.noteLink}</a>{t.notePost}
      </p>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="glossary" />
</BaseLayout>

<style>
  .glossary-toc {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .glossary-toc .chip {
    text-decoration: none;
  }

  .glossary-toc .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .glossary-group {
    margin-top: 3rem;
    scroll-margin-top: 6rem;
  }

  .glossary-group h2 {
    font-size: var(--step-3);
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--ink);
  }

  .glossary-list {
    margin: 0;
  }

  .term {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .term dt {
    font-weight: 500;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .term-zh {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }

  .term dd {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
    font-size: 0.96rem;
  }

  .glossary-note {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .glossary-note a {
    color: var(--accent);
  }
</style>
