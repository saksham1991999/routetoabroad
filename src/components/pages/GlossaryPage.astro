---
/**
 * Glossary page — shared by all five locales (route shells under src/pages/
 * and src/pages/<locale>/ pass `locale`). Page structure and body copy are
 * identical across locales by design; internal links are localized through
 * translatePath. The terms data lives in src/data/glossary.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { GLOSSARY } from '../../data/glossary';
import { definedTermSchemas } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);

const categories = [
  { key: 'education', label: 'Education' },
  { key: 'visas', label: 'Visas' },
  { key: 'exams', label: 'Exams & Language' },
  { key: 'travel', label: 'Travel' },
  { key: 'trade', label: 'Trade' },
] as const;

const grouped = categories.map((cat) => ({
  ...cat,
  terms: GLOSSARY.filter((t) => t.category === cat.key),
}));
---

<BaseLayout
  title="Glossary — CSC, JW202, HSK, AQL & East Asia Terms Explained"
  description="Plain-English definitions for the terms of studying, travelling and trading across East Asia: CSC scholarship, JW202, X1 visa, HSK, AQL, Bill of Lading, Canton Fair and more."
  path="/glossary"
  locale={locale}
  crumbs={[{ name: 'Glossary', url: link('/glossary') }]}
  jsonLd={[...definedTermSchemas(GLOSSARY.map((t) => ({ term: t.term, definition: t.definition })))]}
>
  <PageHero
    eyebrow="Glossary"
    title="Every acronym, in plain English."
    lede="The vocabulary of the corridor — defined the way we explain them on calls. Anchors below; link straight to any term."
    crumbs={[{ name: 'Glossary', url: link('/glossary') }]}
  />

  <section class="section">
    <div class="container-text">
      <nav class="glossary-toc" aria-label="Glossary categories">
        {grouped.map((g) => (
          <a href={`#${g.key}`} class="chip">{g.label} ({g.terms.length})</a>
        ))}
      </nav>

      {grouped.map((g) => (
        <section class="glossary-group" id={g.key} aria-labelledby={`h-${g.key}`}>
          <h2 id={`h-${g.key}`}>{g.label}</h2>
          <dl class="glossary-list">
            {g.terms.map((t) => (
              <div class="term" id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')} data-reveal>
                <dt>
                  {t.term}
                  {t.zh && <span class="term-zh num">{t.zh}</span>}
                </dt>
                <dd>{t.definition}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <p class="glossary-note">
        Something missing? <a href={link('/contact')}>Tell us</a> and we'll add it — the glossary grows with every intake.
      </p>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="glossary" />
</BaseLayout>

<style>
  .glossary-toc {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .glossary-toc .chip {
    text-decoration: none;
  }

  .glossary-toc .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .glossary-group {
    margin-top: 3rem;
    scroll-margin-top: 6rem;
  }

  .glossary-group h2 {
    font-size: var(--step-3);
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--ink);
  }

  .glossary-list {
    margin: 0;
  }

  .term {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .term dt {
    font-weight: 500;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .term-zh {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }

  .term dd {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
    font-size: 0.96rem;
  }

  .glossary-note {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .glossary-note a {
    color: var(--accent);
  }
</style>
