---
/**
 * About page — shared by all five locales (route shells under src/pages/
 * and src/pages/<locale>/ pass `locale`). All copy comes from the
 * ABOUT dictionary in src/i18n/pages/about.ts; chrome strings come from
 * uiFor(locale) and internal links are localized through translatePath.
 * The founders array lives in src/data/founders.ts (single source — it was
 * once deleted from the per-page copies by a bad edit); names/roles/bios
 * resolve per locale from src/data/authors.ts.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { ABOUT } from '../../i18n/pages/about';
import { SITE, CLAIMS } from '../../lib/site';
import { FOUNDERS } from '../../data/founders';
import { AUTHORS } from '../../data/authors';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { personSchema } from '../../lib/schema';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const t = ABOUT[locale];
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);

const founders = FOUNDERS[locale];
const founderLead = AUTHORS.minhaj;
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/about"
  locale={locale}
  crumbs={[{ name: t.crumb, url: link('/about') }]}
  jsonLd={founders.map((f) =>
    personSchema({
      name: f.name,
      jobTitle: f.role,
      url: f.linkedin,
      sameAs: f.linkedin ? [f.linkedin] : undefined,
      description: f.bio,
    })
  )}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/about') }]}
    facts={t.hero.facts}
    actions={[
      { href: '#team', label: t.hero.actionTeam },
      { href: link('/contact'), label: t.hero.actionTalk, variant: 'outline' },
    ]}
    jumps={[
      { href: '#story', label: t.hero.jumps[0] },
      { href: '#values', label: t.hero.jumps[1] },
      { href: '#team', label: t.hero.jumps[2] },
    ]}
  />

  <section class="section" id="story">
    <div class="container story-grid">
      <div class="story" data-reveal>
        <p class="story-lead">
          {t.story.lead}
        </p>
        <p set:html={t.story.built} />
        <blockquote>
          {t.story.quote}
          <cite>— {founderLead.name}, {founderLead.role[locale]}</cite>
        </blockquote>
        <p>
          {t.story.after}
        </p>
      </div>

      <aside class="nap card card-pad" data-reveal="right" aria-label={t.nap.aria}>
        <p class="eyebrow">{t.nap.eyebrow}</p>
        <dl class="nap-list num">
          <div><dt>{t.nap.foundedLabel}</dt><dd>{SITE.founded} {t.nap.foundedNote}</dd></div>
          <div><dt>{t.nap.officesLabel}</dt><dd>{SITE.offices[0].city} · {SITE.offices[1].city}</dd></div>
          <div><dt>{t.nap.emailLabel}</dt><dd>{SITE.email}</dd></div>
          <div><dt>{t.nap.phoneLabel}</dt><dd><bdi>{SITE.phoneIndia}</bdi></dd></div>
          <div><dt>{t.nap.hoursLabel}</dt><dd><bdi>{ui.footer.hoursValue}</bdi></dd></div>
          <div><dt>{t.nap.studentsLabel}</dt><dd>{CLAIMS.studentsPlaced}</dd></div>
          <div><dt>{t.nap.ratingLabel}</dt><dd>{CLAIMS.googleRating} ★</dd></div>
        </dl>
        <p class="nap-note">{t.nap.note}</p>
      </aside>
    </div>
  </section>

  <section class="section section-sunken" id="values">
    <div class="container">
      <SectionHead
        eyebrow={t.values.eyebrow}
        index={t.values.index}
        title={t.values.title}
        lede={t.values.lede}
      />
      <div class="values-grid">
        {t.values.items.map((v, i) => (
          <article class="value card card-pad" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="team">
    <div class="container">
      <SectionHead
        eyebrow={t.team.eyebrow}
        index={t.team.index}
        title={t.team.title}
        lede={t.team.lede}
      />
      <div class="team-grid">
        {founders.map((f, i) => (
          <article class="member card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="member-photo">
              <Picture src={f.image} alt={t.team.portraitAlt.replace('{name}', f.name)} widths={[480, 800]} sizes="(max-width: 64rem) 100vw, 50vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="member-body">
              <h3>{f.name}</h3>
              <p class="member-role">{f.role}</p>
              <p class="member-bio">{f.bio}</p>
              <ul class="member-points">
                {f.points.map((pt) => <li>{pt}</li>)}
              </ul>
              {/* Social profile links are commented out for now — restore when
                  the team's LinkedIn pages go live.
              {f.linkedin && (
                <a href={f.linkedin} class="arrow-link member-link" rel="noopener">LinkedIn profile</a>
              )}
              */}
            </div>
          </article>
        ))}
      </div>
      <p class="team-note">
        {t.team.notePre}<a href={link('/blog')}>{t.team.noteLink}</a>{t.team.notePost}
      </p>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="about" />
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .story {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .story-lead {
    font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.45;
    color: var(--ink);
  }

  .story p + p {
    margin-top: 1.2rem;
  }

  .story blockquote {
    margin: 1.8rem 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--accent);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--ink);
  }

  .story cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .nap {
    position: sticky;
    top: 6rem;
    background: var(--paper-raised);
  }

  .nap-list {
    margin: 1rem 0 0;
  }

  .nap-list div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .nap-list div:last-of-type {
    border-bottom: 0;
  }

  .nap-list dt {
    color: var(--ink-faint);
    font-weight: 500;
  }

  .nap-list dd {
    margin: 0;
    text-align: end;
    font-weight: 600;
  }

  .nap-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
    font-family: var(--font-body);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .value h3 {
    font-size: 1.25rem;
  }

  .value p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .member {
    overflow: hidden;
    max-width: 44rem;
    margin-inline: auto;
  }

  .member-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .member-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(15%) contrast(1.05);
  }

  .member-body {
    padding: 1.5rem 1.6rem 1.7rem;
  }

  .member-body h3 {
    font-size: 1.4rem;
  }

  .member-role {
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .member-bio {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .member-points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .member-points li::before {
    content: '—';
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .member-link {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.9rem;
  }

  .team-note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .team-note a {
    color: var(--accent);
  }

  @media (max-width: 64rem) {
    .story-grid,
    .values-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
    .nap {
      position: static;
    }
  }
</style>
