---
/**
 * compare detail page — shared by all five locales. Route shells under
 * src/pages/compare/[slug].astro and src/pages/<locale>/compare/[slug].astro
 * pass `locale` and the EN entry as `c` (slugs are identical across locales);
 * the locale's own copy is resolved from COMPARISONS[locale] below, falling
 * back to the English set if the slug is somehow missing. Template chrome
 * comes from the per-locale dictionary in src/i18n/pages/compare-detail.ts;
 * links localize through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import FaqAccordion from '../FaqAccordion.astro';
import { COMPARISONS, type Comparison } from '../../data/comparisons';
import { faqSchema } from '../../lib/schema';


import { translatePath, DEFAULT_LOCALE, DATE_TAG, type Locale } from '../../lib/i18n';
import { COMPARE_DETAIL } from '../../i18n/pages/compare-detail';

interface Props {
  locale?: Locale;
  /** EN entry passed by the route shell — ignored; we resolve the locale copy. */
  c?: Comparison;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = COMPARE_DETAIL[locale];
/** This locale's comparison entry (same slugs across locales). */
const slug = Astro.params.slug;
const c =
  COMPARISONS[locale].find((x) => x.slug === slug) ??
  COMPARISONS.en.find((x) => x.slug === slug) ??
  COMPARISONS.en[0];
// Date-only stamps are UTC midnights; format in UTC so the rendered
// calendar day matches the stored date regardless of build timezone.
const updated = new Date(`${c.updated}T00:00:00Z`).toLocaleDateString(DATE_TAG[locale], { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  locale={locale}
  title={c.title}
  description={c.answer}
  path={`/compare/${c.slug}`}
  type="article"
  crumbs={[
    { name: t.crumb, url: link('/compare') },
    { name: c.headline, url: `${SITE.url}${link(`/compare/${c.slug}`)}` },
  ]}
  jsonLd={[faqSchema(c.faqs)]}
>
  <article class="container-text compare-article">
    <header>
      <Breadcrumbs
        crumbs={[
          { name: t.crumb, url: link('/compare') },
          { name: c.headline, url: link(`/compare/${c.slug}`) },
        ]}
      />
      <p class="eyebrow">{t.eyebrow.comparison} · {t.eyebrow.updated} {updated}</p>
      <h1>{c.headline}</h1>
      <div class="quick-answer">
        <p class="qa-label">{t.qaLabel}</p>
        <p>{c.answer}</p>
      </div>
    </header>

    <section aria-label={t.table.aria}>
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">{t.table.factorHeader}</th>
              <th scope="col">{c.entityA}</th>
              <th scope="col">{c.entityB}</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.a}</td>
                <td>{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="verdict" aria-label={t.verdict.aria}>
      <p class="eyebrow">{t.verdict.eyebrow}</p>
      <h2>{c.verdict.winner}</h2>
      <p>{c.verdict.text}</p>
    </section>

    <section class="prose">
      {c.body.map((p) => <p set:html={p} />)}
    </section>

    <section class="c-faqs" aria-label={t.faqs.aria}>
      <h2>{t.faqs.heading}</h2>
      <FaqAccordion faqs={c.faqs} />
    </section>

    <aside class="related">
      <p class="divider-label">{t.related.label}</p>
      <div class="related-links">
        {c.pillar === 'education' ? (
          <>
            <a href={link('/tools/fit-check')} class="btn btn-primary">{t.related.education.fitCheck}</a>
            <a href={link('/guides/study-in-china-from-india')} class="btn btn-outline">{t.related.education.roadmap}</a>
          </>
        ) : (
          <>
            <a href={link('/guides/china-sourcing-guide')} class="btn btn-primary">{t.related.trade.sourcingGuide}</a>
            <a href={link('/trade#enquire')} class="btn btn-outline">{t.related.trade.tradeDesk}</a>
          </>
        )}
      </div>
    </aside>
  </article>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .compare-article {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
  }

  .quick-answer {
    margin-top: 1.8rem;
  }

  .table-wrap {
    margin-block: 2.5rem;
  }

  .verdict {
    margin-block: 2.5rem;
    padding: 1.7rem 1.9rem;
    background: #f0f0f0;
    border-radius: 16px;
    border-left: 2px solid var(--accent);
  }

  :global([data-theme='dark']) .verdict {
    background: var(--paper-sunken);
  }

  .verdict h2 {
    margin-top: 0.7rem;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .verdict p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .c-faqs {
    margin-top: 3rem;
  }

  .c-faqs h2 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }

  .related {
    margin-top: 3rem;
  }

  .related-links {
    margin-top: 1.2rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
