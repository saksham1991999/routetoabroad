---
/**
 * compare detail page — shared by all five locales. Route shells under
 * src/pages/compare/[slug].astro and src/pages/<locale>/compare/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the collection entry; links localize through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CtaBand from '../CtaBand.astro';
import FaqAccordion from '../FaqAccordion.astro';
import { COMPARISONS } from '../../data/comparisons';
import { faqSchema } from '../../lib/schema';


import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
  c: (typeof COMPARISONS)[number];
}
const { locale = DEFAULT_LOCALE, c } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
const updated = new Date(c.updated).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  locale={locale}
  title={c.title}
  description={c.answer}
  path={`/compare/${c.slug}`}
  type="article"
  crumbs={[
    { name: 'Compare', url: link('/compare') },
    { name: c.headline, url: `https://routetoabroad.com${link(`/compare/${c.slug}`)}` },
  ]}
  jsonLd={[faqSchema(c.faqs)]}
>
  <article class="container-text compare-article">
    <header>
      <Breadcrumbs
        crumbs={[
          { name: 'Compare', url: link('/compare') },
          { name: c.headline, url: link(`/compare/${c.slug}`) },
        ]}
      />
      <p class="eyebrow">Comparison · updated {updated}</p>
      <h1>{c.headline}</h1>
      <div class="quick-answer">
        <p class="qa-label">Short answer</p>
        <p>{c.answer}</p>
      </div>
    </header>

    <section aria-label="Comparison table">
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Factor</th>
              <th scope="col">{c.entityA}</th>
              <th scope="col">{c.entityB}</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.a}</td>
                <td>{row.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="verdict" aria-label="Verdict">
      <p class="eyebrow">The verdict</p>
      <h2>{c.verdict.winner}</h2>
      <p>{c.verdict.text}</p>
    </section>

    <section class="prose">
      {c.body.map((p) => <p set:html={p} />)}
    </section>

    <section class="c-faqs" aria-label="FAQs">
      <h2>Comparison FAQs</h2>
      <FaqAccordion faqs={c.faqs} />
    </section>

    <aside class="related">
      <p class="divider-label">Next steps</p>
      <div class="related-links">
        {c.pillar === 'education' ? (
          <>
            <a href={link('/tools/fit-check')} class="btn btn-primary">Run the fit check</a>
            <a href={link('/guides/study-in-china-from-india')} class="btn btn-outline">Read the roadmap</a>
          </>
        ) : (
          <>
            <a href={link('/guides/china-sourcing-guide')} class="btn btn-primary">Read the sourcing guide</a>
            <a href={link('/trade#enquire')} class="btn btn-outline">Talk to the trade desk</a>
          </>
        )}
      </div>
    </aside>
  </article>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .compare-article {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
  }

  .quick-answer {
    margin-top: 1.8rem;
  }

  .table-wrap {
    margin-block: 2.5rem;
  }

  .verdict {
    margin-block: 2.5rem;
    padding: 1.7rem 1.9rem;
    background: #f0f0f0;
    border-radius: 16px;
    border-left: 2px solid var(--accent);
  }

  :global([data-theme='dark']) .verdict {
    background: var(--paper-sunken);
  }

  .verdict h2 {
    margin-top: 0.7rem;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .verdict p {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .c-faqs {
    margin-top: 3rem;
  }

  .c-faqs h2 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }

  .related {
    margin-top: 3rem;
  }

  .related-links {
    margin-top: 1.2rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
