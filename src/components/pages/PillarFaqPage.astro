---
/**
 * Pillar FAQ page (education / tourism / trade) — shared by all five
 * locales. Replaces the en dynamic [pillar]/faq route and the 12 static
 * locale replicas. Per-pillar copy comes from the per-locale dictionary in
 * src/i18n/pages/pillar-faq.ts; the Q&A sets come from src/data/faqs.ts
 * (Record<Locale, Faq[]>) and feed both the accordion and the FAQPage
 * JSON-LD.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { EDUCATION_FAQS, TOURISM_FAQS, TRADE_FAQS } from '../../data/faqs';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { faqSchema } from '../../lib/schema';
import { PILLAR_FAQ, type FaqPillar } from '../../i18n/pages/pillar-faq';

interface Props {
  locale?: Locale;
  pillar: FaqPillar;
}
const { locale = DEFAULT_LOCALE, pillar } = Astro.props;

const COLORS: Record<FaqPillar, string> = {
  education: 'var(--edu)',
  tourism: 'var(--tourism)',
  trade: 'var(--trade)',
};

const FAQ_SETS: Record<FaqPillar, typeof EDUCATION_FAQS> = {
  education: EDUCATION_FAQS,
  tourism: TOURISM_FAQS,
  trade: TRADE_FAQS,
};

const t = PILLAR_FAQ[locale].pillars[pillar];
const { crumb, heroTitle } = PILLAR_FAQ[locale];
const faqs = FAQ_SETS[pillar][locale];
const color = COLORS[pillar];
---

<BaseLayout
  title={t.title}
  description={t.description}
  path={`/${pillar}/faq`}
  locale={locale}
  crumbs={[{ name: t.eyebrow, url: translatePath(`/${pillar}`, locale) }, { name: crumb, url: translatePath(`/${pillar}/faq`, locale) }]}
  jsonLd={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow={t.eyebrow}
    title={heroTitle}
    lede={t.description}
    crumbs={[{ name: t.eyebrow, url: translatePath(`/${pillar}`, locale) }, { name: crumb, url: translatePath(`/${pillar}/faq`, locale) }]}
  />

  <section class="section">
    <div class="container-text">
      <div class="faq-topline" style={`border-color: ${color}`}></div>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="pillarFaq" />
</BaseLayout>

<style>
  .faq-topline {
    border-top: 3px solid;
    margin-bottom: 2.2rem;
  }
</style>
