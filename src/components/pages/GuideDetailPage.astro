---
/**
 * guides detail page — shared by all five locales. Route shells under
 * src/pages/guides/[slug].astro and src/pages/<locale>/guides/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the locale-resolved collection entry; template copy comes from the
 * per-locale dictionary in src/i18n/pages/guide-detail.ts, entry frontmatter
 * renders as-is (en fallback or localized copy), and links localize through
 * translatePath.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { articleSchema, faqSchema } from '../../lib/schema';
import { entrySlug } from '../../lib/content';
import { GUIDE_DETAIL } from '../../i18n/pages/guide-detail';


import { translatePath, DEFAULT_LOCALE, DATE_TAG, localizeHtmlLinks, type Locale } from '../../lib/i18n';
import { uiFor } from '../../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale?: Locale;
  guide: CollectionEntry<'guides'>;
}
const { locale = DEFAULT_LOCALE, guide } = Astro.props;
/** Localized template copy. */
const t = GUIDE_DETAIL[locale];
const chrome = uiFor(locale);
const { data } = guide;
const { Content } = await render(guide);
const slug = entrySlug(guide);
const url = `${SITE.url}${translatePath(`/guides/${slug}`, locale)}`;
const faqs = data.faqs ?? [];

const pillarColor: Record<string, string> = {
  education: 'var(--edu)',
  tourism: 'var(--tourism)',
  trade: 'var(--trade)',
};
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  path={`/guides/${slug}`}
  type="article"
  crumbs={[
    { name: t.crumb, url: translatePath('/guides', locale) },
    { name: data.title, url },
  ]}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  progress
  jsonLd={[
    articleSchema({
      headline: data.title,
      description: data.description,
      url,
      image: `${SITE.url}/og/default.jpg`,
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      authorName: chrome.guideDeskByline,
      section: data.pillar,
    }),
    ...(faqs.length ? [faqSchema(faqs)] : []),
  ]}
>
  <article class="container-text guide">
    <header>
      <Breadcrumbs
        crumbs={[
          { name: t.crumb, url: translatePath('/guides', locale) },
          { name: data.title, url: translatePath(`/guides/${slug}`, locale) },
        ]}
      />
      <p class="eyebrow" style={`color: ${pillarColor[data.pillar]}`}>{t.pillarGuide[data.pillar]}</p>
      <h1>{data.title}</h1>
      <p class="guide-meta num">
        {t.updated.replace('{date}', new Date(data.updatedDate ?? data.pubDate).toLocaleDateString(DATE_TAG[locale], { month: 'long', year: 'numeric', timeZone: 'UTC' }))}
        · {t.readTime.replace('{n}', String(data.readTime))}
        {data.tags.map((tag) => <span class="guide-tag">{tag}</span>)}
      </p>
    </header>

    <div class="guide-image">
      <Picture src={data.image} alt={data.imageAlt} widths={[768, 1280]} sizes="(max-width: 64rem) 100vw, 43rem" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </div>

    <div class="prose guide-body">
      {guide.rendered?.html ? <Fragment set:html={localizeHtmlLinks(guide.rendered.html, locale)} /> : <Content />}
    </div>

    {faqs.length > 0 && (
      <section class="guide-faqs" aria-labelledby="gfaq-h">
        <h2 id="gfaq-h">{t.faqHeading}</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}

    <aside class="guide-cta card card-pad">
      <p class="eyebrow">{t.cta.eyebrow}</p>
      <p>{t.cta.text}</p>
      <div class="guide-cta-btns">
        <a href={translatePath('/tools/fit-check', locale)} class="btn btn-primary btn-sm">{t.cta.primary}</a>
        <a href={translatePath('/contact', locale)} class="btn btn-outline btn-sm">{t.cta.secondary}</a>
      </div>
    </aside>
  </article>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .guide {
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--step-5);
  }

  .guide-meta {
    margin-top: 1.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .guide-tag {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--accent);
  }

  .guide-image {
    margin-top: 1.8rem;
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .guide-image :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .guide-body {
    margin-top: 2.2rem;
  }

  .guide-faqs {
    margin-top: 3rem;
  }

  .guide-faqs h2 {
    font-size: var(--step-3);
    margin-bottom: 0.6rem;
  }

  .guide-cta {
    margin-top: 2.5rem;
  }

  .guide-cta p:not(.eyebrow) {
    margin: 0.6rem 0 1.1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .guide-cta-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
