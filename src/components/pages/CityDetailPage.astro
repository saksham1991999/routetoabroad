---
/**
 * cities detail page — shared by all five locales. Route shells under
 * src/pages/cities/[slug].astro and src/pages/<locale>/cities/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the locale-resolved collection entry (rendered as-is — entry frontmatter may
 * be English fallback or localized). Template chrome comes from the per-locale
 * dictionary in src/i18n/pages/city-detail.ts; links localize through
 * translatePath and slugs always come from entrySlug, never raw entry.id.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { faqSchema } from '../../lib/schema';


import { translatePath, DEFAULT_LOCALE, localizeHtmlLinks, type Locale } from '../../lib/i18n';
import { entrySlug } from '../../lib/content';
import { CITY_DETAIL } from '../../i18n/pages/city-detail';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale?: Locale;
  city: CollectionEntry<'cities'>;
}
const { locale = DEFAULT_LOCALE, city } = Astro.props;
/** Localized page copy. */
const t = CITY_DETAIL[locale];
const slug = entrySlug(city);
const { data } = city;
const { Content } = await render(city);
const hasBody = Boolean(city.body && city.body.trim());
---

<BaseLayout
  locale={locale}
  title={t.metaTitleTemplate.replace('{name}', data.name)}
  description={data.intro}
  path={`/cities/${slug}`}
  crumbs={[
    { name: t.crumb, url: translatePath('/cities', locale) },
    { name: data.name, url: `${SITE.url}${translatePath(`/cities/${slug}`, locale)}` },
  ]}
  jsonLd={[faqSchema(data.faqs ?? [])]}
>
  <article>
    <header class="c-hero">
      <div class="container">
        <Breadcrumbs
          crumbs={[
            { name: t.crumb, url: translatePath('/cities', locale) },
            { name: data.name, url: translatePath(`/cities/${slug}`, locale) },
          ]}
        />
        <p class="eyebrow">{data.chineseName} · {data.country}</p>
        <h1>{data.name}</h1>
        <p class="c-intro">{data.intro}</p>
        <div class="c-costs num">
          <div>
            <p class="c-cost-val">${data.studentMonthly.low}–{data.studentMonthly.high}</p>
            <p class="c-cost-label">{t.costs.studentPerMonth}</p>
          </div>
          <div>
            <p class="c-cost-val">${data.touristDaily.low}–{data.touristDaily.high}</p>
            <p class="c-cost-label">{t.costs.travellerPerDay}</p>
          </div>
          <div>
            <p class="c-cost-val c-cost-best">{data.bestTime}</p>
            <p class="c-cost-label">{t.costs.bestTime}</p>
          </div>
        </div>
      </div>
    </header>

    <div class="c-media">
      <Picture
        src={data.image}
        alt={data.imageAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <section class="section">
      <div class="container c-grid">
        <div>
          <section aria-labelledby="hl-h">
            <SectionHead eyebrow={t.highlights.eyebrow} title={`<span id='hl-h'>${t.highlights.title}</span>`} />
            <div class="hl-grid">
              {data.highlights.map((h) => (
                <div class="hl card card-pad" data-reveal>
                  <h3>{h.title}</h3>
                  <p>{h.text}</p>
                </div>
              ))}
            </div>
          </section>

          {hasBody && (
            <section class="prose c-prose">{city.rendered?.html ? <Fragment set:html={localizeHtmlLinks(city.rendered.html, locale)} /> : <Content />}</section>
          )}

          {(data.faqs ?? []).length > 0 && (
            <section class="c-faq" aria-labelledby="cfaq-h">
              <SectionHead eyebrow={t.faq.eyebrow} title={`<span id='cfaq-h'>${t.faq.title}</span>`} />
              <FaqAccordion faqs={data.faqs ?? []} />
            </section>
          )}
        </div>

        <aside class="c-side">
          {data.universities.length > 0 && (
            <div class="card card-pad" data-reveal>
              <h2 class="c-side-title">{t.side.uniTitle}</h2>
              <ul class="c-uni-list">
                {data.universities.map((u) => <li>{u}</li>)}
              </ul>
              <a href={translatePath('/universities', locale)} class="arrow-link c-side-link">{t.side.uniLink}</a>
            </div>
          )}
          <div class="card card-pad c-cta" data-reveal>
            <h2 class="c-side-title">{t.side.ctaTitle}</h2>
            <p>{t.side.ctaText}</p>
            <div class="c-cta-btns">
              <a href={translatePath('/tourism#plan', locale)} class="btn btn-primary btn-sm">{t.side.planTrip}</a>
              <a href={translatePath('/education#apply', locale)} class="btn btn-outline btn-sm">{t.side.applyStudy}</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <CtaBand locale={locale} />
  </article>
</BaseLayout>

<style>
  .c-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .c-hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .c-intro {
    margin-top: 1.2rem;
    max-width: 42rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .c-costs {
    margin-top: 2rem;
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    flex-wrap: wrap;
  }

  .c-cost-val {
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--accent);
  }

  .c-cost-best {
    font-size: 1.05rem;
    padding-top: 0.3rem;
  }

  .c-cost-label {
    margin-top: 0.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .c-media {
    max-height: 56vh;
    overflow: hidden;
  }

  .c-media :global(img) {
    width: 100%;
    max-height: 56vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .c-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .hl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .hl h3 {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hl p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .c-prose {
    margin-top: 3rem;
  }

  .c-faq {
    margin-top: 3rem;
  }

  .c-side {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.2rem;
  }

  .c-side-title {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .c-uni-list {
    margin: 0.8rem 0 0;
    padding-left: 1.3em;
    display: grid;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  .c-uni-list li::marker {
    color: var(--accent);
  }

  .c-side-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .c-cta {
    background: var(--paper-sunken);
  }

  .c-cta p {
    margin: 0.5rem 0 1rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .c-cta-btns {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  @media (max-width: 64rem) {
    .c-grid {
      grid-template-columns: 1fr;
    }
    .c-side {
      position: static;
    }
    .hl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
