---
/**
 * Education pillar page — shared by all five locales (route shells under
 * src/pages/education/ and src/pages/<locale>/education/ pass `locale`). All
 * copy comes from the per-locale dictionary in src/i18n/pages/education.ts;
 * internal links are localized through translatePath and forms/CTA take the
 * locale prop.
 */
import { getCollection } from 'astro:content';
import { localizedEntries, entrySlug } from '../../lib/content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import EducationForm from '../forms/EducationForm.astro';
import { EDUCATION_FAQS } from '../../data/faqs';
import { faqSchema, serviceSchema, howToSchema } from '../../lib/schema';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { EDUCATION } from '../../i18n/pages/education';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = EDUCATION[locale];

const heroImg = (await import('../../assets/images/hero-education.jpg')).default;

const universities = localizedEntries(await getCollection('universities'), locale).sort(
  (a, b) => a.data.order - b.data.order
);

const pageFaqs = EDUCATION_FAQS[locale].slice(0, 6);

/* Card icons are glyphs, not copy — they stay in the component while the
   names/descriptions come from the dictionary (same order). */
const programmeIcons = [
  'M12 3v18M3 12h18',
  'M14 6a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm6 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0ZM6 10v4a4 4 0 0 0 4 4',
  'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
  'M4 5h16M4 12h10M4 19h7',
  'M12 4 2 9l10 5 10-5-10-5ZM6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5',
  'M4 20V9m5 11V4m5 16v-8m5 8V7',
];
const programmes = t.programmes.items.map((p, i) => ({ ...p, icon: programmeIcons[i] }));

const process = t.process.steps;
---

<BaseLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path="/education"
  image="/og/education.jpg"
  crumbs={[{ name: t.crumb, url: link('/education') }]}
  jsonLd={[
    serviceSchema({
      name: t.schema.serviceName,
      description: t.schema.serviceDescription,
      url: link('/education'),
      serviceType: t.schema.serviceType,
      areaServed: ['IN', 'CN', 'SA', 'AE', 'NG', 'KE'],
    }),
    howToSchema({
      name: t.schema.howToName,
      description: t.schema.howToDescription,
      steps: process.map((s) => ({ name: `${s.name} (${s.time})`, text: s.text })),
    }),
    faqSchema(pageFaqs),
  ]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    index={t.hero.index}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: link('/education') }]}
    facts={t.hero.facts}
    actions={[
      { href: link('/tools/fit-check'), label: t.hero.primaryCta },
      { href: '#programmes', label: t.hero.secondaryCta, variant: 'outline' },
    ]}
    jumps={[
      { href: '#programmes', label: t.hero.jumps[0] },
      { href: '#process', label: t.hero.jumps[1] },
      { href: '#scholarships', label: t.hero.jumps[2] },
      { href: '#universities', label: t.hero.jumps[3] },
      { href: '#apply', label: t.hero.jumps[4] },
      { href: '#faq', label: t.hero.jumps[5] },
    ]}
  />

  <section class="section">
    <div class="container edu-intro">
      <div class="quick-answer" data-reveal>
        <p class="qa-label">{t.qa.label}</p>
        <p>
          <strong>{t.qa.strong}</strong>{t.qa.rest}
        </p>
      </div>
      <figure class="edu-photo" data-reveal="right">
        <Picture
          src={heroImg}
          alt={t.photo.alt}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 64rem) 100vw, 50vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
        <figcaption>{t.photo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Programmes -->
  <section class="section section-sunken" id="programmes">
    <div class="container">
      <SectionHead
        eyebrow={t.programmes.eyebrow}
        index={t.programmes.index}
        title={t.programmes.title}
        lede={t.programmes.lede}
      />
      <div class="prog-grid">
        {programmes.map((p, i) => (
          <article class="prog-card card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={p.icon}></path>
            </svg>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process">
    <div class="container-text">
      <SectionHead
        eyebrow={t.process.eyebrow}
        index={t.process.index}
        title={t.process.title}
        lede={t.process.lede}
      />
      <ol class="timeline">
        {process.map((step, i) => (
          <li class="timeline-step" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="t-num num">{String(i + 1).padStart(2, '0')}</span>
            <div class="t-body">
              <h3>{step.name}</h3>
              <p class="t-time num">{step.time}</p>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Scholarship calculator teaser -->
  <section class="section section-sunken" id="scholarships">
    <div class="container">
      <div class="calc-teaser card" data-reveal>
        <div>
          <p class="eyebrow">{t.scholarship.eyebrow}</p>
          <h2>{t.scholarship.title}</h2>
          <p>
            {t.scholarship.text}
          </p>
          <a href={link('/tools/scholarship-eligibility')} class="btn btn-primary">{t.scholarship.cta}</a>
        </div>
        <div class="calc-stats">
          <div><p class="num">{t.scholarship.stats[0].num}</p><p>{t.scholarship.stats[0].label}</p></div>
          <div><p class="num">{t.scholarship.stats[1].num}</p><p>{t.scholarship.stats[1].label}</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Universities -->
  <section class="section" id="universities">
    <div class="container">
      <SectionHead
        eyebrow={t.unis.eyebrow}
        index={t.unis.index}
        title={t.unis.title}
        lede={t.unis.lede}
      />
      <div class="uni-grid">
        {universities.map((u, i) => (
          <a href={link(`/universities/${entrySlug(u)}`)} class="uni-card card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <div class="uni-media">
              <Picture src={u.data.image} alt={u.data.imageAlt} widths={[480, 800]} sizes="(max-width: 64rem) 100vw, 33vw" formats={['avif', 'webp']} loading="lazy" />
            </div>
            <div class="uni-body">
              <h3>{u.data.name}</h3>
              <p class="uni-city num">{u.data.city} · {t.unis.est} {u.data.founded}</p>
              <p>{u.data.nickname}</p>
              <span class="arrow-link">{t.unis.profile}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section-sunken" id="apply" aria-labelledby="apply-title">
    <div class="container form-split">
      <div class="form-side" data-reveal>
        <SectionHead
          eyebrow={t.apply.eyebrow}
          title={`<span id='apply-title'>${t.apply.title}</span>`}
          lede={t.apply.lede}
        />
        <ul class="what-next">
          {t.apply.next.map((item) => (
            <li><strong>{item.lead}</strong> {item.text}</li>
          ))}
        </ul>
      </div>
      <div class="form-card card card-pad" data-reveal>
        <EducationForm locale={locale} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container-text">
      <SectionHead center eyebrow={t.faq.eyebrow} index={t.faq.index} title={t.faq.title} />
      <FaqAccordion faqs={pageFaqs} />
      <p class="faq-more"><a href={link('/education/faq')} class="arrow-link">{t.faq.more}</a></p>
    </div>
  </section>

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .edu-intro {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .quick-answer {
    margin: 0;
  }

  .edu-photo {
    margin: 0;
  }

  /* The ratio lives on the wrapper: Astro's <Picture> width/height
     attributes otherwise win over an aspect-ratio set on the <img>. */
  .edu-photo :global(picture) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--paper-sunken);
  }

  .edu-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .edu-photo figcaption {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .prog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .prog-card {
    padding: 1.6rem 1.6rem 1.8rem;
    transition: border-color 0.2s var(--ease-out);
  }

  .prog-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .prog-card svg {
    width: 2rem;
    height: 2rem;
    color: var(--accent);
  }

  .prog-card h3 {
    margin-top: 1rem;
    font-size: 1.25rem;
  }

  .prog-card p {
    margin-top: 0.55rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1.4rem;
    position: relative;
    padding-bottom: 2.2rem;
  }

  .timeline-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    top: 2.1rem;
    bottom: 0.3rem;
    width: 0;
    border-left: 1px dotted color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .t-num {
    text-align: center;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .t-body h3 {
    font-size: 1.3rem;
  }

  .t-time {
    margin-top: 0.15rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .t-body p:last-child {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* Calculator teaser */
  .calc-teaser {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 2.5rem;
    padding: clamp(1.8rem, 4vw, 3rem);
    align-items: center;
  }

  .calc-teaser h2 {
    margin-top: 0.9rem;
    font-size: var(--step-3);
  }

  .calc-teaser p {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 52ch;
  }

  .calc-teaser .btn {
    margin-top: 1.5rem;
  }

  .calc-stats {
    display: grid;
    gap: 1.5rem;
    text-align: center;
  }

  .calc-stats .num {
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--accent);
  }

  .calc-stats p:last-child {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  /* Universities */
  .uni-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .uni-card {
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease-out);
  }

  .uni-card:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .uni-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .uni-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .uni-body {
    padding: 1.3rem 1.4rem 1.5rem;
  }

  .uni-body h3 {
    font-size: 1.25rem;
  }

  .uni-city {
    margin-top: 0.3rem;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .uni-body p:not(.uni-city) {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .uni-body .arrow-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }

  /* Form section */
  .form-split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .what-next {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .what-next li {
    padding: 1rem 1.2rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .form-card {
    scroll-margin-top: 6rem;
  }

  .faq-more {
    text-align: center;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .edu-intro,
    .calc-teaser,
    .form-split {
      grid-template-columns: 1fr;
    }
    .prog-grid,
    .uni-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .prog-grid,
    .uni-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
