---
/**
 * countries detail page — shared by all five locales. Route shells under
 * src/pages/countries/[slug].astro and src/pages/<locale>/countries/[slug].astro
 * delegate slug generation to src/lib/static-paths.ts and pass `locale` and
 * the locale-resolved collection entry (rendered as-is — entry frontmatter may
 * be English fallback or localized). Template chrome comes from the per-locale
 * dictionary in src/i18n/pages/country-detail.ts; links localize through
 * translatePath and slugs always come from entrySlug, never raw entry.id.
 */
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../lib/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHead from '../SectionHead.astro';
import FaqAccordion from '../FaqAccordion.astro';
import CtaBand from '../CtaBand.astro';
import { faqSchema } from '../../lib/schema';


import { translatePath, DEFAULT_LOCALE, localizeHtmlLinks, type Locale } from '../../lib/i18n';
import { entrySlug } from '../../lib/content';
import { COUNTRY_DETAIL } from '../../i18n/pages/country-detail';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale?: Locale;
  country: CollectionEntry<'countries'>;
}
const { locale = DEFAULT_LOCALE, country } = Astro.props;
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
/** Localized page copy. */
const t = COUNTRY_DETAIL[locale];
const slug = entrySlug(country);
const { data } = country;
const { Content } = await render(country);
const hasBody = Boolean(country.body && country.body.trim());
---

<BaseLayout
  locale={locale}
  title={t.metaTitleTemplate.replace('{name}', data.name)}
  description={data.intro}
  path={`/countries/${slug}`}
  crumbs={[
    { name: data.name, url: `${SITE.url}${link(`/countries/${slug}`)}` },
  ]}
  jsonLd={[faqSchema(data.faqs ?? [])]}
>
  <article>
    <header class="co-hero">
      <div class="container">
        <Breadcrumbs crumbs={[{ name: data.name, url: link(`/countries/${slug}`) }]} />
        <h1>{data.name}</h1>
        <p class="co-intro">{data.intro}</p>
        <div class="co-stats num">
          {data.stats.map((s) => (
            <div class="co-stat">
              <p class="co-stat-val">{s.value}</p>
              <p class="co-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="co-media">
      <Picture
        src={data.image}
        alt={data.imageAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <section class="section">
      <div class="container">
        <div class="co-cols">
          <section aria-labelledby="study-h" data-reveal>
            <p class="eyebrow" style="color: var(--edu)">{t.eyebrows.study}</p>
            <h2 id="study-h">{data.study.heading}</h2>
            <p class="co-col-text">{data.study.text}</p>
            <div class="co-points">
              {data.study.points.map((pt) => (
                <div class="co-point card card-pad">
                  <h3>{pt.title}</h3>
                  <p>{pt.text}</p>
                </div>
              ))}
            </div>
            <a href={link('/education')} class="arrow-link co-col-link">{t.links.education}</a>
          </section>

          <section aria-labelledby="travel-h" data-reveal>
            <p class="eyebrow" style="color: var(--tourism)">{t.eyebrows.travel}</p>
            <h2 id="travel-h">{data.travel.heading}</h2>
            <p class="co-col-text">{data.travel.text}</p>
            <div class="co-points">
              {data.travel.points.map((pt) => (
                <div class="co-point card card-pad">
                  <h3>{pt.title}</h3>
                  <p>{pt.text}</p>
                </div>
              ))}
            </div>
            <a href={link('/tourism')} class="arrow-link co-col-link">{t.links.tourism}</a>
          </section>
        </div>

        {hasBody && <section class="prose co-prose">{country.rendered?.html ? <Fragment set:html={localizeHtmlLinks(country.rendered.html, locale)} /> : <Content />}</section>}

        {(data.faqs ?? []).length > 0 && (
          <div class="container-text co-faq">
            <SectionHead center eyebrow={t.faq.eyebrow} title={t.faq.title} />
            <FaqAccordion faqs={data.faqs ?? []} />
          </div>
        )}
      </div>
    </section>

    <CtaBand locale={locale} />
  </article>
</BaseLayout>

<style>
  .co-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .co-hero h1 {
    margin-top: 0.8rem;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .co-intro {
    margin-top: 1.2rem;
    max-width: 46rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .co-stats {
    margin-top: 2.2rem;
    display: flex;
    gap: clamp(1.5rem, 4vw, 4rem);
    flex-wrap: wrap;
  }

  .co-stat-val {
    font-size: clamp(2rem, 1.8rem + 1vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .co-stat-label {
    margin-top: 0.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .co-media {
    max-height: 60vh;
    overflow: hidden;
  }

  .co-media :global(img) {
    width: 100%;
    max-height: 60vh;
    object-fit: cover;
    filter: grayscale(15%) contrast(1.05);
  }

  .co-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .co-cols h2 {
    margin-top: 0.8rem;
    font-size: var(--step-3);
  }

  .co-col-text {
    margin-top: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .co-points {
    margin-top: 1.4rem;
    display: grid;
    gap: 0.9rem;
  }

  .co-point h3 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .co-point p {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .co-col-link {
    display: inline-block;
    margin-top: 1.4rem;
  }

  .co-prose {
    margin-top: 4rem;
  }

  .co-faq {
    margin-top: 4rem;
  }

  @media (max-width: 64rem) {
    .co-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
