---
/**
 * For Agents page — shared by all five locales (route shells under
 * src/pages/ and src/pages/<locale>/ pass `locale`). All copy comes from
 * the FOR_AGENTS dictionary in src/i18n/pages/for-agents.ts; internal
 * links are localized through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { SITE } from '../../lib/site';
import CtaBand from '../CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { FOR_AGENTS } from '../../i18n/pages/for-agents';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const t = FOR_AGENTS[locale];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/for-agents"
  locale={locale}
  crumbs={[{ name: t.crumb, url: translatePath('/for-agents', locale) }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/for-agents', locale) }]}
  />

  <section class="section">
    <div class="container agent-grid">
      <section class="agent-col" data-reveal>
        <h2>{t.get.title}</h2>
        <ul class="agent-list">
          {t.get.items.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>{t.send.title}</h2>
        <ul class="agent-list agent-list--simple">
          {t.send.items.map((item) => <li>{item}</li>)}
        </ul>

        <h2 class="agent-h2">{t.avoid.title}</h2>
        <ul class="agent-list agent-list--simple agent-list--no">
          {t.avoid.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>{t.never.title}</h2>
        <ul class="agent-list agent-list--no">
          {t.never.items.map((item) => <li>{item}</li>)}
        </ul>
        <div class="agent-note card card-pad">
          <p class="eyebrow">{t.note.eyebrow}</p>
          <p>
            {t.note.text}
          </p>
        </div>
      </section>
    </div>

    <div class="container agent-cta-wrap">
      <div class="agent-cta card card-pad" data-reveal>
        <div>
          <h2>{t.cta.title}</h2>
          <p>
            {t.cta.text}
          </p>
        </div>
        <div class="agent-cta-btns">
          <a href={`mailto:${SITE.email}?subject=Agent%20partnership`} class="btn btn-primary">{t.cta.email}</a>
          <a href={SITE.whatsapp} class="btn btn-outline" rel="noopener">{t.cta.whatsapp.replace('{phone}', SITE.phoneIndia)}</a>
        </div>
      </div>
      <p class="portal-note num">{t.portal}</p>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="forAgents" />
</BaseLayout>

<style>
  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .agent-col h2 {
    font-size: var(--step-2);
    margin-bottom: 1.2rem;
  }

  .agent-h2 {
    margin-top: 2.2rem;
  }

  .agent-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .agent-list li {
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
  }

  .agent-list li strong {
    display: block;
    font-size: 1rem;
    font-weight: 500;
  }

  .agent-list li p {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-list--simple li {
    padding: 0.8rem 0 0.8rem 1.3rem;
    font-size: 0.94rem;
    color: var(--ink-soft);
    position: relative;
  }

  .agent-list--simple li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-text);
  }

  .agent-list--no li::before {
    content: '✕';
    color: var(--err);
  }

  .agent-note {
    margin-top: 1.8rem;
  }

  .agent-note p:not(.eyebrow) {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .agent-cta {
    max-width: 46rem;
    margin-inline: auto;
  }

  .agent-cta p {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-btns {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .portal-note {
    margin-top: 1.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 64rem) {
    .agent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
