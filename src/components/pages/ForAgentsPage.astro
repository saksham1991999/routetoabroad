---
/**
 * For Agents page — shared by all five locales (route shells under
 * src/pages/ and src/pages/<locale>/ pass `locale`). All copy comes from
 * the FOR_AGENTS dictionary in src/i18n/pages/for-agents.ts; internal
 * links are localized through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { SITE, FORMSPREE_ENDPOINT } from '../../lib/site';
import SectionHead from '../SectionHead.astro';
import CtaBand from '../CtaBand.astro';
import { uiFor } from '../../i18n/ui';
import { FOR_AGENTS } from '../../i18n/pages/for-agents';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const t = FOR_AGENTS[locale];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/for-agents"
  locale={locale}
  crumbs={[{ name: t.crumb, url: translatePath('/for-agents', locale) }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/for-agents', locale) }]}
  />

  <section class="section">
    <div class="container agent-grid">
      <section class="agent-col" data-reveal>
        <h2>{t.get.title}</h2>
        <ul class="agent-list">
          {t.get.items.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>{t.send.title}</h2>
        <ul class="agent-list agent-list--simple">
          {t.send.items.map((item) => <li>{item}</li>)}
        </ul>

        <h2 class="agent-h2">{t.avoid.title}</h2>
        <ul class="agent-list agent-list--simple agent-list--no">
          {t.avoid.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="agent-col" data-reveal>
        <h2>{t.never.title}</h2>
        <ul class="agent-list agent-list--no">
          {t.never.items.map((item) => <li>{item}</li>)}
        </ul>
        <div class="agent-note card card-pad">
          <p class="eyebrow">{t.note.eyebrow}</p>
          <p>
            {t.note.text}
          </p>
        </div>
      </section>
    </div>

    <div class="container agent-cta-wrap">
      <div class="agent-cta card card-pad" data-reveal>
        <div>
          <h2>{t.cta.title}</h2>
          <p>
            {t.cta.text}
          </p>
        </div>
        <div class="agent-cta-btns">
          <a href={`mailto:${SITE.email}?subject=Agent%20partnership`} class="btn btn-primary">{t.cta.email}</a>
          <a href={SITE.whatsapp} class="btn btn-outline" rel="noopener">{t.cta.whatsapp.replace('{phone}', SITE.phoneIndia)}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- B2B Partnership Tiers -->
  <section class="section section-sunken" id="tiers">
    <div class="container">
      <SectionHead
        eyebrow={t.tiers.eyebrow}
        index="B2B / 01"
        title={t.tiers.title}
        lede={t.tiers.lede}
      />
      <div class="tiers-grid">
        {t.tiers.items.map((tier, i) => (
          <article class="tier-card card card-pad" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <p class="eyebrow tier-badge num">{tier.badge}</p>
            <h3>{tier.name}</h3>
            <p class="tier-summary">{tier.summary}</p>
            <ul class="tier-bullets">
              {tier.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Live B2B Partner Onboarding Form -->
  <section class="section" id="onboard">
    <div class="container onboard-wrap">
      <div class="onboard-head" data-reveal>
        <SectionHead
          eyebrow={t.onboarding.eyebrow}
          index="B2B / 02"
          title={t.onboarding.title}
          lede={t.onboarding.lede}
        />
      </div>
      <div class="card card-pad onboard-card" data-reveal>
        <form
          class="enquiry-form"
          action={FORMSPREE_ENDPOINT}
          method="POST"
          data-formspree
          data-form-type="b2b-partner"
          data-success-msg={t.onboarding.success}
        >
          <input type="hidden" name="formType" value="B2B Partner Onboarding" />
          <div class="form-fields">
            <div class="form-row">
              <div class="field">
                <label for="b2b-agency">{t.onboarding.fields.agencyName} <span class="req" aria-hidden="true">*</span></label>
                <input id="b2b-agency" name="agencyName" type="text" required autocomplete="organization" />
              </div>
              <div class="field">
                <label for="b2b-contact">{t.onboarding.fields.contactName} <span class="req" aria-hidden="true">*</span></label>
                <input id="b2b-contact" name="fullName" type="text" required autocomplete="name" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="b2b-email">{t.onboarding.fields.email} <span class="req" aria-hidden="true">*</span></label>
                <input id="b2b-email" name="email" type="email" required autocomplete="email" placeholder="partner@agency.com" />
              </div>
              <div class="field">
                <label for="b2b-phone">{t.onboarding.fields.phone} <span class="req" aria-hidden="true">*</span></label>
                <input id="b2b-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+971 / +91 / +234 …" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="b2b-country">{t.onboarding.fields.country} <span class="req" aria-hidden="true">*</span></label>
                <input id="b2b-country" name="country" type="text" required autocomplete="country-name" />
              </div>
              <div class="field">
                <label for="b2b-tier">{t.onboarding.fields.tier}</label>
                <select id="b2b-tier" name="partnershipTier">
                  {t.onboarding.fields.tierOptions.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-row form-row--single">
              <div class="field">
                <label for="b2b-volume">{t.onboarding.fields.volume}</label>
                <select id="b2b-volume" name="estimatedVolume">
                  {t.onboarding.fields.volumeOptions.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-row form-row--single">
              <div class="field">
                <label for="b2b-notes">{t.onboarding.fields.notes}</label>
                <textarea id="b2b-notes" name="message" rows="3" placeholder={t.onboarding.fields.notesPlaceholder}></textarea>
              </div>
            </div>
          </div>

          <p class="form-status" role="status"></p>
          <button type="submit" class="btn btn-primary btn-lg">{t.onboarding.submit}</button>
          <p class="form-fineprint">{t.onboarding.fineprint}</p>
        </form>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="forAgents" />
</BaseLayout>

<style>
  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .agent-col h2 {
    font-size: var(--step-2);
    margin-bottom: 1.2rem;
  }

  .agent-h2 {
    margin-top: 2.2rem;
  }

  .agent-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .agent-list li {
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
  }

  .agent-list li strong {
    display: block;
    font-size: 1rem;
    font-weight: 500;
  }

  .agent-list li p {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-list--simple li {
    padding-block: 0.8rem;
    padding-inline-start: 1.3rem;
    padding-inline-end: 0;
    font-size: 0.94rem;
    color: var(--ink-soft);
    position: relative;
  }

  .agent-list--simple li::before {
    content: '→';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent-text);
  }

  html:global([dir='rtl']) .agent-list--simple li::before {
    content: '←';
  }

  .agent-list--no li::before {
    content: '✕';
    color: var(--err);
  }

  html:global([dir='rtl']) .agent-list--no li::before {
    content: '✕';
  }

  .agent-note {
    margin-top: 1.8rem;
  }

  .agent-note p:not(.eyebrow) {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .agent-cta {
    max-width: 46rem;
    margin-inline: auto;
  }

  .agent-cta p {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .agent-cta-btns {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .tier-card {
    display: flex;
    flex-direction: column;
  }

  .tier-badge {
    color: var(--accent-text);
  }

  .tier-card h3 {
    margin-top: 0.7rem;
    font-size: var(--step-2);
  }

  .tier-summary {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .tier-bullets {
    margin-top: 1.2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .tier-bullets li {
    padding-block: 0.65rem;
    padding-inline-start: 1.2rem;
    padding-inline-end: 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
    position: relative;
  }

  .tier-bullets li::before {
    content: '→';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent-text);
  }

  html:global([dir='rtl']) .tier-bullets li::before {
    content: '←';
  }

  .onboard-wrap {
    max-width: 54rem;
  }

  .onboard-card {
    margin-top: 1.5rem;
  }

  @media (max-width: 64rem) {
    .agent-grid,
    .tiers-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
