---
/**
 * Comparisons index page — shared by all five locales (route shells under
 * src/pages/compare/ and src/pages/<locale>/compare/ pass `locale`). Page
 * structure and body copy are identical across locales by design; comparison
 * links are localized through translatePath. The comparisons data lives in
 * src/data/comparisons.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { uiFor } from '../../i18n/ui';
import { COMPARISONS } from '../../data/comparisons';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
/** Localize an internal href for this page's locale. */
const link = (path: string) => translatePath(path, locale);
---

<BaseLayout
  title="Comparisons — MBBS China vs India, Universities, Freight"
  description="Side-by-side comparisons with clear verdicts: MBBS in China vs India, Tsinghua vs Peking University, sea vs air freight from China to India — tables, numbers and honest calls."
  path="/compare"
  locale={locale}
  crumbs={[{ name: 'Compare', url: link('/compare') }]}
>
  <PageHero
    eyebrow="Comparisons"
    title="Tables and verdicts, not hedging."
    lede="The three comparisons we're asked weekly, each with the full table, the trade-offs, and an actual answer."
    crumbs={[{ name: 'Compare', url: link('/compare') }]}
  />

  <section class="section">
    <div class="container compare-list">
      {COMPARISONS.map((c, i) => (
        <a href={link(`/compare/${c.slug}`)} class="compare-item card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="vs num" aria-hidden="true">
            <span>{c.entityA}</span>
            <em>vs</em>
            <span>{c.entityB}</span>
          </div>
          <h2>{c.headline}</h2>
          <p>{c.answer.slice(0, 180)}…</p>
          <span class="arrow-link">Full comparison</span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="compare" />
</BaseLayout>

<style>
  .compare-list {
    display: grid;
    gap: 1.3rem;
    max-width: 52rem;
  }

  .compare-item {
    display: block;
    padding: 1.7rem 1.9rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease-out);
  }

  .compare-item:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .vs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .vs em {
    color: var(--accent);
    font-style: normal;
    font-weight: 700;
  }

  .compare-item h2 {
    margin-top: 0.8rem;
    font-size: var(--step-2);
  }

  .compare-item p {
    margin-top: 0.6rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .compare-item .arrow-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }
</style>
