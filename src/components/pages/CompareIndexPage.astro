---
/**
 * Comparisons index page — shared by all five locales (route shells under
 * src/pages/compare/ and src/pages/<locale>/compare/ pass `locale`). All
 * template copy comes from the per-locale dictionary in
 * src/i18n/pages/compare-index.ts; the comparison cards render the locale's
 * own set from COMPARISONS[locale] in src/data/comparisons.ts (same slugs
 * across locales) and links localize through translatePath.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { COMPARISONS } from '../../data/comparisons';
import { translatePath, DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { COMPARE_INDEX } from '../../i18n/pages/compare-index';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
/** Localized page copy. */
const t = COMPARE_INDEX[locale];
/** This locale's comparison set (same slugs across locales). */
const comparisons = COMPARISONS[locale];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path="/compare"
  locale={locale}
  crumbs={[{ name: t.crumb, url: translatePath('/compare', locale) }]}
>
  <PageHero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    lede={t.hero.lede}
    crumbs={[{ name: t.crumb, url: translatePath('/compare', locale) }]}
  />

  <section class="section">
    <div class="container compare-list">
      {comparisons.map((c, i) => (
        <a href={translatePath(`/compare/${c.slug}`, locale)} class="compare-item card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="vs num" aria-hidden="true">
            <span>{c.entityA}</span>
            <em>{t.item.vsLabel}</em>
            <span>{c.entityB}</span>
          </div>
          <h2>{c.headline}</h2>
          <p>{c.answer.slice(0, 180)}…</p>
          <span class="arrow-link">{t.item.readMore}</span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand locale={locale} ctaKey="compare" />
</BaseLayout>

<style>
  .compare-list {
    display: grid;
    gap: 1.3rem;
    max-width: 52rem;
  }

  .compare-item {
    display: block;
    padding: 1.7rem 1.9rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s var(--ease-out);
  }

  .compare-item:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .vs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .vs em {
    color: var(--accent-text);
    font-style: normal;
    font-weight: 700;
  }

  .compare-item h2 {
    margin-top: 0.8rem;
    font-size: var(--step-2);
  }

  .compare-item p {
    margin-top: 0.6rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .compare-item .arrow-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }
</style>
