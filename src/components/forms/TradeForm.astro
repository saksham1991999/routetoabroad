---
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { uiFor } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const f = ui.forms.trade;
const ff = ui.formFields;
---

<form class="enquiry-form" data-formspree data-success-msg={f.success} novalidate>
  <div class="form-fields">
    <div class="form-row">
      <div class="field">
        <label for="trade-company">{ff.companyName} <span class="req" aria-hidden="true">*</span></label>
        <input id="trade-company" name="companyName" type="text" required autocomplete="organization" placeholder={f.phCompany} aria-describedby="trade-company-error" />
        <p class="error" id="trade-company-error">{f.errors.company}</p>
      </div>
      <div class="field">
        <label for="trade-name">{ff.contactPerson} <span class="req" aria-hidden="true">*</span></label>
        <input id="trade-name" name="fullName" type="text" required autocomplete="name" placeholder={f.phName} aria-describedby="trade-name-error" />
        <p class="error" id="trade-name-error">{f.errors.name}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="trade-email">{ff.workEmail} <span class="req" aria-hidden="true">*</span></label>
        <input id="trade-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" aria-describedby="trade-email-error" />
        <p class="error" id="trade-email-error">{f.errors.email}</p>
      </div>
      <div class="field">
        <label for="trade-phone">{ff.phone} <span class="hint">({ff.optionalHint})</span></label>
        <input id="trade-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 …" aria-describedby="trade-phone-error" />
        <p class="error" id="trade-phone-error">{f.errors.phone}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="trade-direction">{ff.tradeDirection} <span class="req" aria-hidden="true">*</span></label>
        <select id="trade-direction" name="tradeDirection" required aria-describedby="trade-direction-error">
          <option value="">{ff.selectPlaceholder}</option>
          {f.directions.map((label, i) => (
            <option value={['import', 'export', 'bilateral'][i]}>{label}</option>
          ))}
        </select>
        <p class="error" id="trade-direction-error">{f.errors.direction}</p>
      </div>
      <div class="field">
        <label for="trade-category">{ff.productCategory} <span class="req" aria-hidden="true">*</span></label>
        <select id="trade-category" name="productCategory" required aria-describedby="trade-category-error">
          <option value="">{ff.selectPlaceholder}</option>
          {f.categories.map((label, i) => (
            <option value={['electronics', 'machinery', 'textiles', 'consumer', 'other'][i]}>{label}</option>
          ))}
        </select>
        <p class="error" id="trade-category-error">{f.errors.category}</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="trade-notes">{ff.sourcingVolumes} <span class="hint">({ff.optionalHint})</span></label>
        <textarea id="trade-notes" name="additionalNotes" rows="3" placeholder={f.phNotes}></textarea>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">{f.submit}</button>
  <p class="form-fineprint">{f.fineprint}</p>
</form>


<style>
  .enquiry-form {
    display: grid;
    gap: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-row--single {
    grid-template-columns: 1fr;
  }

  .form-fineprint {
    font-size: 0.84rem;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
