<form class="enquiry-form" data-formspree data-success-msg="Received! Our trade desk will reply within one working day with next steps." novalidate>
  <div class="form-fields">
    <div class="form-row">
      <div class="field">
        <label for="trade-company">Company name</label>
        <input id="trade-company" name="companyName" type="text" required autocomplete="organization" placeholder="Your company" />
        <p class="error">Please enter your company name.</p>
      </div>
      <div class="field">
        <label for="trade-name">Contact person</label>
        <input id="trade-name" name="fullName" type="text" required autocomplete="name" placeholder="Name" />
        <p class="error">Please enter your name.</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="trade-email">Work email</label>
        <input id="trade-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
        <p class="error">Please enter a valid email.</p>
      </div>
      <div class="field">
        <label for="trade-phone">Phone / WhatsApp</label>
        <input id="trade-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 …" />
        <p class="error">Please enter a valid phone number.</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="trade-direction">Trade direction</label>
        <select id="trade-direction" name="tradeDirection" required>
          <option value="">Select…</option>
          <option value="import">Import from China to India</option>
          <option value="export">Export from India to China</option>
          <option value="bilateral">Both / exploring</option>
        </select>
        <p class="error">Please choose a trade direction.</p>
      </div>
      <div class="field">
        <label for="trade-category">Product category</label>
        <select id="trade-category" name="productCategory" required>
          <option value="">Select…</option>
          <option value="electronics">Electronics & components</option>
          <option value="machinery">Industrial machinery</option>
          <option value="textiles">Textiles & apparel</option>
          <option value="consumer">Consumer goods</option>
          <option value="other">Other</option>
        </select>
        <p class="error">Please choose a category.</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="trade-notes">What are you sourcing, at what volumes? <span class="hint">(optional)</span></label>
        <textarea id="trade-notes" name="additionalNotes" rows="3" placeholder="e.g. LED drivers, ~5,000 units/month, target FOB…"></textarea>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">Talk to the trade desk</button>
  <p class="form-fineprint">Success fee model: you pay when goods ship. Audit costs quoted upfront.</p>
</form>


<style>
  .enquiry-form {
    display: grid;
    gap: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-row--single {
    grid-template-columns: 1fr;
  }

  .form-fineprint {
    font-size: 0.84rem;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
