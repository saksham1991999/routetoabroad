---
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { uiFor } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const f = ui.forms.contact;
const ff = ui.formFields;
---

<form class="enquiry-form" data-formspree data-success-msg={f.success} novalidate>
  <div class="form-fields">
    <fieldset class="pathway-fieldset">
      <legend>{f.legend}</legend>
      <div class="pathway-cards" role="radiogroup" aria-label={f.serviceAria}>
        <label class="pathway-card">
          <input type="radio" name="serviceContext" value="education" checked />
          <span class="pw-name">{f.cards.education}</span>
          <span class="pw-desc">{f.cards.educationDesc}</span>
        </label>
        <label class="pathway-card">
          <input type="radio" name="serviceContext" value="tourism" />
          <span class="pw-name">{f.cards.tourism}</span>
          <span class="pw-desc">{f.cards.tourismDesc}</span>
        </label>
        <label class="pathway-card">
          <input type="radio" name="serviceContext" value="trade" />
          <span class="pw-name">{f.cards.trade}</span>
          <span class="pw-desc">{f.cards.tradeDesc}</span>
        </label>
      </div>
    </fieldset>

    <div class="form-row">
      <div class="field">
        <label for="c-name">{ff.fullName} <span class="req" aria-hidden="true">*</span></label>
        <input id="c-name" name="fullName" type="text" required autocomplete="name" placeholder={f.phName} aria-describedby="c-name-error" />
        <p class="error" id="c-name-error">{f.errors.name}</p>
      </div>
      <div class="field">
        <label for="c-email">{ff.email} <span class="req" aria-hidden="true">*</span></label>
        <input id="c-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" aria-describedby="c-email-error" />
        <p class="error" id="c-email-error">{f.errors.email}</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="c-phone">{ff.phone} <span class="hint">({ff.optionalHint})</span></label>
        <input id="c-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 …" aria-describedby="c-phone-error" />
        <p class="error" id="c-phone-error">{f.errors.phone}</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="c-message">{ff.message} <span class="req" aria-hidden="true">*</span></label>
        <textarea id="c-message" name="message" rows="4" required placeholder={f.phMessage} aria-describedby="c-message-error"></textarea>
        <p class="error" id="c-message-error">{f.errors.message}</p>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">{f.submit}</button>
  <p class="form-fineprint">{f.fineprint}</p>
</form>


<style>
  .enquiry-form {
    display: grid;
    gap: 1.2rem;
  }

  .pathway-fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .pathway-fieldset legend {
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0;
    margin-bottom: 0.8rem;
  }

  .pathway-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .pathway-card {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .pathway-card:hover {
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .pathway-card input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pathway-card:has(input:checked) {
    box-shadow: 0 0 0 2px var(--ink);
    border-color: transparent;
    background: var(--paper-raised);
  }

  .pathway-card:has(input:checked) .pw-name {
    color: var(--ink);
  }

  .pathway-card:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pw-name {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .pw-desc {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-row--single {
    grid-template-columns: 1fr;
  }

  .form-fineprint {
    font-size: 0.84rem;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .form-row,
    .pathway-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
