---
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { formOptions } from '../../lib/form-options';
import { uiFor } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const f = ui.forms.tourism;
const ff = ui.formFields;
---

<form class="enquiry-form" data-formspree data-success-msg={f.success} novalidate>
  <div class="form-fields">
    <div class="form-row">
      <div class="field">
        <label for="tour-name">{ff.fullName} <span class="req" aria-hidden="true">*</span></label>
        <input id="tour-name" name="name" type="text" required autocomplete="name" placeholder={f.phName} aria-describedby="tour-name-error" />
        <p class="error" id="tour-name-error">{f.errors.name}</p>
      </div>
      <div class="field">
        <label for="tour-email">{ff.email} <span class="req" aria-hidden="true">*</span></label>
        <input id="tour-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" aria-describedby="tour-email-error" />
        <p class="error" id="tour-email-error">{f.errors.email}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="tour-phone">{ff.phone} <span class="req" aria-hidden="true">*</span></label>
        <input id="tour-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+91 …" aria-describedby="tour-phone-error" />
        <p class="error" id="tour-phone-error">{f.errors.phone}</p>
      </div>
      <div class="field">
        <label for="tour-dest">{ff.destination} <span class="req" aria-hidden="true">*</span></label>
        <select id="tour-dest" name="destination" required aria-describedby="tour-dest-error">
          <option value="">{ff.selectPlaceholder}</option>
          {formOptions('destinations', ['china', 'japan', 'multi', 'custom'], f.destinations).map((o) => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
        <p class="error" id="tour-dest-error">{f.errors.destination}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="tour-type">{ff.tripType} <span class="req" aria-hidden="true">*</span></label>
        <select id="tour-type" name="tripType" required aria-describedby="tour-type-error">
          <option value="">{ff.selectPlaceholder}</option>
          {formOptions('tripTypes', ['cultural', 'group', 'business'], f.tripTypes).map((o) => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
        <p class="error" id="tour-type-error">{f.errors.tripType}</p>
      </div>
      <div class="field">
        <label for="tour-dates">{ff.travelDates} <span class="hint">({ff.optionalHint})</span></label>
        <input id="tour-dates" name="preferredDates" type="text" placeholder={f.phDates} />
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="tour-notes">{ff.anythingElse} <span class="hint">({ff.optionalHint})</span></label>
        <textarea id="tour-notes" name="message" rows="3" placeholder={f.phNotes}></textarea>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">{f.submit}</button>
  <p class="form-fineprint">{f.fineprint}</p>
</form>
