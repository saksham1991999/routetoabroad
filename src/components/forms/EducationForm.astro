<form class="enquiry-form" data-formspree data-success-msg="Application received! An education advisor will call you within one working day." novalidate>
  <div class="form-fields">
    <div class="form-row">
      <div class="field">
        <label for="edu-name">Full name</label>
        <input id="edu-name" name="fullName" type="text" required autocomplete="name" placeholder="As on your passport" />
        <p class="error">Please enter your name.</p>
      </div>
      <div class="field">
        <label for="edu-email">Email</label>
        <input id="edu-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        <p class="error">Please enter a valid email.</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="edu-phone">Phone / WhatsApp</label>
        <input id="edu-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+91 …" />
        <p class="error">Please enter a valid phone number.</p>
      </div>
      <div class="field">
        <label for="edu-level">Current level</label>
        <select id="edu-level" name="educationLevel" required>
          <option value="">Select…</option>
          <option value="hs">In school (12th or below)</option>
          <option value="bachelor">Bachelor's (completed or ongoing)</option>
          <option value="master">Master's or above</option>
        </select>
        <p class="error">Please choose your current level.</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="edu-programme">Programme interest</label>
        <select id="edu-programme" name="programInterest" required>
          <option value="">Select…</option>
          <option value="mbbs">MBBS / Medicine</option>
          <option value="engineering">Engineering & Technology</option>
          <option value="business">Business & Management</option>
          <option value="language">Chinese Language (HSK)</option>
          <option value="undergrad">Bachelor's (other)</option>
          <option value="research">Masters / PhD (research)</option>
        </select>
        <p class="error">Please choose a programme.</p>
      </div>
      <div class="field">
        <label for="edu-intake">Target intake</label>
        <select id="edu-intake" name="targetIntake" required>
          <option value="">Select…</option>
          <option value="sept_2026">September 2026</option>
          <option value="march_2027">March 2027</option>
          <option value="later">Later / not sure</option>
        </select>
        <p class="error">Please choose an intake.</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="edu-cgpa">Latest marks / CGPA <span class="hint">(optional)</span></label>
        <input id="edu-cgpa" name="cgpa" type="text" inputmode="decimal" placeholder="e.g. 82% or 3.6/4" />
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="edu-notes">Anything else we should know? <span class="hint">(optional)</span></label>
        <textarea id="edu-notes" name="notes" rows="3" placeholder="Scholarship goals, budget, cities you prefer…"></textarea>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">Apply for a free assessment</button>
  <p class="form-fineprint">No commitment. We reply with a yes, a maybe, or a no — and what to do next.</p>
</form>


<style>
  .enquiry-form {
    display: grid;
    gap: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-row--single {
    grid-template-columns: 1fr;
  }

  .form-fineprint {
    font-size: 0.84rem;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
