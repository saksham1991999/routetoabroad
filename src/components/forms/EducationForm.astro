---
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n';
import { uiFor } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale);
const f = ui.forms.education;
const ff = ui.formFields;
---

<form class="enquiry-form" data-formspree data-success-msg={f.success} novalidate>
  <div class="form-fields">
    <div class="form-row">
      <div class="field">
        <label for="edu-name">{ff.fullName} <span class="req" aria-hidden="true">*</span></label>
        <input id="edu-name" name="fullName" type="text" required autocomplete="name" placeholder={f.phName} aria-describedby="edu-name-error" />
        <p class="error" id="edu-name-error">{f.errors.name}</p>
      </div>
      <div class="field">
        <label for="edu-email">{ff.email} <span class="req" aria-hidden="true">*</span></label>
        <input id="edu-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" aria-describedby="edu-email-error" />
        <p class="error" id="edu-email-error">{f.errors.email}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="edu-phone">{ff.phone} <span class="req" aria-hidden="true">*</span></label>
        <input id="edu-phone" name="phone" type="tel" required autocomplete="tel" placeholder="+91 …" aria-describedby="edu-phone-error" />
        <p class="error" id="edu-phone-error">{f.errors.phone}</p>
      </div>
      <div class="field">
        <label for="edu-level">{ff.educationLevel} <span class="req" aria-hidden="true">*</span></label>
        <select id="edu-level" name="educationLevel" required aria-describedby="edu-level-error">
          <option value="">{ff.selectPlaceholder}</option>
          {f.levels.map((label, i) => (
            <option value={['hs', 'bachelor', 'master'][i]}>{label}</option>
          ))}
        </select>
        <p class="error" id="edu-level-error">{f.errors.level}</p>
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="edu-programme">{ff.programmeInterest} <span class="req" aria-hidden="true">*</span></label>
        <select id="edu-programme" name="programInterest" required aria-describedby="edu-programme-error">
          <option value="">{ff.selectPlaceholder}</option>
          {f.programmes.map((label, i) => (
            <option value={['mbbs', 'engineering', 'business', 'language', 'undergrad', 'research'][i]}>{label}</option>
          ))}
        </select>
        <p class="error" id="edu-programme-error">{f.errors.programme}</p>
      </div>
      <div class="field">
        <label for="edu-intake">{ff.targetIntake} <span class="req" aria-hidden="true">*</span></label>
        <select id="edu-intake" name="targetIntake" required aria-describedby="edu-intake-error">
          <option value="">{ff.selectPlaceholder}</option>
          {f.intakes.map((label, i) => (
            <option value={['sept_2026', 'march_2027', 'later'][i]}>{label}</option>
          ))}
        </select>
        <p class="error" id="edu-intake-error">{f.errors.intake}</p>
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="edu-cgpa">{ff.latestMarks} <span class="hint">({ff.optionalHint})</span></label>
        <input id="edu-cgpa" name="cgpa" type="text" inputmode="decimal" placeholder={f.phCgpa} />
      </div>
    </div>

    <div class="form-row form-row--single">
      <div class="field">
        <label for="edu-notes">{ff.anythingElse} <span class="hint">({ff.optionalHint})</span></label>
        <textarea id="edu-notes" name="notes" rows="3" placeholder={f.phNotes}></textarea>
      </div>
    </div>
  </div>

  <p class="form-status" role="status"></p>

  <button type="submit" class="btn btn-primary btn-lg">{f.submit}</button>
  <p class="form-fineprint">{f.fineprint}</p>
</form>


<style>
  .enquiry-form {
    display: grid;
    gap: 1.2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  .form-row--single {
    grid-template-columns: 1fr;
  }

  .form-fineprint {
    font-size: 0.84rem;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
