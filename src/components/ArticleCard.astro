---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PillarKey } from '../lib/site';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { uiFor } from '../i18n/ui';

interface Props {
  title: string;
  href: string;
  description: string;
  image: ImageMetadata | string;
  imageAlt: string;
  meta?: string;
  tag?: string;
  pillar?: PillarKey;
  locale?: Locale;
}

const { title, href, description, image, imageAlt, meta, tag, pillar, locale = DEFAULT_LOCALE } = Astro.props;

const pillarColor: Record<PillarKey, string> = {
  education: 'var(--edu)',
  tourism: 'var(--tourism)',
  trade: 'var(--trade)',
};

/** Localized "Read" arrow-link label (chrome string). */
const moreLabel = uiFor(locale).articleCard?.more ?? 'Read';
---

<article class="article-card card">
  <a href={href} class="card-link">
    <div class="card-media">
      {typeof image === 'string' ? (
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" width="800" height="500" />
      ) : (
        <Picture src={image} alt={imageAlt} widths={[480, 800]} sizes="(max-width: 48rem) 100vw, 33vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
      )}
    </div>
    <div class="card-body">
      <p class="card-meta">
        {pillar && <span class="card-tag" style={`color: ${pillarColor[pillar]}`}>{tag || uiFor(locale).categories[pillar]}</span>}
        {!pillar && tag && <span class="card-tag" style="color: var(--gold)">{tag}</span>}
        {meta && <span class="card-meta-text num">{meta}</span>}
      </p>
      <h3>{title}</h3>
      <p class="card-desc">{description}</p>
      <span class="card-more arrow-link">{moreLabel}</span>
    </div>
  </a>
</article>

<style>
  .article-card {
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-media {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .card-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(12%) contrast(1.04);
    transition: transform 0.5s var(--ease-out);
  }

  .article-card:hover .card-media :global(img) {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-tag {
    font-weight: 500;
  }

  .card-meta-text {
    color: var(--ink-faint);
  }

  h3 {
    margin-top: 0.7rem;
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .card-desc {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-more {
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.875rem;
  }
</style>
