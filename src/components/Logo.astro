---
/**
 * R ✈ A lockup — the v2 brand mark, carried over verbatim.
 *
 * Renders only the inner content so the parent keeps its own `.wordmark`
 * typography (size, weight, padding, tone-switching colour). Every measurement
 * below is in `em`, so the mark follows whatever font-size the parent sets.
 */
interface Props {
  /** Mark only, no "RouteToAbroad" word — for very tight spaces. */
  markOnly?: boolean;
}

const { markOnly = false } = Astro.props;
---

<span class="logo">
  <span class="logo-mark">
    <span class="logo-letter">R</span>
    <svg class="logo-plane" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M3.15 10.55 20.9 3.2c.52-.22.88.38.58.84L14.1 21.1c-.26.4-.88.3-.98-.18l-1.42-7.85-8.12-1.7c-.5-.1-.55-.72-.43-.82Z"
      />
    </svg>
    <span class="logo-letter">A</span>
  </span>
  {!markOnly && <span class="logo-name">RouteToAbroad</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.235em;
  }

  .logo-letter {
    font-size: 1em;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .logo-plane {
    width: 0.82em;
    height: 0.82em;
    flex: none;
    color: var(--accent-text);
  }

  .logo-name {
    margin-inline-start: 0.47em;
    font-size: 0.765em;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  /* Over a dark band the plane needs the lighter signal, not the AA text tone. */
  :global([data-tone='dark']) .logo-plane {
    color: var(--accent-strong);
  }
</style>
