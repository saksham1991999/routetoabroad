---
// Floating AI counselor. The heavy logic only loads on first open.
---

<div class="chat-root" id="chat-root">
  <button class="chat-fab" id="chat-fab" type="button" aria-expanded="false" aria-controls="chat-panel" aria-label="Open AI counselor chat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 10.5h8M8 13.5h5M21 12c0 4.14-4.03 7.5-9 7.5-1.06 0-2.08-.15-3.02-.44L3.6 20.4l1.06-3.63C3.6 15.4 3 13.76 3 12c0-4.14 4.03-7.5 9-7.5s9 3.36 9 7.5Z" />
    </svg>
    <span class="chat-fab-label">Ask us</span>
  </button>

  <div class="chat-panel" id="chat-panel" role="dialog" aria-label="AI counselor" hidden>
    <header class="chat-head">
      <div>
        <strong>RouteToAbroad Assistant</strong>
        <span>Powered by Claude · replies in seconds</span>
      </div>
      <button type="button" id="chat-close" class="chat-close" aria-label="Close chat">×</button>
    </header>
    <div class="chat-log" id="chat-log" aria-live="polite"></div>
    <form class="chat-form" id="chat-form">
      <label class="visually-hidden" for="chat-input">Message</label>
      <input id="chat-input" type="text" placeholder="Ask about programmes, visas, trips…" autocomplete="off" />
      <button type="submit" class="chat-send" aria-label="Send">➤</button>
    </form>
  </div>
</div>

<style>
  .chat-root {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 150;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  /* The accent surface exception: signal FAB */
  .chat-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-surface);
    color: #ffffff;
    border-radius: 999px;
    padding: 0.8rem 1.3rem;
    font-weight: 500;
    box-shadow: 0 1px 18px rgba(94, 120, 238, 0.28);
    transition: transform 0.2s var(--ease-out), background 0.2s;
  }

  .chat-fab:hover {
    background: #4a63d8;
    transform: translateY(-2px);
  }

  html[data-theme='dark'] .chat-fab {
    color: #0a0a0a; /* light periwinkle needs dark ink for contrast */
  }

  html[data-theme='dark'] .chat-fab:hover {
    background: var(--accent-strong);
  }

  .chat-fab svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .chat-panel {
    width: min(24rem, calc(100vw - 2rem));
    height: min(30rem, calc(100dvh - 7rem));
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: var(--radius-l);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .chat-head strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
  }

  .chat-head span {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .chat-close {
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-faint);
    padding: 0.2rem 0.4rem;
  }

  .chat-close:hover {
    color: var(--ink);
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .chat-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .chat-form input {
    flex: 1;
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    font-size: 0.92rem;
    background: var(--paper-raised);
    color: var(--ink);
  }

  .chat-form input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .chat-send {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--accent-surface);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }

  .chat-send:hover {
    background: #4a63d8;
  }

  html[data-theme='dark'] .chat-send {
    color: #0a0a0a;
  }

  html[data-theme='dark'] .chat-send:hover {
    background: var(--accent-strong);
  }

  .chat-send:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  @media (max-width: 40rem) {
    .chat-fab-label {
      display: none;
    }
    .chat-fab {
      padding: 0.9rem;
    }
  }
</style>

<style is:global>
  /* Messages are created via createElement in the script below, so they never
     receive the Astro scope class — these rules must stay global. */
  .chat-msg {
    max-width: 85%;
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-m);
    font-size: 0.92rem;
    line-height: 1.55;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .chat-msg.user {
    justify-self: end;
    background: #111111;
    color: #ffffff;
    border-bottom-right-radius: 4px;
  }

  .chat-msg.bot {
    justify-self: start;
    background: var(--paper-sunken);
    color: var(--ink);
    border-bottom-left-radius: 4px;
  }

  .chat-msg.typing {
    color: var(--ink-faint);
    font-style: italic;
  }
</style>

<script>
  const fab = document.getElementById('chat-fab');
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLInputElement | null;
  const log = document.getElementById('chat-log');

  let started = false;
  let busy = false;
  const history: { role: string; content: string }[] = [];

  function addMsg(role: 'user' | 'bot', text: string): HTMLElement {
    const div = document.createElement('div');
    div.className = `chat-msg ${role}`;
    div.textContent = text;
    log?.appendChild(div);
    log?.scrollTo({ top: log.scrollHeight });
    return div;
  }

  async function send(text: string) {
    if (!text || busy || !log || !input) return;
    busy = true;
    addMsg('user', text);
    history.push({ role: 'user', content: text });
    input.value = '';

    const placeholder = addMsg('bot', '…');
    placeholder.classList.add('typing');
    placeholder.textContent = 'Thinking…';

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });

      placeholder.textContent = '';
      placeholder.classList.remove('typing');

      if (!res.ok || !res.body) {
        placeholder.textContent =
          'Sorry — the assistant is unavailable right now. WhatsApp +91 96330 61109 and a human will take it.';
        busy = false;
        return;
      }

      // Parse Anthropic SSE stream
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let full = '';

      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';
        for (const line of lines) {
          if (!line.startsWith('data:')) continue;
          const payload = line.slice(5).trim();
          if (!payload || payload === '[DONE]') continue;
          try {
            const evt = JSON.parse(payload);
            if (evt.type === 'content_block_delta' && evt.delta?.text) {
              full += evt.delta.text;
              placeholder.textContent = full;
              log?.scrollTo({ top: log.scrollHeight });
            }
          } catch {
            /* partial JSON — wait for more */
          }
        }
      }

      if (!full) placeholder.textContent = '(no reply — try again or WhatsApp us)';
      else history.push({ role: 'assistant', content: full });
    } catch {
      placeholder.textContent = 'Connection dropped. Please try again.';
    } finally {
      busy = false;
      input.focus();
    }
  }

  function openPanel() {
    if (!panel || !fab) return;
    panel.hidden = false;
    fab.setAttribute('aria-expanded', 'true');
    if (!started) {
      started = true;
      addMsg('bot', 'Hi! I can answer questions about studying in China, trips to East Asia, or sourcing from Chinese factories. What are you working on?');
    }
    input?.focus();
  }

  function closePanel() {
    if (!panel || !fab) return;
    panel.hidden = true;
    fab.setAttribute('aria-expanded', 'false');
    fab.focus();
  }

  fab?.addEventListener('click', () => {
    panel?.hidden ? openPanel() : closePanel();
  });
  closeBtn?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) closePanel();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    send(input?.value.trim() || '');
  });
</script>
