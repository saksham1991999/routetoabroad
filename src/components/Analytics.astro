---
import { ANALYTICS } from '../lib/site';

const { gtmId, gaMeasurementId, posthogKey, posthogHost } = ANALYTICS;
const posthogAssetsHost = posthogHost.includes('.i.posthog.com')
  ? posthogHost.replace('.i.posthog.com', '-assets.i.posthog.com')
  : posthogHost;
const googleTagSrcs = [
  gtmId ? `https://www.googletagmanager.com/gtm.js?id=${gtmId}` : '',
  gaMeasurementId ? `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}` : '',
].filter(Boolean);
---

{googleTagSrcs.length > 0 && (
  <script is:inline define:vars={{ gTagSrcs: googleTagSrcs, gtmContainerId: gtmId, gaId: gaMeasurementId }}>
    (function (doc, win) {
      win.dataLayer = win.dataLayer || [];
      win.gtag =
        win.gtag ||
        function gtag() {
          win.dataLayer.push(arguments);
        };
      win.gtag('js', new Date());
      if (gtmContainerId) {
        win.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      }
      if (gaId) {
        win.gtag('config', gaId);
      }
      var loaded = false;
      function loadGtag() {
        if (loaded) return;
        loaded = true;
        for (var i = 0; i < gTagSrcs.length; i++) {
          var s = doc.createElement('script');
          s.async = true;
          s.src = gTagSrcs[i];
          doc.head.appendChild(s);
        }
      }
      function schedule() {
        if ('requestIdleCallback' in win) {
          win.requestIdleCallback(loadGtag, { timeout: 2000 });
        } else {
          win.setTimeout(loadGtag, 1200);
        }
      }
      if (doc.readyState === 'complete') {
        schedule();
      } else {
        win.addEventListener('load', schedule, { once: true });
      }
      ['pointerdown', 'keydown', 'scroll'].forEach(function (ev) {
        win.addEventListener(ev, loadGtag, { once: true, passive: true });
      });
    })(document, window);
  </script>
)}

{posthogKey && (
  <script is:inline define:vars={{ phKey: posthogKey, phHost: posthogHost, phAssets: posthogAssetsHost }}>
    (function (doc, win) {
      if (win.posthog && win.posthog.__SV) return;
      var ph = (win.posthog = win.posthog || []);
      ph._i = ph._i || [];
      ph.init = function (token, config, name) {
        var target = ph;
        if (name && name !== 'posthog') {
          target = ph[name] = [];
        } else {
          name = 'posthog';
        }
        target.people = target.people || [];
        var methods = [
          'capture',
          'identify',
          'alias',
          'people.set',
          'people.set_once',
          'register',
          'unregister',
          'reset',
          'opt_in_capturing',
          'opt_out_capturing',
          'startSessionRecording',
          'stopSessionRecording',
          'setPersonProperties',
        ];
        for (var i = 0; i < methods.length; i++) {
          (function (fullMethodName) {
            var parts = fullMethodName.split('.');
            var obj = target;
            var fnName = fullMethodName;
            if (parts.length === 2) {
              obj = target[parts[0]];
              fnName = parts[1];
            }
            obj[fnName] = function () {
              target.push([fullMethodName].concat(Array.prototype.slice.call(arguments, 0)));
            };
          })(methods[i]);
        }
        ph._i.push([token, config, name]);
      };
      ph.__SV = 1;
      ph.init(phKey, {
        api_host: phHost,
        person_profiles: 'always',
        autocapture: true,
        capture_pageview: true,
        capture_pageleave: true,
        disable_surveys: true,
        disable_session_recording: false,
        session_recording: {
          maskAllInputs: false,
          maskTextSelector: '',
          blockSelector: '',
          captureCanvas: { recordCanvas: true },
        },
      });
      var phLoaded = false;
      function loadPosthog() {
        if (phLoaded) return;
        phLoaded = true;
        var script = doc.createElement('script');
        script.type = 'text/javascript';
        script.async = true;
        script.crossOrigin = 'anonymous';
        script.src = phAssets.replace(/\/$/, '') + '/static/array.js';
        var firstScript = doc.getElementsByTagName('script')[0];
        firstScript.parentNode.insertBefore(script, firstScript);
      }
      function schedulePh() {
        if ('requestIdleCallback' in win) {
          win.requestIdleCallback(loadPosthog, { timeout: 2500 });
        } else {
          win.setTimeout(loadPosthog, 1500);
        }
      }
      if (doc.readyState === 'complete') {
        schedulePh();
      } else {
        win.addEventListener('load', schedulePh, { once: true });
      }
      ['pointerdown', 'keydown', 'scroll'].forEach(function (ev) {
        win.addEventListener(ev, loadPosthog, { once: true, passive: true });
      });
    })(document, window);
  </script>
)}
