---
import { SITE, FOOTER_LINKS, CURRENT_YEAR } from '../lib/site';
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <p class="wordmark">
        <span>Route</span><span class="wm-to">To</span><span class="wm-abroad">Abroad</span>
      </p>
      <p class="footer-desc">
        Your strategic gateway between India and East Asia — education, tourism, and trade
        handled by people who live on both sides.
      </p>
      <ul class="footer-contact">
        <li><a href={SITE.phoneIndiaHref}>{SITE.phoneIndia}</a><span class="loc">New Delhi</span></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>
          <address>
            {SITE.offices[0].street}, {SITE.offices[0].city} {SITE.offices[0].postal}<br />
            {SITE.offices[1].street}, {SITE.offices[1].city}, {SITE.offices[1].country}
          </address>
        </li>
      </ul>
      <ul class="footer-social" aria-label="Social profiles">
        <li><a href={SITE.socials.linkedin} rel="noopener" aria-label="LinkedIn">LinkedIn</a></li>
        <li><a href={SITE.socials.instagram} rel="noopener" aria-label="Instagram">Instagram</a></li>
        <li><a href={SITE.socials.twitter} rel="noopener" aria-label="X / Twitter">X</a></li>
        <li><a href={SITE.socials.youtube} rel="noopener" aria-label="YouTube">YouTube</a></li>
      </ul>
    </div>

    <nav aria-label="Services">
      <h3>Services</h3>
      <ul>{FOOTER_LINKS.services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label="Tools">
      <h3>Free tools</h3>
      <ul>{FOOTER_LINKS.tools.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label="Resources">
      <h3>Resources</h3>
      <ul>{FOOTER_LINKS.resources.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label="Company">
      <h3>Company</h3>
      <ul>{FOOTER_LINKS.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>

  <div class="container-wide footer-bottom">
    <p>© {CURRENT_YEAR} {SITE.name}. All rights reserved.</p>
    <p class="footer-note">Open {SITE.hours} · Replies within one working day</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #0a0a0a;
    color: #ffffff;
    padding-top: clamp(3rem, 6vw, 5rem);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .wm-to { color: rgba(255, 255, 255, 0.55); margin-inline: 0.06em; }
  .wm-abroad { color: var(--accent); }

  .footer-desc {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    max-width: 24rem;
  }

  .footer-contact {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.55rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-contact a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-contact a:hover { color: var(--accent); }

  .loc {
    margin-left: 0.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-contact address {
    font-style: normal;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-social {
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-social a {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .footer-social a:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .footer-grid nav h3 {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.1rem;
  }

  .footer-grid nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .footer-grid nav a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }

  .footer-grid nav a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
    border-top: 1px dotted rgba(94, 120, 238, 0.4);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 64rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 36rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
