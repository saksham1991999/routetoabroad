---
import { SITE, FOOTER_LINKS, CURRENT_YEAR } from '../lib/site';
import { DEFAULT_LOCALE, translatePath, type Locale } from '../lib/i18n';
import { uiFor } from '../i18n/ui';
import Logo from './Logo.astro';

const locale: Locale = (Astro.props.locale as Locale) ?? DEFAULT_LOCALE;
const ui = uiFor(locale);
const link = (path: string) => translatePath(path, locale);
const footerGroups = ui.footer.groups;
---

<footer class="site-footer" data-tone="dark">
  <div class="container-wide">
    <div class="footer-head">
      <p class="footer-eyebrow">{ui.footer.eyebrow}</p>
      <a class="footer-email" href={`mailto:${SITE.email}`}>
        {SITE.email}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <p class="wordmark">
          <Logo />
        </p>
        <p class="footer-desc">{ui.footer.desc}</p>
        <ul class="footer-contact">
          <li><a href={SITE.phoneIndiaHref}>{SITE.phoneIndia}</a><span class="loc">New Delhi</span></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li>
            <address>
              {SITE.offices[0].street}, {SITE.offices[0].city} {SITE.offices[0].postal}<br />
              {SITE.offices[1].street}, {SITE.offices[1].city}, {SITE.offices[1].country}
            </address>
          </li>
        </ul>
        <ul class="footer-social" aria-label={ui.footer.socialAria}>
          <li><a href={SITE.socials.linkedin} rel="noopener" aria-label={ui.footer.socials.linkedin}>{ui.footer.socials.linkedin}</a></li>
          <li><a href={SITE.socials.instagram} rel="noopener" aria-label={ui.footer.socials.instagram}>{ui.footer.socials.instagram}</a></li>
          <li><a href={SITE.socials.twitter} rel="noopener" aria-label={ui.footer.socials.twitter}>{ui.footer.socials.twitter}</a></li>
          <li><a href={SITE.socials.youtube} rel="noopener" aria-label={ui.footer.socials.youtube}>{ui.footer.socials.youtube}</a></li>
        </ul>
      </div>

      {footerGroups.map((group, i) => (
        <nav aria-label={group.heading}>
          <h3>{group.heading}</h3>
          <ul>{group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      <p>© {CURRENT_YEAR} {SITE.name}. {ui.footer.allRights}</p>
      <p class="footer-coords num" aria-hidden="true">
        {SITE.offices.map((o) => `${o.lat.toFixed(2)}°N ${o.code}`).join(' · ')}
      </p>
      <p class="footer-note">{ui.footer.openNote} {SITE.hours} · {ui.cta.replyValue}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0a0a0a;
    color: #ffffff;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    margin-top: auto;
    counter-reset: fnav;
  }

  /* --- Top rail: the fastest route to a human --- */
  .footer-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .footer-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    color: #ffffff;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-email span {
    color: #9db1f8;
    transition: transform 0.3s var(--ease-out);
  }

  .footer-email:hover span {
    transform: translateX(6px);
  }

  .footer-email:hover {
    color: #9db1f8;
  }

  /* --- Link grid --- */
  .footer-grid {
    display: grid;
    grid-template-columns: 2.1fr 1fr 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .wordmark {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .footer-desc {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 24rem;
    text-wrap: pretty;
  }

  .footer-contact {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.55rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .footer-contact a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.78);
  }

  .footer-contact a:hover {
    color: #9db1f8;
  }

  .loc {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-contact address {
    font-style: normal;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.62);
  }

  .footer-social {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer-social a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .footer-social a:hover {
    color: #9db1f8;
    border-color: rgba(157, 177, 248, 0.6);
  }

  .footer-grid nav {
    counter-increment: fnav;
  }

  .footer-grid nav h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9db1f8;
    margin-bottom: 1.1rem;
  }

  .footer-grid nav h3::before {
    content: '0' counter(fnav);
    color: rgba(255, 255, 255, 0.3);
  }

  .footer-grid nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-grid nav a {
    display: inline-block;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.9rem;
    line-height: 1.5;
    transition: color 0.15s, transform 0.2s var(--ease-out);
  }

  .footer-grid nav a:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-coords {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 64rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-coords {
      display: none;
    }

    .footer-bottom {
      gap: 0.4rem;
    }
  }
</style>
