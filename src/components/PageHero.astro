---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  crumbs?: { name: string; url: string }[];
}

const { eyebrow, title, lede, crumbs } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    {crumbs && crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</header>

<style>
  .page-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
    max-width: 20ch;
  }

  .lede {
    margin-top: 1.4rem;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem); /* 17–19px */
    line-height: 1.6;
    color: var(--ink-label);
    text-wrap: pretty;
  }

  .breadcrumbs {
    margin-bottom: 2.2rem;
  }
</style>
