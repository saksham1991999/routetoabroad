---
import { SITE } from '../lib/site';
import { DEFAULT_LOCALE, translatePath, type Locale } from '../lib/i18n';
import { uiFor, type CtaPerPageKey } from '../i18n/ui';

const locale: Locale = (Astro.props.locale as Locale) ?? DEFAULT_LOCALE;
const ui = uiFor(locale);

interface Props {
  locale?: Locale;
  title?: string;
  text?: string;
  /**
   * Key into ui.cta.perPage — the page-specific CTA copy shared by all
   * locales (English included). Takes precedence over the default title/text;
   * explicit `title`/`text` props still win for one-off overrides.
   */
  ctaKey?: CtaPerPageKey;
}
const {
  title: titleProp,
  text: textProp,
  ctaKey,
} = Astro.props;
const perPage = ctaKey ? ui.cta.perPage[ctaKey] : undefined;
const title = titleProp ?? perPage?.title ?? ui.cta.title;
const text = textProp ?? perPage?.text ?? ui.cta.text;
---

<section class="cta-band" aria-label={ui.cta.aria}>
  <div class="container-wide">
    <div class="cta-rail" aria-hidden="true">
      <span>04 / {ui.cta.startHere}</span>
      <span class="cta-rail-line"></span>
      <span>DEL → CAN</span>
    </div>

    <div class="cta-grid" data-reveal>
      <div class="cta-copy">
        <h2>{title}</h2>
        <p class="cta-text">{text}</p>
      </div>

      <div class="cta-side">
        <div class="cta-actions">
          <a href={translatePath('/contact', locale)} class="btn btn-light btn-lg">
            {ui.cta.talkToAdvisor} <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href={SITE.whatsapp} class="btn btn-outline-light btn-lg" rel="noopener">
            {ui.cta.whatsapp}
          </a>
        </div>

        <dl class="cta-facts">
          <div>
            <dt>{ui.cta.call}</dt>
            <dd><a href={SITE.phoneIndiaHref}><bdi>{SITE.phoneIndia}</bdi></a></dd>
          </div>
          <div>
            <dt>{ui.cta.hours}</dt>
            <dd><bdi>{ui.footer.hoursValue}</bdi></dd>
          </div>
          <div>
            <dt>{ui.cta.reply}</dt>
            <dd>{ui.cta.replyValue}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    background: #0B1533;
    color: #F4F2EC;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cta-rail {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .cta-rail span:first-child {
    color: #6A80EE;
  }

  .cta-rail-line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      rgba(255, 255, 255, 0.2) 0 4px,
      transparent 4px 9px
    );
  }

  .cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cta-band h2 {
    color: #F4F2EC;
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.96;
    max-width: 14ch;
    text-wrap: balance;
  }

  .cta-text {
    margin-top: 1.35rem;
    max-width: 42ch;
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    text-wrap: pretty;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
  }

  .cta-actions .btn {
    justify-content: space-between;
  }

  .btn-outline-light {
    border-color: rgba(255, 255, 255, 0.28);
    color: #F4F2EC;
  }

  .btn-outline-light:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  .cta-facts {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cta-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cta-facts dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .cta-facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.82);
    text-align: end;
  }

  /* RTL: mirror the button arrow so it keeps pointing at the screen edge. */
  html:global([dir='rtl']) .btn-arrow {
    display: inline-block;
    transform: scaleX(-1);
  }

  .cta-facts a {
    color: #F4F2EC;
    text-decoration: none;
  }

  .cta-facts a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 64rem) {
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .cta-band h2 {
      max-width: 18ch;
    }

    .cta-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .cta-actions .btn {
      justify-content: center;
    }
  }

  @media (max-width: 40rem) {
    .cta-actions {
      flex-direction: column;
    }
  }
</style>
