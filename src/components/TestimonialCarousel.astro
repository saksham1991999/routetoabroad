---
import { TESTIMONIALS } from '../data/testimonials';
---

<section class="testimonials section" aria-label="Client stories">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Client stories</p>
      <h2>Hear from those who made the leap</h2>
      <p class="lede">Students, travellers and traders who crossed with us — in their own words.</p>
    </div>
  </div>

  <div class="container carousel-shell" data-reveal>
    <div class="carousel" id="testimonial-carousel" tabindex="0" aria-label="Testimonials carousel">
      {TESTIMONIALS.map((t) => (
        <figure class="t-card">
          <span class="t-pill">{t.category}</span>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <span class="t-avatar num" aria-hidden="true">{t.name.split(' ').map((n) => n[0]).join('')}</span>
            <span>
              <strong>{t.name}</strong>
              <em>{t.role}</em>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="carousel-controls">
      <button type="button" class="c-btn" data-dir="-1" aria-label="Previous testimonial">←</button>
      <div class="c-dots" role="presentation"></div>
      <button type="button" class="c-btn" data-dir="1" aria-label="Next testimonial">→</button>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .carousel-shell {
    max-width: 50rem;
  }

  .carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-l);
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .t-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: var(--radius-l);
    box-shadow: none;
    padding: clamp(1.75rem, 4vw, 3rem);
    margin: 0;
  }

  .t-pill {
    font-size: 0.6875rem; /* 11px */
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  blockquote {
    margin-top: 1.1rem;
    font-size: clamp(1.25rem, 2.6vw, 1.625rem); /* 20–26px */
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  figcaption {
    margin-top: 1.8rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .t-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem; /* 40px */
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    background: transparent;
    font-weight: 500;
    font-size: 0.85rem;
  }

  figcaption strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
  }

  figcaption em {
    display: block;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    margin-top: 0.15rem;
  }

  .carousel-controls {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .c-btn {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-label);
    font-size: 1rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .c-btn:hover {
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
    color: var(--ink);
  }

  .c-dots {
    display: flex;
    gap: 0.5rem;
  }
</style>

<style is:global>
  /* Dots are created via createElement in the script below, so they never
     receive the Astro scope class — these rules must stay global. */
  .c-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line-strong);
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }

  .c-dot[aria-current='true'] {
    background: var(--accent);
    transform: scale(1.25);
  }
</style>

<script>
  const carousel = document.getElementById('testimonial-carousel');

  if (carousel) {
    const cards = Array.from(carousel.children) as HTMLElement[];
    const dotsWrap = carousel.parentElement?.querySelector('.c-dots');
    const dots: HTMLButtonElement[] = [];

    if (dotsWrap) {
      cards.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'c-dot';
        dot.setAttribute('aria-label', `Go to testimonial ${i + 1}`);
        dot.setAttribute('aria-current', i === 0 ? 'true' : 'false');
        dot.addEventListener('click', () => scrollTo(i));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    }

    const index = () => Math.round(carousel.scrollLeft / carousel.clientWidth);
    const scrollTo = (i: number) => {
      carousel.scrollTo({ left: i * carousel.clientWidth, behavior: 'smooth' });
    };
    const sync = () => {
      const i = index();
      dots.forEach((d, di) => d.setAttribute('aria-current', di === i ? 'true' : 'false'));
    };
    carousel.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });

    carousel.parentElement
      ?.querySelectorAll<HTMLButtonElement>('.c-btn')
      .forEach((btn) =>
        btn.addEventListener('click', () => {
          const dir = parseInt(btn.dataset.dir || '1', 10);
          const count = cards.length;
          scrollTo((index() + dir + count) % count);
        })
      );

    // Auto-advance, paused on hover/focus/reduced-motion
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      let timer = setInterval(tick, 6000);
      function tick() {
        scrollTo((index() + 1) % cards.length);
      }
      const reset = () => {
        clearInterval(timer);
        timer = setInterval(tick, 6000);
      };
      carousel.addEventListener('pointerenter', () => clearInterval(timer));
      carousel.addEventListener('pointerleave', reset);
      carousel.addEventListener('focusin', () => clearInterval(timer));
      carousel.addEventListener('focusout', reset);
    }
  }
</script>
