---
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { uiFor } from '../i18n/ui';
import { TESTIMONIALS } from '../data/testimonials';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = uiFor(locale).carousel;
const labels = uiFor(locale).categories;
const testimonials = TESTIMONIALS[locale];
---

<section class="testimonials section" aria-label={ui.sectionAria}>
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{ui.eyebrow}</p>
      <h2>{ui.heading}</h2>
      <p class="lede">{ui.lede}</p>
    </div>
  </div>

  <div class="container carousel-shell" data-reveal>
    <div class="carousel" id="testimonial-carousel" tabindex="0" aria-label={ui.carouselAria}>
      {testimonials.map((t) => (
        <figure class="t-card">
          <span class="t-pill">{labels[t.category]}</span>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <span class="t-avatar num" aria-hidden="true">{t.name.split(' ').map((n) => n[0]).join('')}</span>
            <span>
              <strong>{t.name}</strong>
              <em>{t.role}</em>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="carousel-controls">
      <button type="button" class="c-btn" data-dir="-1" aria-label={ui.prev}><span class="c-arrow" aria-hidden="true">←</span></button>
      <div class="c-dots" role="presentation"></div>
      <button type="button" class="c-btn" data-dir="1" aria-label={ui.next}><span class="c-arrow" aria-hidden="true">→</span></button>
      <button type="button" class="c-btn c-pause" id="t-pause" aria-pressed="false" aria-label={ui.pause} data-pause-label={ui.pause} data-play-label={ui.play} data-go-to-template={ui.goTo}>❚❚</button>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .carousel-shell {
    max-width: 50rem;
  }

  .carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-l);
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .t-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: var(--paper-raised);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: var(--radius-l);
    box-shadow: none;
    padding: clamp(1.75rem, 4vw, 3rem);
    margin: 0;
  }

  .t-pill {
    font-size: 0.6875rem; /* 11px */
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  blockquote {
    margin-top: 1.1rem;
    font-size: clamp(1.25rem, 2.6vw, 1.625rem); /* 20–26px */
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  figcaption {
    margin-top: 1.8rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .t-avatar {
    display: grid;
    place-items: center;
    width: 2.5rem; /* 40px */
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent-text);
    background: transparent;
    font-weight: 500;
    font-size: 0.85rem;
  }

  figcaption strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
  }

  figcaption em {
    display: block;
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    margin-top: 0.15rem;
  }

  .carousel-controls {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .c-btn {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-label);
    font-size: 1rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .c-arrow {
    display: inline-block;
  }

  .c-btn:hover {
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
    color: var(--ink);
  }

  .c-dots {
    display: flex;
    /* ≥ the 18px combined hit-expansion of neighbouring dots, so tap zones
       never overlap (adjacent taps must not activate the wrong testimonial) */
    gap: 1.25rem;
  }
</style>

<style is:global>
  /* Dots are created via createElement in the script below, so they never
     receive the Astro scope class — these rules must stay global. */
  .c-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--line-strong);
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }

  /* Invisible hit-area expander: the visible dot stays 8px, the tap target
     grows to ~28px so the dots meet the 24px minimum (WCAG 2.5.8). */
  .c-dot::before {
    content: '';
    position: absolute;
    inset: -9px;
  }

  .c-dot[aria-current='true'] {
    background: var(--accent);
    transform: scale(1.25);
  }
</style>

<script>
  const carousel = document.getElementById('testimonial-carousel');

  if (carousel) {
    const cards = Array.from(carousel.children) as HTMLElement[];
    const dotsWrap = carousel.parentElement?.querySelector('.c-dots');
    const dots: HTMLButtonElement[] = [];

    // Localized control labels flow through data attributes (the script is
    // shared by all five locale homepages).
    const pauseLabel = pauseBtnData('pauseLabel', 'Pause testimonial rotation');
    const playLabel = pauseBtnData('playLabel', 'Play testimonial rotation');
    const goToTemplate = carouselTemplate();

    function pauseBtnData(key: string, fallback: string): string {
      return document.getElementById('t-pause')?.dataset[key] ?? fallback;
    }
    function carouselTemplate(): string {
      const pauseEl = document.getElementById('t-pause') as HTMLElement | null;
      return pauseEl?.dataset.goToTemplate ?? 'Go to testimonial {n}';
    }

    if (dotsWrap) {
      cards.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'c-dot';
        dot.setAttribute('aria-label', goToTemplate.replace('{n}', String(i + 1)));
        dot.setAttribute('aria-current', i === 0 ? 'true' : 'false');
        dot.addEventListener('click', () => scrollTo(i));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    }

    // In RTL, modern browsers report a negative scrollLeft range (0 down to
    // -max). Negate it so the index math and the scroll target stay symmetric.
    const isRtl = document.documentElement.dir === 'rtl';
    const index = () =>
      isRtl
        ? Math.round(-carousel.scrollLeft / carousel.clientWidth)
        : Math.round(carousel.scrollLeft / carousel.clientWidth);
    const scrollTo = (i: number) => {
      carousel.scrollTo({ left: isRtl ? -i * carousel.clientWidth : i * carousel.clientWidth, behavior: 'smooth' });
    };
    const sync = () => {
      const i = index();
      dots.forEach((d, di) => d.setAttribute('aria-current', di === i ? 'true' : 'false'));
    };
    carousel.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });

    carousel.parentElement
      ?.querySelectorAll<HTMLButtonElement>('.c-btn')
      .forEach((btn) =>
        btn.addEventListener('click', () => {
          const dir = parseInt(btn.dataset.dir || '1', 10);
          const count = cards.length;
          scrollTo((index() + dir + count) % count);
        })
      );

    // Auto-advance, paused on hover/focus/reduced-motion, with a persistent
    // pause control — moving content must be user-stoppable (WCAG 2.2.2).
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pauseBtn = document.getElementById('t-pause');
    let playing = !reduced;
    let timer: number | undefined;

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const tick = () => scrollTo((index() + 1) % cards.length);
    const start = () => {
      stop();
      timer = setInterval(tick, 6000) as unknown as number;
    };

    if (!reduced) {
      start();
      carousel.addEventListener('pointerenter', stop);
      carousel.addEventListener('pointerleave', () => playing && start());
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', () => playing && start());

      pauseBtn?.addEventListener('click', () => {
        playing = !playing;
        pauseBtn.setAttribute('aria-pressed', String(!playing));
        pauseBtn.setAttribute('aria-label', playing ? pauseLabel : playLabel);
        pauseBtn.textContent = playing ? '❚❚' : '▶';
        playing ? start() : stop();
      });
    } else {
      pauseBtn?.setAttribute('hidden', '');
    }
  }
</script>
