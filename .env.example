# RouteToAbroad v3 (Astro) — environment variables
# Copy to .env for local work. NEVER commit .env.

# ---- AI counselor chatbot (netlify/functions/chat.mts) ----
# Required in Netlify for the chat widget; the static site builds without them.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=

# ---- Image generation (local only, scripts/generate_images.py) ----
# Reads from the environment or ~/.zshrc; not needed for build/deploy.
# AGNES_AI_API_KEY=
